{
  "permissions": {
    "allow": [
      "mcp__astro-docs__search_astro_docs",
      "mcp__emdash-docs__search_docs",
      "mcp__emdash__search_docs"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; npx vp check --fix --no-error-on-unmatched-pattern \"$f\"; } || true",
            "statusMessage": "Formatting"
          }
        ]
      }
    ]
  }
}
