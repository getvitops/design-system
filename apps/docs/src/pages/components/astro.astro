---
/**
 * Tier 3 — the Astro components.
 *
 * "Emits" is the load-bearing column, and it is the one thing that cannot be inferred
 * from a component's name: `Tree` and `CookieConsent` emit a `<wc-*>` tag with the
 * fallback inside, while `Details`, `Drawer`, `Popover`, `NavShell` and `Subgrid`
 * emit tier-1 markup with no web component at all. Reading the first group as the
 * second produces `<wc-tree><Tree /></wc-tree>` — two elements on one tree.
 *
 * Import specifiers come from the manifest and are checked against
 * `packages/astro/package.json`'s `exports`, because they are published here as the
 * line to copy.
 */
import { tierPatterns } from '@getvitops/generator';
import Docs from '../../layouts/Docs.astro';
import TierEntries from '../../components/TierEntries.astro';
import { alsoIn, code, href, md, type TierRow } from '../../components/tiers.ts';

const base = import.meta.env.BASE_URL;

const rows: TierRow[] = tierPatterns('astro').flatMap(({ name, entry }) =>
  entry.astro!.map((a) => ({
    id: `component-${a.component.split('/').pop()!.replace('.astro', '')}`,
    headingHtml: code(`<${a.component.split('/').pop()!.replace('.astro', '')} />`),
    cells: {
      Pattern: code(name),
      Import: code(a.component),
      Emits:
        a.wraps === 'wc'
          ? `the ${code(`<${entry.wc!.tag}>`)} tag, <strong>fallback inside</strong>`
          : 'tier-1 markup — no web component',
      'Recommended call': md(entry.use),
      'Also in': alsoIn(name, 'astro', base),
    },
  })),
);

const title = 'Astro components';
const description =
  'Tier 3 — authoring conveniences that emit the correct markup at build time: which wrap a web component, and which emit plain tier-1 markup.';
---

<Docs title={title} description={description}>
  <p>
    Tier 3 is <strong>authoring convenience</strong>. Each component renders the correct
    markup and classes so you don't hand-write boilerplate, and none of them requires runtime
    JavaScript — <code>Subgrid</code> emits a subgrid list, <code>Popover</code> uses the native
    Popover API with Anchor Positioning, <code>Details</code>/<code>Drawer</code>/<code>NavShell</code>
    compose <code>&lt;details&gt;</code> with Invoker Commands. If a wrapper would need runtime JS it
    is the wrong tier: that becomes a web component, and the wrapper emits its tag instead.
  </p>

  <h2 id="wrapping">Read the "emits" column before you write markup</h2>
  <p>
    Where a component wraps a web component, it emits that tag <em>with the accessible fallback
    inside it</em> — so the one call is the whole composition, and adding your own wrapper nests two
    elements on one tree:
  </p>
  <pre><code>{'<!-- wrong -->\n<wc-tree><Tree items={…} /></wc-tree>\n\n<!-- right -->\n<Tree items={…} />'}</code></pre>

  <TierEntries rows={rows} />

  <p class="font-footnote">
    Installing and configuring the integration is covered in
    <a class="link" href={href('guides/installation', base)}>Installation</a>; the package's full
    surface is on <a class="link" href={href('packages/astro', base)}>@getvitops/astro</a>.
  </p>
</Docs>
