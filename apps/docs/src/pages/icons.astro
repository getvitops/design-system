---
/**
 * Icons — a live demonstration of the semantic icon vocabulary.
 *
 * This page is a dogfood, not an illustration: every glyph below is rendered by
 * the real `<Icon />` through the real integration, with `icons: { ui: 'ph' }` in
 * astro.config. If the resolution chain breaks, this page breaks.
 *
 * The names come from the same `iconMap` the toolchain ships, read at build time
 * rather than typed out — a hand-listed grid would drift the moment the map
 * gains a name, and a page that lies about the vocabulary is worse than none.
 */
import Icon from '@getvitops/astro/components/Icon.astro';
import { iconMap, resolveIcon } from '@getvitops/astro';
import Docs from '../layouts/Docs.astro';

/** Every semantic name, grouped the way the map itself is commented. */
const NAMES = Object.keys(iconMap.fa7);

/**
 * The UI sets, for the vocabulary switcher.
 *
 * Every set is rendered at build time and the picker swaps which grid is shown
 * with CSS (`:has(:checked)`), because the claim the page is making — the same
 * name resolves in every set — is only demonstrated by actually resolving it in
 * every set. A JS picker would prove the same thing with a runtime the rest of
 * the page doesn't need, and a screenshot would prove nothing at all.
 *
 * `<Icon />` resolves against the site's configured set, so each grid goes
 * through `resolveIcon` here and hands the component the qualified name — the
 * documented `prefix:name` pass-through. That is also why the collections are
 * devDependencies of this app: the inline engine reads the glyph out of
 * `@iconify-json/*` directly.
 */
const SETS = [
  { prefix: 'ph', label: 'Phosphor' },
  { prefix: 'lucide', label: 'Lucide' },
  { prefix: 'fa7-solid', label: 'Font Awesome 7' },
  { prefix: 'material-symbols', label: 'Material Symbols' },
] as const;

/** Resolve up front so a set missing a name is a build-time warning, not a blank cell. */
const GRIDS = SETS.map((set) => ({
  ...set,
  icons: NAMES.map((name) => {
    try {
      return { name, qualified: resolveIcon(name, set.prefix) };
    } catch {
      console.warn(`[docs/icons] "${name}" has no entry in ${set.prefix}`);
      return { name, qualified: null };
    }
  }),
}));

/** Phosphor's weights — a suffix on the name, not a separate collection. */
const WEIGHTS = ['regular', 'bold', 'fill', 'duotone', 'thin'] as const;

const headings = [
  { depth: 2, slug: 'vocabulary', text: 'The vocabulary' },
  { depth: 2, slug: 'sizing', text: 'Sizing & colour' },
  { depth: 2, slug: 'adornments', text: 'Icons in buttons and links' },
  { depth: 2, slug: 'weights', text: 'Weights' },
  { depth: 2, slug: 'escape-hatch', text: 'The escape hatch' },
];
---

<Docs
  title="Icons"
  description="Semantic icon names that resolve per configured set, sized in em and coloured by currentColor."
  headings={headings}
>
  <p class="font-body">
    Icons are named by <strong>meaning</strong>, not by set. This site configures
    <code>ui: 'ph'</code>, so <code>menu</code> renders Phosphor's <code>list</code>. Point that at
    <code>lucide</code> or <code>fa7-solid</code> and every glyph on this page changes at once —
    no call site is touched.
  </p>
  <p class="font-body text-surface-muted">
    Note what this page <em>doesn't</em> ship: an <code>include</code> map. The site is
    <code>output: 'static'</code>, where astro-icon already bundles only what's used. That list
    exists for <code>output: 'server'</code>, and the integration derives it there by scanning
    source rather than asking you to maintain it.
  </p>

  <!-- ── The vocabulary ──────────────────────────────────────────────────── -->
  <h2 id="vocabulary" class="font-title">The vocabulary</h2>
  <p class="font-body text-surface-muted">
    All {NAMES.length} semantic names, read from the shipped map at build time. Every set the
    toolchain knows answers to this same list, which is what makes swapping one safe — so pick one
    and watch the glyphs change while the names don't. The second line in each cell is what that
    name resolves to; in your own project it's one line of <code>astro.config</code>.
  </p>

  <fieldset class="ic-sets">
    <legend class="sr-only">Icon set</legend>
    <p class="cluster cluster-start ic-picker">
      {
        GRIDS.map((set, i) => (
          <Fragment>
            <input
              type="radio"
              name="ic-set"
              id={`ic-set-${set.prefix}`}
              class="sr-only"
              checked={i === 0}
            />
            <label class="btn" for={`ic-set-${set.prefix}`}>
              {set.label}
            </label>
          </Fragment>
        ))
      }
    </p>

    {
      GRIDS.map((set) => (
        <ul class="grid-auto ic-grid" data-set={set.prefix} style="--grid-min: 8rem">
          {set.icons.map(({ name, qualified }) => (
            <li class="ic-cell">
              {qualified ? <Icon name={qualified} size="1.5rem" /> : <span class="icon" />}
              <code class="font-caption">{name}</code>
              <code class="font-footnote ic-resolved">{qualified ?? '—'}</code>
            </li>
          ))}
        </ul>
      ))
    }
  </fieldset>

  <!-- ── Sizing & colour ─────────────────────────────────────────────────── -->
  <h2 id="sizing" class="font-title">Sizing &amp; colour</h2>
  <p class="font-body text-surface-muted">
    <code>.icon</code> is a box sized in <code>em</code> via <code>--icon-size</code> (default
    <code>1.25em</code>), and its <code>svg</code> inherits <code>currentColor</code>. So an icon
    takes the size and colour of whatever it sits in — there is no
    <code>icon-large</code> or <code>icon-danger</code> variant to learn.
  </p>

  <p class="cluster cluster-start ic-row">
    <Icon name="star" size="1rem" />
    <Icon name="star" size="1.5rem" />
    <Icon name="star" size="2rem" />
    <Icon name="star" size="3rem" />
  </p>

  <p class="cluster cluster-start ic-row">
    <span class="text-brand-primary"><Icon name="favorite" size="2rem" /></span>
    <span class="text-success"><Icon name="check" size="2rem" /></span>
    <span class="text-warning"><Icon name="warning" size="2rem" /></span>
    <span class="text-danger"><Icon name="error" size="2rem" /></span>
    <span class="text-surface-muted"><Icon name="info" size="2rem" /></span>
  </p>

  <p class="font-body">
    Inline in a sentence <Icon name="lightbulb" /> the icon tracks the text size, because the box is
    measured in <code>em</code> against its own font-size.
  </p>

  <!-- ── Adornments ──────────────────────────────────────────────────────── -->
  <h2 id="adornments" class="font-title">Icons in buttons and links</h2>
  <p class="font-body text-surface-muted">
    <code>.cta</code> and <code>:where(button, .btn)</code> are already
    <code>inline-flex</code> with a <code>gap</code>, so an icon before or after the label is
    <strong>child order</strong> — there is no <code>cta--with-icon</code> modifier, and there
    shouldn't be one. The glyph picks up each tier's own text colour for free.
  </p>

  <p class="cluster cluster-start ic-row">
    <a class="cta" href="#adornments"><Icon name="add" />New project</a>
    <a class="cta" href="#adornments">Continue<Icon name="arrow-right" /></a>
    <button class="btn"><Icon name="download" />Download</button>
    <button class="danger"><Icon name="delete" />Delete</button>
  </p>

  <p class="font-body text-surface-muted">
    An icon-only control still needs a name. Pass <code>label</code> and it becomes
    <code>role="img"</code> with an <code>aria-label</code>; leave it off and the icon is
    <code>aria-hidden</code>, which is right whenever a text label sits beside it.
  </p>

  <p class="cluster cluster-start ic-row">
    <button class="icon-button" aria-label="Search"><Icon name="search" /></button>
    <button class="icon-button" aria-label="Settings"><Icon name="settings" /></button>
    <button class="icon-button" aria-label="Close"><Icon name="close" /></button>
  </p>

  <!-- ── Weights ─────────────────────────────────────────────────────────── -->
  <h2 id="weights" class="font-title">Weights</h2>
  <p class="font-body text-surface-muted">
    Phosphor keeps every weight in <em>one</em> collection and varies the icon name
    (<code>list</code>, <code>list-bold</code>, <code>list-fill</code>). Font Awesome splits the same
    idea across collections instead (<code>fa7-solid</code> vs <code>fa7-regular</code>), so there
    the weight is part of the prefix. Set <code>icons.weight</code> once and the site-wide default
    follows; these are spelled out per-icon to show the difference.
  </p>

  <p class="cluster cluster-start ic-row">
    {
      WEIGHTS.map((w) => (
        <span class="ic-cell">
          <Icon name={w === 'regular' ? 'ph:heart' : `ph:heart-${w}`} size="2rem" />
          <code class="font-caption">{w}</code>
        </span>
      ))
    }
  </p>

  <!-- ── Escape hatch ────────────────────────────────────────────────────── -->
  <h2 id="escape-hatch" class="font-title">The escape hatch</h2>
  <p class="font-body text-surface-muted">
    A name containing <code>:</code> passes through untouched. Brand marks are the usual case —
    they're in <code>simple-icons</code>, not the semantic map, and there is no meaningful
    "semantic name" for a logo.
  </p>

  <p class="cluster cluster-start ic-row">
    <Icon name="ph:sparkle" size="2rem" />
    <Icon name="ph:cube" size="2rem" />
    <Icon name="ph:terminal-window" size="2rem" />
  </p>

  <p class="font-body text-surface-muted">
    Outside Astro — Bricks, WordPress, an EmDash renderer — the same names come from a generated
    SVG sprite instead: <code>&lt;use href="…/icons.svg#ph--list"&gt;</code>, no JavaScript and no
    icon-API request. Every semantic name also gets a set-independent <code>icon-&lt;name&gt;</code>
    alias there, so that markup survives a set swap too. See
    <a class="link" href="/reference/concepts-icons/">the icons reference</a>.
  </p>
</Docs>

<style>
  /* The framework's .grid-auto does the columns (--grid-min) and, importantly,
     the list-rhythm reset — a bespoke grid here left every cell but the first
     with a prose top-margin, which read as the first one being misaligned. */
  .ic-grid {
    --grid-gap: 0.75rem;

    list-style: none;
    padding: 0;
    margin-block: 1.5rem;
  }

  .ic-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 0.5rem;
    border: 1px solid var(--color-border-surface-muted);
    border-radius: var(--br-panel);
    text-align: center;
  }

  .ic-cell code {
    color: var(--color-text-surface-muted);
    word-break: break-all;
  }

  .ic-resolved {
    color: var(--color-text-surface-x-muted);
  }

  /* The set picker: radios + `:has(:checked)`, so switching sets costs no JS.
     A framework `.segmented`/`.tabs` pattern would own this — there isn't one
     yet, which is the honest reading of these 20 lines. */
  .ic-sets {
    border: 0;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }

  .ic-picker {
    gap: 0.5rem;
    margin-block: 1.25rem;
  }

  .ic-picker input:checked + label {
    background-color: var(--color-bg-brand-primary-solid);
    color: var(--color-text-on-brand-primary);
  }

  /* The focus ring lives on the hidden input, so move it to the label. */
  .ic-picker input:focus-visible + label {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  .ic-grid {
    display: none;
  }

  .ic-sets:has(#ic-set-ph:checked) .ic-grid[data-set='ph'],
  .ic-sets:has(#ic-set-lucide:checked) .ic-grid[data-set='lucide'],
  .ic-sets:has(#ic-set-fa7-solid:checked) .ic-grid[data-set='fa7-solid'],
  .ic-sets:has(#ic-set-material-symbols:checked) .ic-grid[data-set='material-symbols'] {
    display: grid;
  }

  .ic-row {
    gap: 0.75rem;
    align-items: center;
    margin-block: 1.25rem;
  }
</style>
