---
/**
 * Docs shell — built from the design system's own vocabulary.
 *
 * Every class here comes from the generated framework: `.centered` for the
 * content tracks, `<NavShell>` for the nav-aside/main columns, `.cluster-between`
 * for the header and footer rows, `.rhythm` for vertical spacing, `.font-<role>`
 * for type, `.bg-*` / `.text-*` for colour, and `.link` / `.card` / `.list` for
 * controls and content.
 *
 * One composition rule the framework enforces, which fails *silently*:
 * `.centered` is a track grid whose `> *` forces children into the `measure`
 * column, so it can't share an element with a layout class — give it a track
 * child (`.spotlight`, `.breakout`, `.fullbleed`) and lay out inside that.
 * Stacking `.centered .cluster-between` looks fine only because cluster.css is
 * imported later and its `display: flex` quietly wins.
 *
 * The shell used to be `split flex-col md-split-1-4 items-start`, which is what
 * broke this site on mobile. `align-items: flex-start` makes `<main>`
 * shrink-to-fit, and `fit-content` is `min(max-content, max(min-content,
 * available))` — so main resolved to its MIN-CONTENT, which a single `<pre>`
 * held at 797px inside a 390px viewport. `.split > * { min-inline-size: 0 }`
 * cannot rescue that: it lowers the used-value clamp, not the fit-content
 * formula. `<NavShell>` stretches its content column and floors it at zero.
 *
 * The hand-written CSS at the bottom is what no framework pattern covers. Keep
 * it short — a rule that belongs to a reusable pattern should move into
 * @getvitops/core instead. Nav is `<button popovertarget>` + `[popover]`, so it
 * works with no JavaScript.
 */
import Head from '@getvitops/astro/Head.astro';
import NavShell from '@getvitops/astro/components/NavShell.astro';
import NavShellToggle from '@getvitops/astro/components/NavShellToggle.astro';
import Seo from '@getvitops/astro/Seo.astro';
import { getCollection } from 'astro:content';
import '../styles/styles.css';

interface Props {
  title: string;
  description?: string;
  generated?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, generated = false, headings = [] } = Astro.props;

const SECTIONS = ['Start here', 'Live preview', 'Packages', 'Reference', 'Releases'] as const;

/**
 * Standalone `.astro` routes, folded into the collection-driven nav.
 *
 * The preview pages can't be collection entries: they're built from the design
 * manifest at build time and render live markup, which Markdown can't express
 * without becoming a wall of hand-written HTML that drifts from the config. They
 * are shaped like collection entries here so the nav stays one code path.
 */
const PAGES = [
  { id: 'theme', data: { title: 'Theme preview', section: 'Live preview', order: 10 } },
  { id: 'animation', data: { title: 'Animation library', section: 'Live preview', order: 20 } },
  { id: 'icons', data: { title: 'Icons', section: 'Live preview', order: 30 } },
  { id: 'patterns', data: { title: 'Patterns', section: 'Live preview', order: 40 } },
];

const all = [...(await getCollection('docs')), ...PAGES];
const nav = SECTIONS.map((section) => ({
  section,
  items: all
    .filter((e) => e.data.section === section)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
})).filter((g) => g.items.length);

const here = Astro.url.pathname.replace(/\/$/, '');
const href = (id: string) => `${import.meta.env.BASE_URL}${id === 'index' ? '' : id}`.replace(/\/$/, '') || '/';
// Only h2/h3 make a useful on-page TOC; deeper headings are detail.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      <Seo /> owns <title> and the description — the ` · Vitops` suffix is now
      `seo.titleTemplate` in astro.config.mjs. It also adds the canonical and the
      og:/twitter: tags this site never had.
    */}
    <Seo title={title} description={description} />
    <Head />
  </head>

  <body class="bg-surface-muted text-surface">
    <a class="link skip-link" href="#content">Skip to content</a>

    <header class="sticky-header docs-header bg-surface-x-muted">
      <div class="centered"><div class="spotlight cluster-between" style="align-items: center; gap: 1rem">
        <!-- The site nav's toggle, hoisted out of the shell into the header.
             Two nested shells each rendering their own sticky bar put both at
             the same offset, overlapping; the header is already sticky, so this
             leaves exactly one in-flow bar (the TOC's). `breakpoint` must match
             the shell's — outside `.navshell` the toggle can't read its flag. -->
        <div class="cluster-start" style="align-items: center; gap: 0.5rem">
          <NavShellToggle for="site-nav" label="Menu" breakpoint="md" />
          <a class="font-title docs-brand" href={href('index')}>Vitops</a>
        </div>

        <nav class="cluster-start docs-header__links" style="gap: 1rem; align-items: center">
          <a class="link" href={href('guides/installation')}>Guides</a>
          <a class="link" href={href('packages/cli')}>Packages</a>
          <a class="link" href={href('theme')}>Theme</a>
          <a class="link" href={href('reference/authoring')}>Reference</a>
          <a class="link" href={href('changelog')}>Changelog</a>
          <!-- Self-contained (shadow DOM, renders its own segmented control) and
               `display: none` until `:defined`, so with no JS it simply isn't
               there. Colour scheme then follows the OS via prefers-color-scheme,
               which the generated stylesheet emits because this site opts in
               (`css.systemColorScheme`, or `designSystem.defaultColorScheme:
               "system"` in a site config). Without it both the no-JS case and
               the toggle's own "System" position resolve to light. -->
          <color-scheme-toggle></color-scheme-toggle>
        </nav>

      </div></div>
    </header>

    <!-- `.centered` is a *track* grid (fullbleed/spotlight/breakout/measure) and
         forces every direct child into `measure`, so the shell is placed on a
         track child and the layout happens inside it.

         Two NavShells, nested. The outer promotes to two columns at `md`, the
         inner waits for `lg` and puts its nav on the inline-end side — the
         three-column reading arrangement, from one pattern used twice. Each
         instance re-declares the pattern's internal flag, which is what stops
         the outer's "I'm wide" leaking into the inner. -->
    <div class="centered">
      <div class="spotlight docs-shell">
        <NavShell id="site-nav" label="Documentation" breakpoint="md" toggle="external">
          <!-- Rendered ONCE. This list used to be duplicated between a desktop
               <aside> and a separate mobile <details> menu — two markup trees to
               keep in step, and the mobile copy is where the bug lived. -->
          <Fragment slot="nav">
            {nav.map((group) => (
              <>
                <p class="font-eyebrow text-surface-muted">{group.section}</p>
                {group.items.map((item) => (
                  <a
                    class="navshell__link"
                    aria-current={here === href(item.id) ? 'page' : undefined}
                    href={href(item.id)}
                  >{item.data.title}</a>
                ))}
              </>
            ))}
          </Fragment>

          <main id="content" class="docs-main rhythm">
            <h1 class="font-display">{title}</h1>
            {description && <p class="font-lead text-surface-muted">{description}</p>}

            {generated && (
              <aside class="card bg-info-muted">
                <p class="font-caption">
                  <strong>Generated page.</strong> Rendered from this project’s
                  <code>design-system.json</code> by <code>@getvitops/generator</code> — the same bundle
                  <code>vitops docs</code> prints against your own config. Don’t edit it by hand.
                </p>
              </aside>
            )}

            {toc.length > 1 ? (
              <NavShell id="page-toc" label="On this page" breakpoint="md" side="end" size="12rem">
                <Fragment slot="nav">
                  {/* `.scroll-target-group` drives the current-heading highlight via
                      :target-current. CSS-only and Chrome-only today; other engines
                      simply show no highlight until they ship scroll-target-group. */}
                  {toc.map((h) => (
                    <a class="navshell__link" data-depth={h.depth} href={`#${h.slug}`}>{h.text}</a>
                  ))}
                </Fragment>
                <div class="rhythm docs-prose"><slot /></div>
              </NavShell>
            ) : (
              <div class="rhythm docs-prose"><slot /></div>
            )}
          </main>
        </NavShell>
      </div>
    </div>

    <!-- Live theme editor (vitops({ editor: true }) loads its bundle). Pure
         tooling: it renders nothing until the element upgrades, so a no-JS page
         is unaffected and it needs no fallback markup. On `vp run docs:dev` its
         "Save to source" button writes back into src/design-system.json. -->
    <wc-theme-editor></wc-theme-editor>

    <footer class="docs-footer bg-surface-x-muted">
      <div class="centered"><div class="spotlight cluster-between font-footnote text-surface-muted">
        <p>Built with the design system it documents.</p>
        <p><a class="link" href="https://www.npmjs.com/org/getvitops">@getvitops on npm</a></p>
      </div></div>
    </footer>

    <style>
      /* Everything below is what the framework does NOT yet cover. Keep it short:
         a rule that belongs to a reusable pattern should move into
         @getvitops/core rather than live here. */
      /* global.css already reads --top-offset for scroll-padding-block-start, and
         the navshell's sticky offsets read it too — but nothing defined it, so
         every in-page anchor landed underneath the sticky header. */
      :root {
        --top-offset: 3.5rem;
      }
      .docs-header {
        padding-block: 0.75rem;
        border-block-end: var(--b-default);
      }
      .docs-brand {
        text-decoration: none;
      }
      .docs-shell {
        padding-block: 2.5rem;
      }
      /* Decoration only — patterns/code.css owns `pre`'s max-inline-size and
         overflow now. */
      .docs-prose :global(pre) {
        padding: 1rem;
        border-radius: var(--br-default);
      }
      /* Markdown emits bare <table>, with nothing to hang `.table-wrapper` on.
         Wrapping it would need a rehype plugin; four lines is the cheaper trade
         until a second consumer wants it. */
      .docs-prose :global(table) {
        display: block;
        max-inline-size: 100%;
        overflow-x: auto;
      }
      .docs-footer {
        margin-block-start: 4rem;
        padding-block: 2rem;
        border-block-start: var(--b-default);
      }
      /* The panel nav covers the same sections, so the header's own links (and
         the theme toggle with them) fold away once it's a drawer. */
      @media (width < 48rem) {
        .docs-header__links {
          display: none;
        }
      }
    </style>
  </body>
</html>
