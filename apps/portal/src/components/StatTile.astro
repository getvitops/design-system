---
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  tone?: 'brand' | 'success' | 'danger' | 'warning' | 'info' | 'neutral';
}
const { label, value, sub, tone = 'neutral' } = Astro.props;
const toneClass = {
  brand: 'text-brand-primary-d',
  success: 'text-success-d',
  danger: 'text-danger-d',
  warning: 'text-warning-d',
  info: 'text-info-d',
  neutral: 'text-neutral-xxd',
}[tone];
---

<div class="card">
  <div class="font-eyebrow text-neutral">{label}</div>
  <div class:list={['font-display text-3xl', toneClass]}>{value}</div>
  {sub && <div class="font-caption text-neutral mt-1">{sub}</div>}
</div>
