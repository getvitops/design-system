---
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  tone?: 'brand' | 'success' | 'danger' | 'warning' | 'info' | 'neutral';
}
const { label, value, sub, tone = 'neutral' } = Astro.props;
const toneClass = {
  brand: 'text-brand-primary',
  success: 'text-success',
  danger: 'text-danger',
  warning: 'text-warning',
  info: 'text-info',
  neutral: 'text-neutral',
}[tone];
---

<div class="card">
  <div class="font-eyebrow text-neutral-muted">{label}</div>
  <div class:list={['font-display text-3xl', toneClass]}>{value}</div>
  {sub && <div class="font-caption text-neutral-muted mt-1">{sub}</div>}
</div>
