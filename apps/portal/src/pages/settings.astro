---
import Base from '../layouts/Base.astro';
import { asc } from 'drizzle-orm';
import { capabilitiesFor, PLANS } from '../lib/capabilities.ts';
import { providerConnections } from '../lib/db/schema/index.ts';

const scoped = Astro.locals.scoped!;
const { plan, activeOrgId, user } = Astro.locals;
const connections = await scoped((tx) =>
  tx.select().from(providerConnections).orderBy(asc(providerConnections.provider)),
);
const caps = [...capabilitiesFor(plan)];
const statusTone = (s: string) =>
  s === 'connected' ? 'text-success-d' : s === 'error' ? 'text-danger-d' : 'text-neutral';
---

<Base title="Settings">
  <h1 class="font-title text-2xl">Settings</h1>

  <section class="card">
    <h2 class="font-heading text-lg">Workspace</h2>
    <dl class="mt-2 grid gap-2 font-body sm:grid-cols-2">
      <div><dt class="font-caption text-neutral">Organization</dt><dd class="font-code">{activeOrgId}</dd></div>
      <div><dt class="font-caption text-neutral">Signed in as</dt><dd>{user?.email}</dd></div>
      <div><dt class="font-caption text-neutral">Plan</dt><dd class="uppercase">{plan}</dd></div>
      <div><dt class="font-caption text-neutral">Capabilities</dt><dd>{caps.join(', ')}</dd></div>
    </dl>
  </section>

  <section class="card">
    <h2 class="font-heading text-lg">Plans</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      {PLANS.map((p) => (
        <div class:list={['rounded border p-3', p === plan ? 'border-brand-primary bg-brand-primary-xxl' : 'border-neutral-xl']}>
          <div class="font-heading uppercase">{p}</div>
          <ul class="font-caption text-neutral mt-1">
            {[...capabilitiesFor(p)].map((c) => <li>• {c}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="card">
    <div class="flex items-center justify-between">
      <h2 class="font-heading text-lg">Provider connections</h2>
      <button id="sync" class="rounded bg-brand-primary px-3 py-1 font-caption text-surface-xxl">Run sync now</button>
    </div>
    <table class="mt-3 w-full font-body">
      <thead class="font-caption text-neutral text-left">
        <tr class="border-b border-neutral-xl"><th class="py-2 pr-4">Provider</th><th class="pr-4">Status</th><th>Last synced</th></tr>
      </thead>
      <tbody>
        {connections.map((c) => (
          <tr class="border-b border-neutral-xl">
            <td class="py-2 pr-4">{c.provider}</td>
            <td class:list={['pr-4 font-caption', statusTone(c.status)]}>{c.status}</td>
            <td class="font-caption text-neutral">{c.lastSyncedAt ? new Date(c.lastSyncedAt).toISOString().slice(0, 16).replace('T', ' ') : 'never'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p id="syncmsg" class="font-caption text-neutral mt-2"></p>
  </section>

  <script>
    const btn = document.getElementById('sync');
    const msg = document.getElementById('syncmsg');
    btn?.addEventListener('click', async () => {
      btn.setAttribute('disabled', 'true');
      if (msg) msg.textContent = 'Syncing…';
      const res = await fetch('/api/dev/sync', { method: 'POST' });
      const json = await res.json();
      if (msg) msg.textContent = `Synced ${json.synced} units. Reloading…`;
      setTimeout(() => location.reload(), 600);
    });
  </script>
</Base>
