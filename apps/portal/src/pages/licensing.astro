---
import Base from '../layouts/Base.astro';
import { listLicenses } from '../lib/queries.ts';

const scoped = Astro.locals.scoped!;
const licenses = await listLicenses(scoped);
---

<Base title="Licenses">
  <h1 class="font-title text-2xl">License Management</h1>
  <p class="font-caption text-neutral-muted">Seats and renewals across managed software.</p>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {licenses.map((l) => {
      const pct = l.seats > 0 ? Math.round((l.used / l.seats) * 100) : 0;
      return (
        <section class="card">
          <div class="flex items-baseline justify-between">
            <h2 class="font-heading">{l.product}</h2>
            <span class:list={['font-caption', l.status === 'active' ? 'text-success' : 'text-warning']}>{l.status}</span>
          </div>
          <div class="font-display text-2xl mt-1">{l.used}<span class="text-neutral-muted font-body text-base">/{l.seats} seats</span></div>
          <div class="mt-2 h-2 overflow-hidden rounded bg-surface-x-muted">
            <div class:list={[pct > 90 ? 'bg-danger-solid' : 'bg-ui-primary-solid']} style={`width:${pct}%`}></div>
          </div>
          <div class="font-caption text-neutral-muted mt-2">Renews {l.renewalDate ?? '—'}</div>
        </section>
      );
    })}
  </div>
  {licenses.length === 0 && <p class="font-body text-neutral-muted">No licenses synced yet.</p>}
</Base>
