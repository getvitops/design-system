---
import Base from '../layouts/Base.astro';
import { listSites, rumSeries, trafficSeries } from '../lib/queries.ts';

// NOTE: scoped() runs a transaction on one connection — call sequentially
// (never Promise.all) so PGlite's single connection isn't asked to nest.
const scoped = Astro.locals.scoped!;
const sites = await listSites(scoped);
const traffic = await trafficSeries(scoped);
const rum = await rumSeries(scoped);

const fmt = (n: number) => n.toLocaleString('en-US');
const latestRumBySite = new Map<string, (typeof rum)[number]>();
for (const r of rum) latestRumBySite.set(r.siteId, r); // rum is asc by date → last wins
const trafficBySite = new Map<string, { human: number; ai: number; bot: number; failures: number }>();
for (const t of traffic) {
  const acc = trafficBySite.get(t.siteId) ?? { human: 0, ai: 0, bot: 0, failures: 0 };
  acc.human += Number(t.human);
  acc.ai += Number(t.ai);
  acc.bot += Number(t.bot);
  acc.failures += Number(t.failures);
  trafficBySite.set(t.siteId, acc);
}
---

<Base title="Analytics">
  <h1 class="font-title text-2xl">Analytics</h1>
  <p class="font-caption text-neutral">Traffic split + Core Web Vitals, per monitored site.</p>

  {sites.map((s) => {
    const t = trafficBySite.get(s.id) ?? { human: 0, ai: 0, bot: 0, failures: 0 };
    const r = latestRumBySite.get(s.id);
    return (
      <section class="card">
        <div class="flex items-baseline justify-between">
          <h2 class="font-heading text-lg">{s.name}</h2>
          <span class="font-caption text-neutral">{s.domain}</span>
        </div>
        <div class="mt-3 grid gap-3 sm:grid-cols-4">
          <div><div class="font-eyebrow text-neutral">Human</div><div class="font-title text-brand-primary-d">{fmt(t.human)}</div></div>
          <div><div class="font-eyebrow text-neutral">AI</div><div class="font-title text-info-d">{fmt(t.ai)}</div></div>
          <div><div class="font-eyebrow text-neutral">Bot</div><div class="font-title text-neutral-xxd">{fmt(t.bot)}</div></div>
          <div><div class="font-eyebrow text-neutral">Failures</div><div class="font-title text-danger-d">{fmt(t.failures)}</div></div>
        </div>
        {r && (
          <div class="mt-3 grid gap-3 sm:grid-cols-4 border-t border-neutral-xl pt-3 font-caption">
            <span>LCP <strong>{r.lcpMs}ms</strong></span>
            <span>INP <strong>{r.inpMs}ms</strong></span>
            <span>CLS <strong>{((r.clsX1000 ?? 0) / 1000).toFixed(3)}</strong></span>
            <span>TTFB <strong>{r.ttfbMs}ms</strong></span>
          </div>
        )}
      </section>
    );
  })}
  {sites.length === 0 && <p class="font-body text-neutral">No sites yet — run a sync from Settings.</p>}
</Base>
