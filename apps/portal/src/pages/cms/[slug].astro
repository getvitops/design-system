---
// Dogfood surface for @getvitops/emdash: renders an EmDash "pages" entry.
// The vitops.* Portable Text blocks are merged into <PortableText>
// automatically by the plugin's componentsEntry.
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../../layouts/Base.astro';

const { slug } = Astro.params;
const { entry, error } = await getEmDashEntry('pages', slug ?? '');

if (error || !entry) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const title = String(entry.data.title ?? slug);
---

<Base title={title}>
  <article class="rhythm">
    <h1>{title}</h1>
    <PortableText value={entry.data.content} />
  </article>
</Base>
