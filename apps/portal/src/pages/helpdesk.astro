---
import { actions } from 'astro:actions';
import Base from '../layouts/Base.astro';
import { listRequests, listTickets } from '../lib/queries.ts';

const scoped = Astro.locals.scoped!;
const submitted = await listRequests(scoped, ['ticket']);
const tickets = await listTickets(scoped);
const result = Astro.getActionResult(actions.submitTicket);

const tone = (s: string | null) => {
  const v = (s ?? '').toLowerCase();
  if (v === 'open') return 'text-danger';
  if (v === 'on hold') return 'text-warning';
  return 'text-success';
};
const reqTone = (s: string) =>
  s === 'sent' ? 'text-success' : s === 'failed' ? 'text-danger' : 'text-warning';
---

<Base title="Help Desk">
  <h1 class="font-title text-2xl">Help Desk</h1>
  <p class="font-caption text-neutral-muted">Open a ticket — it's ingested here and forwarded to Zoho Desk.</p>

  <section class="card rhythm">
    <h2 class="font-heading text-lg">New ticket</h2>
    {result?.data?.ok && <p class="font-caption text-success">Submitted — it will forward shortly.</p>}
    {result?.error && <p class="font-caption text-danger">{result.error.message}</p>}
    <form method="POST" action={actions.submitTicket} class="rhythm">
      <input name="subject" required placeholder="Subject" class="w-full rounded border border-neutral bg-surface-muted px-3 py-2 font-body" />
      <textarea name="description" placeholder="Describe the issue" class="w-full rounded border border-neutral bg-surface-muted px-3 py-2 font-body"></textarea>
      <select name="priority" class="rounded border border-neutral bg-surface-muted px-3 py-2 font-body">
        <option>Low</option><option selected>Medium</option><option>High</option>
      </select>
      <button type="submit" class="rounded bg-ui-primary-solid px-4 py-2 font-body text-on-ui-primary">Submit ticket</button>
    </form>
  </section>

  <section class="card overflow-x-auto">
    <h2 class="font-heading text-lg">My submitted requests</h2>
    <table class="mt-3 w-full font-body">
      <thead class="font-caption text-neutral-muted text-left">
        <tr class="border-b border-neutral"><th class="py-2 pr-4">Subject</th><th class="pr-4">Status</th><th class="pr-4">Vendor ref</th><th>Submitted</th></tr>
      </thead>
      <tbody>
        {submitted.map((r) => (
          <tr class="border-b border-neutral">
            <td class="py-2 pr-4">{(r.payload as { subject?: string }).subject}</td>
            <td class:list={['pr-4 font-caption', reqTone(r.status)]}>{r.status}</td>
            <td class="pr-4 font-code">{r.externalRef ?? '—'}</td>
            <td class="font-caption text-neutral-muted">{new Date(r.createdAt).toISOString().slice(0, 16).replace('T', ' ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {submitted.length === 0 && <p class="font-body text-neutral-muted mt-2">No requests yet.</p>}
  </section>

  <section class="card overflow-x-auto">
    <h2 class="font-heading text-lg">Tickets (synced from Zoho)</h2>
    <table class="mt-3 w-full font-body">
      <thead class="font-caption text-neutral-muted text-left">
        <tr class="border-b border-neutral"><th class="py-2 pr-4">Ref</th><th class="pr-4">Subject</th><th class="pr-4">Status</th><th class="pr-4">Priority</th><th>Updated</th></tr>
      </thead>
      <tbody>
        {tickets.map((t) => (
          <tr class="border-b border-neutral">
            <td class="py-2 pr-4 font-code">{t.externalId}</td>
            <td class="pr-4">{t.subject}</td>
            <td class:list={['pr-4 font-caption', tone(t.status)]}>{t.status}</td>
            <td class="pr-4">{t.priority}</td>
            <td class="font-caption text-neutral-muted">{t.remoteModifiedAt ? new Date(t.remoteModifiedAt).toISOString().slice(0, 10) : '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>
