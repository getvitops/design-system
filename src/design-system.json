{
  "colors": {
    "named": {
      "pine": {
        "xxd": "#00120A",
        "xd": "#073929",
        "d": "#29634D",
        "base": "#4A9075",
        "l": "#70AA92",
        "xl": "#94C4AF",
        "xxl": "#B9DECE"
      },
      "navy": {
        "xxd": "#090D14",
        "xd": "#0F141D",
        "d": "#141B26",
        "base": "#1A2230",
        "l": "#48505D",
        "xl": "#7B828E",
        "xxl": "#B3B9C3"
      },
      "amber": {
        "xxd": "#150B00",
        "xd": "#583D00",
        "d": "#A6770F",
        "base": "#F5B94A",
        "l": "#FAC76F",
        "xl": "#FED48E",
        "xxl": "#FFE2B3"
      },
      "rust": {
        "xxd": "#230001",
        "xd": "#611212",
        "d": "#9E3935",
        "base": "#E0625A",
        "l": "#F0837A",
        "xl": "#FFA39A",
        "xxl": "#FFC9C3"
      },
      "cobalt": {
        "xxd": "#010631",
        "xd": "#1B336F",
        "d": "#4365B5",
        "base": "#6F9BFF",
        "l": "#8EB2FF",
        "xl": "#ADC8FF",
        "xxl": "#CCDDFF"
      },
      "grey": {
        "xxd": "#090D15",
        "xd": "#272D38",
        "d": "#48505F",
        "base": "#6C7689",
        "l": "#8B93A4",
        "xl": "#AAB2C0",
        "xxl": "#CBD2DD"
      }
    },
    "semantic": {
      "brand-primary": "pine",
      "surface": {
        "name": "navy",
        "invert": true
      },
      "success": {
        "name": "pine",
        "invert": true,
        "dark": {
          "base": "l"
        }
      },
      "info": "cobalt",
      "danger": "rust",
      "warning": "amber",
      "neutral": {
        "name": "grey",
        "invert": true
      }
    },
    "utilities": ["bg", "text", "border"]
  },
  "shadows": {
    "sm": "0 1px 2px rgb(0 0 0 / 0.08)",
    "md": "0 4px 6px rgb(0 0 0 / 0.12)",
    "lg": "0 10px 15px rgb(0 0 0 / 0.18)",
    "xl": "0 20px 25px rgb(0 0 0 / 0.22)"
  },
  "fonts": {
    "display": "'Mulish', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, monospace"
  },
  "typeScale": {
    "base": "1rem",
    "names": ["2xs", "xs", "s", "m", "l", "xl", "2xl", "3xl"],
    "baseStep": 4,
    "baseline": "m",
    "ratio": 1.2,
    "fluid": { "minVw": "22.5rem", "maxVw": "80rem", "minRatio": 1.12 }
  },
  "spaceScale": {
    "base": "1rem",
    "names": ["2xs", "xs", "s", "m", "l", "xl", "2xl"],
    "baseStep": 4,
    "baseline": "m",
    "ratio": 1.25,
    "fluid": { "minVw": "22.5rem", "maxVw": "80rem", "minRatio": 1.2 }
  },
  "patterns": {
    "defaults": {
      "ds": "none",
      "b": "1px solid var(--color-surface-xl)",
      "br": "0.375rem",
      "p": "1rem",
      "fs": "1rem"
    },
    "groups": {
      "tag": {
        "ds": "var(--ds-default)",
        "b": "none",
        "br": "0.25rem",
        "p": "0.25em 0.5em",
        "fs": "0.75rem"
      },
      "control": {
        "ds": "var(--ds-default)",
        "b": "var(--b-default)",
        "br": "var(--br-default)",
        "p": "0.5em 1em",
        "fs": "var(--fs-default)"
      },
      "panel": {
        "ds": "var(--shadow-md)",
        "b": "var(--b-default)",
        "br": "0.5rem",
        "p": "1rem",
        "fs": "var(--fs-default)"
      },
      "area": {
        "ds": "var(--ds-default)",
        "b": "var(--b-default)",
        "br": "0",
        "p": "1.5rem",
        "fs": "var(--fs-default)"
      },
      "content": {
        "ds": "var(--ds-default)",
        "b": "var(--b-default)",
        "br": "0.5rem",
        "p": "1rem",
        "fs": "var(--fs-default)"
      },
      "pull": {
        "ds": "var(--ds-default)",
        "b": "none",
        "br": "0",
        "p": "1.5rem",
        "fs": "1.25rem"
      }
    },
    "z": {
      "raised": 1,
      "sticky": 100,
      "overlay": 200,
      "top": 1000
    },
    "items": {
      "button": {
        "group": "control",
        "element": "button",
        "default_role": "brand-primary",
        "base": {
          "padding": "0.6em 1.2em",
          "border-radius": "0.4rem",
          "border": "none",
          "font-weight": "600",
          "font-family": "inherit",
          "font-size": "inherit",
          "cursor": "pointer",
          "color": "#fff"
        },
        "states": {
          "hover": {
            "step": 1
          },
          "active": {
            "scale": 0.97
          },
          "focus-visible": {
            "ring": true
          }
        },
        "roles": ["success", "danger", "warning", "info"]
      },
      "link": {
        "group": "control",
        "element": "a",
        "default_role": "brand-primary",
        "base": {
          "color": "var(--color-brand-primary-d)",
          "text-decoration": "underline",
          "text-underline-offset": "0.15em"
        },
        "states": {
          "hover": {
            "step": 1
          },
          "focus-visible": {
            "ring": true
          }
        },
        "roles": []
      },
      "badge": {
        "group": "tag",
        "class": "badge",
        "default_role": "neutral",
        "base": {
          "display": "inline-block",
          "padding": "0.2em 0.6em",
          "border-radius": "999px",
          "font-size": "0.85em",
          "font-weight": "600",
          "color": "#fff"
        },
        "states": {},
        "roles": ["success", "danger", "warning", "info"]
      },
      "card": {
        "group": "panel",
        "class": "card",
        "base": {
          "border-radius": "0.75rem",
          "padding": "1.5rem",
          "background": "var(--color-surface-xxl)"
        },
        "states": {},
        "roles": []
      },
      "tag": { "group": "tag" },
      "tooltip": { "group": "tag" },
      "dialog": { "group": "panel" },
      "popover": { "group": "panel" },
      "notification": { "group": "panel" },
      "lightbox": { "group": "panel" },
      "tabs": { "group": "panel" },
      "drawer": { "group": "area", "overrides": { "br": "0" } },
      "carousel": { "group": "area" },
      "details": { "group": "content" },
      "table": { "group": "content" },
      "forms": { "group": "control" }
    }
  },
  "typography": {
    "families": {
      "display": "var(--font-display)",
      "sans": "var(--font-sans)",
      "code": "var(--font-mono, ui-monospace, monospace)"
    },
    "roles": {
      "display": {
        "family": "display",
        "size": "var(--text-3xl)",
        "weight": 700,
        "line-height": "1.0",
        "tracking": "-0.035em",
        "text-wrap": "balance"
      },
      "title": {
        "family": "display",
        "size": "var(--text-2xl)",
        "weight": 600,
        "line-height": "1.12",
        "tracking": "-0.025em",
        "text-wrap": "balance"
      },
      "heading": {
        "family": "display",
        "size": "var(--text-xl)",
        "weight": 600,
        "line-height": "1.3",
        "tracking": "-0.025em",
        "text-wrap": "balance"
      },
      "lead": {
        "family": "sans",
        "size": "var(--text-l)",
        "weight": 400,
        "line-height": "1.5",
        "text-wrap": "pretty"
      },
      "body": {
        "family": "sans",
        "size": "var(--text-m)",
        "weight": 400,
        "line-height": "1.55",
        "text-wrap": "pretty"
      },
      "quote": {
        "family": "display",
        "size": "var(--text-xl)",
        "weight": 400,
        "line-height": "1.3",
        "style": "italic",
        "text-wrap": "balance"
      },
      "caption": {
        "family": "sans",
        "size": "var(--text-s)",
        "weight": 400,
        "line-height": "1.3",
        "color": "var(--color-neutral-l)"
      },
      "eyebrow": {
        "family": "sans",
        "size": "var(--text-s)",
        "weight": 600,
        "line-height": "1.3",
        "tracking": "0.08em",
        "text-transform": "uppercase",
        "color": "var(--color-brand-primary-l)"
      },
      "footnote": {
        "family": "sans",
        "size": "var(--text-xs)",
        "weight": 400,
        "line-height": "1.4",
        "color": "var(--color-neutral-l)"
      },
      "code": {
        "family": "code",
        "size": "0.9em",
        "weight": 400,
        "line-height": "1.5"
      },
      "tag": {
        "family": "sans",
        "size": "0.8rem",
        "weight": 600,
        "line-height": "1",
        "tracking": "0.02em",
        "text-transform": "uppercase"
      }
    },
    "headings": {
      "h1": "display",
      "h2": "title",
      "h3": "heading",
      "h4": "heading"
    }
  }
}
