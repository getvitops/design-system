{
  "meta": {
    "name": "Vitops",
    "description": "Vitops is a calm, structural design system for content-led sites — editorial rather than app-like. It should feel considered and unhurried: generous measure, deliberate vertical rhythm, and colour used sparingly so a single accent still carries weight. Pine green anchors the identity against a deep navy surface; warmth comes from amber and rust, used as signals rather than decoration. Prefer restraint over ornament — depth from tonal layering and hairlines first, shadows only where something genuinely floats."
  },
  "colors": {
    "palette": {
      "pine": {
        "seed": "#4A9075"
      },
      "navy": {
        "seed": "#1A2230"
      },
      "amber": {
        "seed": "#F5B94A"
      },
      "rust": {
        "seed": "#E0625A"
      },
      "cobalt": {
        "seed": "#6F9BFF"
      },
      "grey": {
        "seed": "#6C7689"
      }
    },
    "roles": {
      "neutral": { "hue": "grey", "kind": "surface" },
      "surface": { "hue": "navy", "kind": "surface" },
      "ui-primary": "pine",
      "ui-secondary": "cobalt",
      "ui-accent": "amber",
      "brand-primary": "pine",
      "brand-secondary": "navy",
      "info": "cobalt",
      "success": "pine",
      "warning": "amber",
      "danger": "rust"
    },
    "utilities": ["bg", "text", "icon", "border"]
  },
  "shadows": {
    "sm": "0 1px 2px rgb(0 0 0 / 0.08)",
    "md": "0 4px 6px rgb(0 0 0 / 0.12)",
    "lg": "0 10px 15px rgb(0 0 0 / 0.18)",
    "xl": "0 20px 25px rgb(0 0 0 / 0.22)",
    "2xl": "0 32px 44px rgb(0 0 0 / 0.26)"
  },
  "fonts": {
    "display": "'Mulish', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, monospace"
  },
  "typeScale": {
    "base": "1rem",
    "names": ["2xs", "xs", "s", "m", "l", "xl", "2xl", "3xl", "4xl", "5xl", "6xl", "7xl"],
    "baseStep": 4,
    "baseline": "m",
    "ratio": 1.2,
    "fluid": {
      "minVw": "22.5rem",
      "maxVw": "80rem",
      "minRatio": 1.12
    }
  },
  "spaceScale": {
    "base": "1rem",
    "names": ["2xs", "xs", "s", "m", "l", "xl", "2xl", "3xl", "4xl", "5xl", "6xl", "7xl"],
    "baseStep": 4,
    "baseline": "m",
    "ratio": 1.25,
    "fluid": {
      "minVw": "22.5rem",
      "maxVw": "80rem",
      "minRatio": 1.2
    }
  },
  "patterns": {
    "defaults": {
      "ds": "none",
      "b": "1px solid var(--color-border-surface-muted)",
      "br": "0.375rem",
      "p": "1rem",
      "fs": "1rem"
    },
    "radii": {
      "circle": "50%"
    },
    "groups": {
      "label": {
        "ds": "var(--ds-default)",
        "b": "none",
        "br": "0.25rem",
        "p": "0.25em 0.5em",
        "fs": "0.75rem"
      },
      "control": {
        "ds": "var(--ds-default)",
        "b": "var(--b-default)",
        "br": "var(--br-default)",
        "p": "0.5em 1em",
        "fs": "var(--fs-default)"
      },
      "panel": {
        "ds": "var(--shadow-md)",
        "b": "var(--b-default)",
        "br": "0.5rem",
        "p": "1rem",
        "fs": "var(--fs-default)"
      },
      "area": {
        "ds": "var(--ds-default)",
        "b": "var(--b-default)",
        "br": "0",
        "p": "1.5rem",
        "fs": "var(--fs-default)"
      },
      "content": {
        "ds": "var(--ds-default)",
        "b": "var(--b-default)",
        "br": "0.5rem",
        "p": "1rem",
        "fs": "var(--fs-default)"
      },
      "pull": {
        "ds": "var(--ds-default)",
        "b": "none",
        "br": "0",
        "p": "1.5rem",
        "fs": "1.25rem"
      }
    },
    "z": {
      "raised": 1,
      "sticky": 100,
      "overlay": 200,
      "top": 1000
    },
    "items": {
      "btn": {
        "group": "control",
        "element": "button",
        "class": "btn",
        "fill": false,
        "overrides": {
          "b": "1px solid transparent",
          "fs": "inherit"
        },
        "base": {
          "display": "inline-flex",
          "align-items": "center",
          "justify-content": "center",
          "gap": "0.4em",
          "padding": "var(--p-btn-group)",
          "border-radius": "var(--br-btn-group)",
          "border": "var(--b-btn-group)",
          "box-shadow": "var(--ds-btn-group)",
          "background": "transparent",
          "color": "inherit",
          "font-family": "inherit",
          "font-size": "var(--fs-btn-group)",
          "font-weight": "inherit",
          "line-height": "inherit",
          "text-decoration": "none",
          "cursor": "pointer"
        },
        "states": {
          "hover": {
            "step": 1,
            "css": {
              "background-color": "var(--color-bg-surface-muted)"
            }
          },
          "focus-visible": {
            "ring": true
          }
        },
        "roles": ["success", "danger", "warning", "info"]
      },
      "cta": {
        "group": "control",
        "class": "cta",
        "fill": true,
        "default_role": "ui-primary",
        "overrides": {
          "p": "0.75em 1.5em",
          "b": "none",
          "ds": "var(--shadow-sm)",
          "fs": "inherit"
        },
        "base": {
          "display": "inline-flex",
          "align-items": "center",
          "justify-content": "center",
          "gap": "0.5em",
          "padding": "var(--p-cta-group)",
          "border-radius": "var(--br-cta-group)",
          "border": "var(--b-cta-group)",
          "font-family": "inherit",
          "font-size": "var(--fs-cta-group)",
          "font-weight": "600",
          "line-height": "inherit",
          "text-decoration": "none",
          "cursor": "pointer",
          "color": "var(--color-text-on-ui-primary)",
          "box-shadow": "var(--ds-cta-group)"
        },
        "states": {
          "hover": {
            "step": 1,
            "lift": "1px"
          },
          "active": {
            "scale": 0.97
          },
          "focus-visible": {
            "ring": true
          }
        },
        "roles": ["brand-primary", "success", "danger", "warning", "info"]
      },
      "link": {
        "group": "control",
        "element": "a",
        "class": "link",
        "default_role": "ui-primary",
        "base": {
          "color": "var(--color-text-ui-primary)",
          "text-decoration": "underline",
          "text-underline-offset": "0.15em"
        },
        "states": {
          "hover": {
            "step": 1
          },
          "focus-visible": {
            "ring": true
          }
        },
        "roles": []
      },
      "badge": {
        "group": "label",
        "class": "badge",
        "default_role": "neutral",
        "overrides": {
          "p": "0.2em 0.6em",
          "br": "999px",
          "fs": "0.85em"
        },
        "base": {
          "display": "inline-block",
          "padding": "var(--p-badge-group)",
          "border-radius": "var(--br-badge-group)",
          "font-size": "var(--fs-badge-group)",
          "font-weight": "600",
          "color": "var(--color-text-on-neutral)"
        },
        "states": {},
        "roles": ["success", "danger", "warning", "info"]
      },
      "card": {
        "group": "panel",
        "class": "card",
        "overrides": {
          "p": "1.75rem"
        },
        "base": {
          "border-radius": "var(--br-card-group)",
          "padding": "var(--p-card-group)",
          "background": "var(--color-bg-surface)",
          "border": "var(--b-card-group)",
          "box-shadow": "var(--ds-card-group)"
        },
        "states": {},
        "roles": ["success", "danger", "warning", "info"]
      },
      "tag": {
        "group": "label",
        "class": "tag",
        "default_role": "neutral",
        "overrides": {
          "p": "0.25em 0.6em",
          "b": "1px solid currentColor",
          "fs": "0.85em"
        },
        "base": {
          "display": "inline-flex",
          "align-items": "center",
          "gap": "0.25em",
          "padding": "var(--p-tag-group)",
          "border": "var(--b-tag-group)",
          "border-radius": "var(--br-tag-group)",
          "font-size": "var(--fs-tag-group)",
          "font-weight": "500",
          "line-height": "1.2",
          "white-space": "nowrap",
          "color": "var(--color-text-neutral-bold)"
        },
        "states": {},
        "roles": ["success", "danger", "warning", "info"]
      },
      "status": {
        "group": "label",
        "class": "status-dot",
        "overrides": {
          "br": "var(--br-circle, 50%)"
        },
        "base": {
          "display": "inline-block",
          "inline-size": "var(--status-size, 0.5rem)",
          "block-size": "var(--status-size, 0.5rem)",
          "border-radius": "var(--br-status-group)",
          "background-color": "var(--color-bg-neutral-bold)"
        },
        "states": {},
        "roles": ["success", "danger", "warning", "info"]
      },
      "tooltip": {
        "group": "label"
      },
      "dialog": {
        "group": "panel"
      },
      "popover": {
        "group": "panel"
      },
      "dropdown": {
        "group": "panel"
      },
      "notification": {
        "group": "panel"
      },
      "lightbox": {
        "group": "panel"
      },
      "comment": {
        "group": "panel"
      },
      "tabs": {
        "group": "panel"
      },
      "drawer": {
        "group": "area",
        "overrides": {
          "br": "0"
        }
      },
      "carousel": {
        "group": "area"
      },
      "gallery": {
        "group": "area"
      },
      "nav": {
        "group": "area"
      },
      "banner": {
        "group": "area"
      },
      "details": {
        "group": "content"
      },
      "table": {
        "group": "content"
      },
      "list": {
        "group": "content"
      },
      "tree": {
        "group": "content"
      },
      "pull-quote": {
        "group": "pull"
      },
      "combobox": {
        "group": "control"
      },
      "forms": {
        "group": "control"
      }
    }
  },
  "typography": {
    "families": {
      "display": "var(--font-display)",
      "sans": "var(--font-sans)",
      "code": "var(--font-mono, ui-monospace, monospace)"
    },
    "roles": {
      "display": {
        "family": "display",
        "size": "var(--text-6xl)",
        "weight": 700,
        "line-height": "1.0",
        "tracking": "-0.035em",
        "text-wrap": "balance"
      },
      "title": {
        "family": "display",
        "size": "var(--text-5xl)",
        "weight": 600,
        "line-height": "1.12",
        "tracking": "-0.025em",
        "text-wrap": "balance"
      },
      "heading": {
        "family": "display",
        "size": "var(--text-xl)",
        "weight": 600,
        "line-height": "1.3",
        "tracking": "-0.025em",
        "text-wrap": "balance"
      },
      "lead": {
        "family": "sans",
        "size": "var(--text-l)",
        "weight": 400,
        "line-height": "1.5",
        "text-wrap": "pretty"
      },
      "body": {
        "family": "sans",
        "size": "var(--text-m)",
        "weight": 400,
        "line-height": "1.55",
        "text-wrap": "pretty"
      },
      "quote": {
        "family": "display",
        "size": "var(--text-xl)",
        "weight": 400,
        "line-height": "1.3",
        "style": "italic",
        "text-wrap": "balance"
      },
      "caption": {
        "family": "sans",
        "size": "var(--text-s)",
        "weight": 400,
        "line-height": "1.3",
        "text-wrap": "pretty",
        "color": "var(--color-text-neutral-muted)"
      },
      "eyebrow": {
        "family": "sans",
        "size": "var(--text-s)",
        "weight": 600,
        "line-height": "1.3",
        "tracking": "0.08em",
        "text-transform": "uppercase",
        "text-wrap": "balance",
        "color": "var(--color-text-brand-primary)"
      },
      "footnote": {
        "family": "sans",
        "size": "var(--text-xs)",
        "weight": 400,
        "line-height": "1.4",
        "text-wrap": "pretty",
        "color": "var(--color-text-neutral-muted)"
      },
      "code": {
        "family": "code",
        "size": "0.9em",
        "weight": 400,
        "line-height": "1.5",
        "text-wrap": "wrap"
      },
      "tag": {
        "family": "sans",
        "size": "0.8rem",
        "weight": 600,
        "line-height": "1",
        "tracking": "0.02em",
        "text-transform": "uppercase",
        "text-wrap": "wrap"
      }
    },
    "headings": {
      "body": "body",
      "h1": "display",
      "h2": "title",
      "h3": "heading",
      "h4": "heading"
    }
  },
  "animations": {
    "effects": {
      "fade-in": {
        "kf": "composite",
        "vars": {
          "opacity-from": 0
        }
      },
      "fade-out": {
        "kf": "composite",
        "vars": {
          "opacity-from": 1,
          "opacity-to": 0
        }
      },
      "slide-up": {
        "kf": "composite",
        "vars": {
          "translate-y-from": "var(--slide-distance, 2rem)"
        }
      },
      "slide-down": {
        "kf": "composite",
        "vars": {
          "translate-y-from": "calc(-1 * var(--slide-distance, 2rem))"
        }
      },
      "slide-left": {
        "kf": "composite",
        "vars": {
          "translate-x-from": "var(--slide-distance, 2rem)"
        }
      },
      "slide-right": {
        "kf": "composite",
        "vars": {
          "translate-x-from": "calc(-1 * var(--slide-distance, 2rem))"
        }
      },
      "scale-up": {
        "kf": "composite",
        "vars": {
          "scale-x-from": 0.9,
          "scale-y-from": 0.9
        }
      },
      "scale-down": {
        "kf": "composite",
        "vars": {
          "scale-x-from": 1.1,
          "scale-y-from": 1.1
        }
      },
      "rotate-cw": {
        "kf": "composite",
        "vars": {
          "rotate-from": "0deg",
          "rotate-to": "360deg"
        }
      },
      "rotate-ccw": {
        "kf": "composite",
        "vars": {
          "rotate-from": "0deg",
          "rotate-to": "-360deg"
        }
      },
      "blur-in": {
        "kf": "paint",
        "vars": {
          "blur-from": "var(--blur-amount, 10px)"
        }
      },
      "blur-out": {
        "kf": "paint",
        "vars": {
          "blur-from": 0,
          "blur-to": "var(--blur-amount, 10px)"
        }
      },
      "elevate-up": {
        "kf": "paint",
        "vars": {
          "shadow-from": "0 0 0 transparent",
          "shadow-to": "var(--default-shadow, 0 4px 6px rgba(0, 0, 0, 0.1))"
        }
      },
      "elevate-down": {
        "kf": "paint",
        "vars": {
          "shadow-from": "var(--default-shadow, 0 4px 6px rgba(0, 0, 0, 0.1))",
          "shadow-to": "0 0 0 transparent"
        }
      },
      "reveal-left": {
        "kf": "paint",
        "vars": {
          "clip-from": "inset(0 100% 0 0)",
          "clip-to": "inset(0)"
        }
      },
      "reveal-right": {
        "kf": "paint",
        "vars": {
          "clip-from": "inset(0 0 0 100%)",
          "clip-to": "inset(0)"
        }
      },
      "reveal-up": {
        "kf": "paint",
        "vars": {
          "clip-from": "inset(100% 0 0 0)",
          "clip-to": "inset(0)"
        }
      },
      "reveal-down": {
        "kf": "paint",
        "vars": {
          "clip-from": "inset(0 0 100% 0)",
          "clip-to": "inset(0)"
        }
      },
      "size-grow": {
        "kf": "layout",
        "css": {
          "overflow": "clip"
        },
        "vars": {
          "height-from": 0,
          "height-to": "auto"
        }
      },
      "size-shrink": {
        "kf": "layout",
        "css": {
          "overflow": "clip"
        },
        "vars": {
          "height-from": "auto",
          "height-to": 0
        }
      }
    },
    "journeys": {
      "base": {
        "fade": {
          "opacity-from": 0
        },
        "slide": {
          "translate-y-from": "var(--slide-distance, 2rem)"
        },
        "scale": {
          "scale-x-from": 0.8,
          "scale-y-from": 0.8
        },
        "blur": {
          "blur-from": "5px"
        }
      },
      "compose": [
        ["fade"],
        ["slide"],
        ["scale"],
        ["blur"],
        ["fade", "slide"],
        ["fade", "scale"],
        ["fade", "blur"],
        ["fade", "slide", "scale"],
        ["fade", "scale", "blur"]
      ]
    }
  }
}
