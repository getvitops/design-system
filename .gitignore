node_modules/
*.env*

# Generated / build output (emitted by the codegen + build; rebuilt via `vp run build`)
dist/
src/css/generated/

# Workspace package build output + snapshotted framework assets (rebuilt from source)
packages/*/dist/
packages/generator/assets/
packages/generator/schema.json
packages/generator/site.schema.json

# apps/portal (extraction-bound playground)
apps/*/.dev.vars
apps/*/.wrangler/
apps/*/.astro/
apps/*/.pglite/
apps/portal/src/styles/tailwind.css
apps/portal/src/styles/tokens.json
# generated by the @getvitops/astro integration (favicons + WC bundles)
apps/portal/public/favicon.*
apps/portal/public/icon-*.png
apps/portal/public/apple-touch-icon.png
apps/portal/public/site.webmanifest
apps/portal/public/vitops/

.npmrc
