node_modules/
*.env*

# Generated / build output (emitted by the codegen + build; rebuilt via `vp run build`)
dist/
src/css/generated/

# `vp test run --coverage` (@vitest/coverage-v8)
coverage/

# Workspace package build output + snapshotted framework assets (rebuilt from source)
packages/*/dist/
packages/generator/assets/
packages/generator/schema.json
packages/generator/config.schema.json

# site/ (docs site) — dist/ already covered by the generic rule above
site/.dev.vars
site/.wrangler/
site/.astro/

# The emdash template's own `.astro/` — the template ships `_gitignore`
# (renamed to `.gitignore` on scaffold, per AGENTS.md), which doesn't apply
# to files sitting inside it while it's still template source in THIS repo.
# `scripts/link-template-deps.mjs` writes an `astro:content` ambient shim
# here (astro's own real path for that, via `astro sync`, which this
# monorepo's own `vp check` can't run) — never tracked, never scaffolded.
packages/create/templates/*/.astro/

.npmrc
.vitest/
