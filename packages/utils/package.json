{
  "name": "@getvitops/utils",
  "version": "8.1.0",
  "description": "Shared build-time utilities for the Vitops toolchain — favicon generation and friends.",
  "homepage": "https://docs.vitops.ca",
  "bugs": "https://github.com/getvitops/design-system/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getvitops/design-system.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./favicon": {
      "types": "./dist/favicon.d.mts",
      "import": "./dist/favicon.mjs"
    },
    "./color": {
      "types": "./dist/color/index.d.mts",
      "import": "./dist/color/index.mjs"
    },
    "./indexing": {
      "types": "./dist/indexing/index.d.mts",
      "import": "./dist/indexing/index.mjs"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.mts",
      "import": "./dist/onboarding/index.mjs"
    },
    "./reviews": {
      "types": "./dist/reviews/index.d.mts",
      "import": "./dist/reviews/index.mjs"
    },
    "./ads": {
      "types": "./dist/ads/index.d.mts",
      "import": "./dist/ads/index.mjs"
    },
    "./media": {
      "types": "./dist/media/index.d.mts",
      "import": "./dist/media/index.mjs"
    },
    "./notify": {
      "types": "./dist/notify/index.d.mts",
      "import": "./dist/notify/index.mjs"
    },
    "./tracking": {
      "types": "./dist/tracking/index.d.mts",
      "import": "./dist/tracking/index.mjs"
    },
    "./security": {
      "types": "./dist/security/index.d.mts",
      "import": "./dist/security/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "import": "./dist/schema/index.mjs"
    },
    "./hosting": {
      "types": "./dist/hosting/index.d.mts",
      "import": "./dist/hosting/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "colorjs.io": "catalog:",
    "parse5": "catalog:",
    "png-to-ico": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
