{
  "name": "@getvitops/astro",
  "version": "0.4.2",
  "description": "Astro integration for the Vitops design system — favicons/PWA, web-component scripts, and CSS, via a getvitops() integration + <Head /> component.",
  "license": "MIT",
  "files": [
    "dist",
    "src/components/Head.astro",
    "src/components/Subgrid.astro",
    "src/components/Cards.astro",
    "src/components/NodeRenderer.astro",
    "src/components/WebComponentLoader.astro",
    "src/components/Popover.astro",
    "src/components/Details.astro",
    "src/components/Drawer.astro",
    "src/schemas",
    "virtual.d.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./Head.astro": "./src/components/Head.astro",
    "./components/Subgrid.astro": "./src/components/Subgrid.astro",
    "./components/Cards.astro": "./src/components/Cards.astro",
    "./components/NodeRenderer.astro": "./src/components/NodeRenderer.astro",
    "./components/WebComponentLoader.astro": "./src/components/WebComponentLoader.astro",
    "./components/Popover.astro": "./src/components/Popover.astro",
    "./components/Details.astro": "./src/components/Details.astro",
    "./components/Drawer.astro": "./src/components/Drawer.astro",
    "./schemas/*": "./src/schemas/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@getvitops/core": "workspace:*",
    "@getvitops/generator": "workspace:*",
    "@getvitops/utils": "workspace:*",
    "@getvitops/vite": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "astro": "catalog:"
  },
  "peerDependencies": {
    "astro": ">=7",
    "astro-icon": ">=1"
  },
  "peerDependenciesMeta": {
    "astro-icon": {
      "optional": true
    }
  }
}
