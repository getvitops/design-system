---
/**
 * <Ads /> — the site's advertising pixels, off the critical path and behind the
 * consent gate. Place in your layout's <head>; requires the vitops()
 * integration, which supplies `virtual:getvitops/head`.
 *
 * A dumb renderer over `resolveAds()` (src/ads.ts) — which properties, which
 * consent category, which cookies and whether this environment fires at all are
 * decided there and unit-tested. Nothing in this file chooses anything.
 *
 * The properties come from the site config's `site.ads` block, not from an
 * integration option: the ad account is a fact about the site, and the same block
 * drives `vitops ads setup` (the domain-verification record), `vitops ads lint`
 * and the cookie notice `vitops legal` generates. One source, so a pixel cannot be
 * running while the site's own notice omits it.
 *
 * Pairs with <Tracking />, which captures the click ID the pixel's platform
 * stamped on the landing URL. Neither implies the other — attribution works with
 * no pixel, and a pixel works with no attribution — but a site running ads
 * normally wants both.
 */
import { resolveAds } from '../ads.ts';
import type { AnalyticsStrategy } from '../analytics.ts';
import GatedTags from './GatedTags.astro';
// @ts-ignore — virtual module provided by the vitops() integration at build time
import head from 'virtual:getvitops/head';

interface Props {
  /** Render nothing on this page. Defaults to true (the per-environment switch is `environments.<env>.ads`). */
  enabled?: boolean;
  /** Override the load strategy for this page. */
  strategy?: AnalyticsStrategy;
}
const { enabled = true, strategy } = Astro.props;

// `head.ads` is already environment-resolved by the integration; `enabled` here is
// the per-page override on top of it.
const { tags } = enabled
  ? resolveAds(head.ads?.properties, {
      consent: head.consent,
      enabled: head.ads?.enabled,
      ...(strategy ? { strategy } : {}),
    })
  : { tags: [] };
---

<GatedTags tags={tags} />
