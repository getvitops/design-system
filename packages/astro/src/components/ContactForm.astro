---
/**
 * ContactForm: a contact / enquiry form that posts to the site's conversion endpoint.
 *
 *   <ContactForm />                                  <!-- name, email, phone, message -->
 *   <ContactForm fields={[{ label: 'Name', required: true }, { label: 'Email', type: 'email' }]} />
 *
 * Tier 1 first: a real `<form method="post">` of real `<label>`s, styled by the framework's
 * `forms.css` vocabulary, that works with no JavaScript. It posts to `createConversionRoute()`
 * (`@getvitops/astro/routes`, default `/api/track`), which applies the honeypot, origin, size and
 * rate checks, verifies Turnstile, then writes the CRM and emails the notification. This component
 * decides none of that: it only emits markup that route understands. It is also what the
 * `vitops_form` block (`@getvitops/emdash`) renders, so a form authored in code and one edited in
 * the CMS cannot differ.
 *
 * **Why use it instead of a hand-written `<form>`.** Three names are the route's, not the form's:
 * a field called `phone` is dropped (it is the `tel:` click payload), a filled `website` /
 * `honeypot` / `_honeypot` makes the route answer success and deliver nothing, and `_next` is the
 * return path. `@getvitops/utils/contact-form` keeps every field clear of them, so a "Phone" input
 * submits as `tel`, which the notification and CRM read as the phone number. A hand-rolled form
 * that names its input `phone` loses the number with nothing logged.
 *
 * `fields` takes rows (`label`, `type`: text | email | tel | textarea | select | checkbox |
 * checkboxes, `required`, `name`, `placeholder`, `help`, `options` one per line); with none given,
 * the four fields above. A `name` you give is kept unless it is reserved, in which case it is
 * renamed rather than silently dropped.
 *
 * The no-JS round trip. The route answers a form post with a 303 back to the `_next` hidden field
 * (this page's path, a same-site path only) plus `?sent=1#form-sent` or `?error=1#form-error`. The
 * page is usually prerendered and cannot know which happened, so both messages are always in the
 * markup and `.form-notice--target:not(:target)` hides whichever the URL fragment does not name.
 * They carry `tabindex="-1"` so following the fragment moves focus to the message. One form per
 * page: the fragment ids are fixed.
 *
 * Spam protection, in layers: a honeypot named per the route's default, the route's own
 * origin/rate/size checks, and Cloudflare Turnstile when `site.security.turnstile.siteKey` exists
 * (read from the build's `virtual:getvitops/head`; pass `turnstileSiteKey` to override, `null` to
 * turn it off). Turnstile is `<wc-turnstile>`, which loads Cloudflare's script only on first
 * interaction with the form; its slotted paragraph is the no-JS explanation. With no site key
 * there is no widget and no third-party reference at all.
 *
 * Email-list opt-in (`site.campaigns`). `subscribeList="waitlist"` adds an unticked "Email me
 * updates" checkbox plus a hidden list key; the route subscribes the visitor only when it is
 * ticked, never on the cookie-consent category. `subscribeOnly` makes it a dedicated signup: no
 * checkbox, the submit button is the opt-in (a hidden consent field), and a visible statement says
 * what the visitor agrees to. `subscribeLabel` is the checkbox label or that statement. The field
 * names default to `site.campaigns`'s (`subscribe`, `list`); an author's own field of the same
 * name is renamed rather than shadowed.
 *
 * Slot: content shown above the notices, such as a heading and an intro. Extra HTML attributes
 * (`id`, `class`, `style`) go on the outer `<div>`.
 */
import type { HTMLAttributes } from 'astro/types';
import head from 'virtual:getvitops/head';
import {
  CONSENT_VALUE,
  DEFAULT_CONTACT_ROWS,
  HONEYPOT_NAME,
  resolveFields,
  resolveSubscribe,
  safeAction,
  safeNext,
  subscribeReserved,
} from '@getvitops/utils/contact-form';

export interface Props extends Omit<HTMLAttributes<'div'>, 'slot'> {
  /** Field rows; see above. Default: name, email, phone, message. */
  fields?: Record<string, unknown>[];
  /** Where the form posts: a same-site path. Default `/api/track`. */
  action?: string;
  /** The path to return to after a no-JS submit. Default: this page. */
  next?: string;
  submitLabel?: string;
  successMessage?: string;
  errorMessage?: string;
  /** Shown inside the Turnstile widget until it upgrades (and with no JS). */
  noJsMessage?: string;
  /** Turnstile site key. Default: `site.security.turnstile.siteKey`. `null` turns the widget off. */
  turnstileSiteKey?: string | null;
  /** Classes for the success and error notices. Defaults tint them with the success / danger roles. */
  successClass?: string;
  errorClass?: string;
  /** Inline `style` for the notices, for a wrapper that tones them with custom properties. */
  successStyle?: string;
  errorStyle?: string;
  /** The `site.campaigns` list key(s) this form subscribes to; see above. Omit for a plain enquiry form. */
  subscribeList?: string;
  /** The opt-in checkbox label, or for `subscribeOnly` the consent statement. */
  subscribeLabel?: string;
  /** A dedicated signup: the submit button is the opt-in, no checkbox. */
  subscribeOnly?: boolean;
  /** Override `site.campaigns.consentField` / `listField` when the site renamed them. */
  subscribeConsentField?: string;
  subscribeListField?: string;
}

const {
  fields: rows = DEFAULT_CONTACT_ROWS,
  action: actionProp,
  next: nextProp,
  submitLabel = 'Send',
  successMessage = 'Thanks. Your message has been sent.',
  errorMessage = 'Sorry, your message could not be sent. Please try again, or contact us another way.',
  noJsMessage = 'The spam check on this form needs JavaScript. If it is turned off, please contact us by email or phone instead.',
  turnstileSiteKey,
  successClass = 'bg-success-muted',
  errorClass = 'bg-danger-muted',
  successStyle,
  errorStyle,
  subscribeList,
  subscribeLabel,
  subscribeOnly,
  subscribeConsentField,
  subscribeListField,
  class: className,
  ...rest
} = Astro.props;

const subscribe = resolveSubscribe({
  list: subscribeList,
  label: subscribeLabel,
  only: subscribeOnly,
  consentField: subscribeConsentField,
  listField: subscribeListField,
});
const fields = resolveFields(rows, subscribeReserved(subscribe));
const action = safeAction(actionProp);
const next = safeNext(nextProp ?? Astro.url.pathname) ?? '/';
const siteKey =
  turnstileSiteKey !== undefined
    ? turnstileSiteKey
    : typeof head?.turnstileSiteKey === 'string'
      ? head.turnstileSiteKey
      : null;
---

<div {...rest} class:list={['form-block', 'rhythm', className]}>
  <slot />

  <div
    id="form-sent"
    class:list={['callout', 'form-notice--target', successClass]}
    style={successStyle}
    role="status"
    tabindex="-1"
  >
    <div class="callout__body">
      <p class="callout__text">{successMessage}</p>
    </div>
  </div>
  <div
    id="form-error"
    class:list={['callout', 'form-notice--target', errorClass]}
    style={errorStyle}
    role="alert"
    tabindex="-1"
  >
    <div class="callout__body">
      <p class="callout__text">{errorMessage}</p>
    </div>
  </div>

  <form method="post" action={action} class="rhythm">
    <input type="hidden" name="_next" value={next} />
    {fields.map((f) => {
      const describedby = f.help ? `${f.id}-help` : undefined;
      const requiredMark = f.required ? { required: true, 'aria-required': 'true' } : {};
      return f.type === 'checkbox' ? (
        <div class="form-group">
          <label class="custom-check">
            <input
              type="checkbox"
              id={f.id}
              name={f.name}
              value="yes"
              aria-describedby={describedby}
              {...requiredMark}
            />
            <span class="custom-check__box">
              <span class="custom-check__indicator custom-check__indicator--check" />
            </span>
            <span>{f.label}</span>
          </label>
          {f.help && (
            <p id={`${f.id}-help`} class="form-group__helper">
              {f.help}
            </p>
          )}
        </div>
      ) : f.type === 'checkboxes' ? (
        <fieldset class="form-group" aria-describedby={describedby}>
          <legend class="form-group__label">{f.label}</legend>
          {f.options.map((o) => (
            <label class="custom-check">
              <input type="checkbox" name={f.name} value={o} />
              <span class="custom-check__box">
                <span class="custom-check__indicator custom-check__indicator--check" />
              </span>
              <span>{o}</span>
            </label>
          ))}
          {f.help && (
            <p id={`${f.id}-help`} class="form-group__helper">
              {f.help}
            </p>
          )}
        </fieldset>
      ) : (
        <div class="form-group">
          <label class="form-group__label" for={f.id}>
            {f.label}
            {!f.required && <span class="form-group__optional">(optional)</span>}
          </label>
          {f.type === 'textarea' ? (
            <textarea
              id={f.id}
              name={f.name}
              rows="5"
              placeholder={f.placeholder || undefined}
              aria-describedby={describedby}
              {...requiredMark}
            />
          ) : f.type === 'select' ? (
            <div class="custom-select">
              <select id={f.id} name={f.name} aria-describedby={describedby} {...requiredMark}>
                <option value="">Choose one</option>
                {f.options.map((o) => (
                  <option value={o}>{o}</option>
                ))}
              </select>
            </div>
          ) : (
            <input
              type={f.type}
              id={f.id}
              name={f.name}
              placeholder={f.placeholder || undefined}
              autocomplete={f.autocomplete}
              aria-describedby={describedby}
              {...requiredMark}
            />
          )}
          {f.help && (
            <p id={`${f.id}-help`} class="form-group__helper">
              {f.help}
            </p>
          )}
        </div>
      );
    })}

    {subscribe && (
      <>
        <input type="hidden" name={subscribe.listField} value={subscribe.list} />
        {subscribe.mode === 'only' ? (
          <>
            <input type="hidden" name={subscribe.consentField} value={CONSENT_VALUE} />
            <p class="form-group__helper">{subscribe.label}</p>
          </>
        ) : (
          <div class="form-group">
            <label class="custom-check">
              <input type="checkbox" name={subscribe.consentField} value={CONSENT_VALUE} />
              <span class="custom-check__box">
                <span class="custom-check__indicator custom-check__indicator--check" />
              </span>
              <span>{subscribe.label}</span>
            </label>
          </div>
        )}
      </>
    )}

    {/* Honeypot: named per createConversionRoute's default list. Positioned off-screen rather than
          display:none (which simple bots skip), and hidden from assistive tech and the tab order. */}
    <div class="sr-only" aria-hidden="true">
      <label>
        Leave this field empty
        <input type="text" name={HONEYPOT_NAME} tabindex="-1" autocomplete="off" />
      </label>
    </div>

    {siteKey && (
      <wc-turnstile sitekey={siteKey}>
        <p class="form-group__helper" data-turnstile-fallback>
          {noJsMessage}
        </p>
      </wc-turnstile>
    )}

    <p>
      <button type="submit" class="cta">
        {submitLabel}
      </button>
    </p>
  </form>
</div>
