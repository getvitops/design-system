---
import { Icon } from 'astro-icon/components';
import Popover from './Popover.astro';
import { t } from '../../utils/i18n.js';
import { normalizeImageRef } from '../utils/images';
import { icon } from '../utils/icon-resolver';
import { partAttrs } from '../../utils/parts.js';
import siteConfig from '#site-config';
import type { Link } from '../../types.js';

interface Props {
  link: Link;
  navId: string;
  locale?: string;
  defaultLocale?: string;
}

const {
  link,
  navId,
  locale = siteConfig.defaultLocale,
  defaultLocale = siteConfig.defaultLocale,
} = Astro.props;

if (!link.submenu) {
  throw new Error('Submenu component requires link.submenu to be defined');
}

const submenu = link.submenu;
const resolve = (value: Localizable | undefined) => t(value, locale, defaultLocale);
const label = 'label' in link ? resolve(link.label) : normalizeImageRef(link.image).alt;
const slugLabel = label.toLowerCase().replace(/\s+/g, '-');
const submenuId = `${navId}-${slugLabel}`;

const present = submenu.present;

const { class: rootCls, ...rootRest } = partAttrs(present, 'root');
const { class: linkCls, ...linkRest } = partAttrs(present, 'link');
const { class: triggerCls, ...triggerRest } = partAttrs(present, 'trigger');
const { class: closeCls, ...closeRest } = partAttrs(present, 'close');
const { class: menuCls, ...menuRest } = partAttrs(present, 'menu');
const { class: itemsCls, ...itemsRest } = partAttrs(present, 'items');
---

{present?.as === 'split-link' ? (
  <div class:list={["split-link", "split-link--show-on-hover", rootCls]} {...rootRest}>
    <a href={link.href} class:list={["nav-link", "split-link__label", linkCls]} {...linkRest}>
      {link.icon && <Icon name={icon(link.icon)} />}
      {label}
    </a>
    <Popover
      id={submenuId}
      type={present.type ?? 'auto'}
      anchorName={present.anchorName ?? `${slugLabel}-submenu`}
      positionArea={present.positionArea ?? 'block-end span-inline-start'}
      class="split-link__popover"
    >
      <button
        slot="trigger"
        class:list={["split-link__trigger", triggerCls]}
        popovertarget={submenuId}
        style={`anchor-name: --${present.anchorName ?? `${slugLabel}-submenu`}`}
        aria-label={`${label} submenu`}
        {...triggerRest}
      >
        <Icon name={icon('expand-more')} class="dropdown-icon" />
      </button>
      <ul class:list={["menu", "p-4", "bg-base-100", "rounded-box", menuCls]} {...menuRest}>
        {submenu.items.map((subitem: Link) => (
          <li class:list={[itemsCls, subitem.itemAttrs?.class]} {...itemsRest} {...subitem.itemAttrs}>
            <a href={subitem.href}>
              {subitem.icon && <Icon name={icon(subitem.icon)} />}
              {'label' in subitem && resolve(subitem.label)}
            </a>
          </li>
        ))}
      </ul>
    </Popover>
  </div>
) : present?.as === 'dropdown' ? (
  <div class:list={["dropdown", "dropdown--show-on-hover", rootCls]} {...rootRest}>
    <Popover
      id={submenuId}
      type={present.type ?? 'auto'}
      anchorName={present.anchorName ?? `${slugLabel}-submenu`}
      positionArea={present.positionArea ?? 'block-end span-inline-start'}
      class="dropdown-menu"
    >
      <button
        slot="trigger"
        class:list={["nav-link", "dropdown-trigger", triggerCls]}
        popovertarget={submenuId}
        style={`anchor-name: --${present.anchorName ?? `${slugLabel}-submenu`}`}
        {...triggerRest}
      >
        {link.icon && <Icon name={icon(link.icon)} />}
        {label}
        <Icon name={icon('expand-more')} class="dropdown-icon" />
      </button>
      <ul class:list={["menu", "p-4", "bg-base-100", "rounded-box", menuCls]} {...menuRest}>
        {submenu.items.map((subitem: Link) => (
          <li class:list={[itemsCls, subitem.itemAttrs?.class]} {...itemsRest} {...subitem.itemAttrs}>
            <a href={subitem.href}>
              {subitem.icon && <Icon name={icon(subitem.icon)} />}
              {'label' in subitem && resolve(subitem.label)}
            </a>
          </li>
        ))}
      </ul>
    </Popover>
  </div>
) : present?.as === 'drawer' ? (
  <Popover
    id={submenuId}
    type="manual"
    class:list={["drawer-submenu", rootCls]}
    {...rootRest}
  >
    <button
      slot="trigger"
      class:list={["nav-link", "drawer-trigger", triggerCls]}
      popovertarget={submenuId}
      {...triggerRest}
    >
      {link.icon && <Icon name={icon(link.icon)} />}
      {label}
      <Icon name={icon('chevron-right')} class="drawer-icon" />
    </button>

    <button
      popovertarget={submenuId}
      popovertargetaction='hide'
      class:list={["drawer-close", closeCls]}
      aria-label="Close submenu"
      {...closeRest}
    >
      <Icon name={icon('close')} />
      <span class="sr-only">Close</span>
    </button>

    <ul class:list={["drawer-menu-items", menuCls]} {...menuRest}>
      {submenu.items.map((subitem: Link) => (
        <li class:list={[itemsCls, subitem.itemAttrs?.class]} {...itemsRest} {...subitem.itemAttrs}>
          <a href={subitem.href}>
            {subitem.icon && <Icon name={icon(subitem.icon)} />}
            {'label' in subitem && resolve(subitem.label)}
          </a>
        </li>
      ))}
    </ul>
  </Popover>
) : (
  <!-- Default: accordion (details/collapse) -->
  <details class:list={["nav-collapse", rootCls]} name={present?.as === 'accordion' ? present.name : undefined} {...rootRest}>
    <summary class:list={["nav-link", triggerCls]} {...triggerRest}>
      {link.icon && <Icon name={icon(link.icon)} />}
      {label}
      <Icon name={icon('expand-more')} class="collapse-icon" />
    </summary>
    <ul class:list={["collapse-menu", menuCls]} {...menuRest}>
      {submenu.items.map((subitem: Link) => (
        <li class:list={[itemsCls, subitem.itemAttrs?.class]} {...itemsRest} {...subitem.itemAttrs}>
          <a href={subitem.href}>
            {subitem.icon && <Icon name={icon(subitem.icon)} />}
            {'label' in subitem && resolve(subitem.label)}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

<style>
  .split-link {
    display: flex;
    align-items: center;
  }

  .split-link__trigger {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: inherit;
    font-size: inherit;
  }

  .dropdown-icon,
  .collapse-icon,
  .drawer-icon {
    margin-inline-start: auto;
    transition: transform 0.2s ease;
  }

  .nav-collapse[open] .collapse-icon {
    transform: rotate(180deg);
  }

  .drawer-submenu {
    position: fixed;
    inset: 0;
    background: var(--color-surface-base, white);
    z-index: var(--z-tier-overlay);
  }

  .drawer-menu-items {
    list-style: none;
    padding: 2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .drawer-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    font-size: 1.5rem;
  }
</style>
