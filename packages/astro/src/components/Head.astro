---
/**
 * <Head /> — the Vitops design system's <head> contributions. Place inside your
 * layout's <head>. Requires the vitops() integration (it provides the
 * `virtual:getvitops/head` config + copies the assets into public/).
 *
 * Renders: favicon + PWA manifest tags, the webfont <Font /> tags for families
 * declared via vitops({ fonts }), and the web-component runtime scripts in
 * canonical order/priority. It does NOT emit a stylesheet <link> — the CSS is
 * imported into Astro's graph by the integration and Astro emits that link.
 */
// @ts-ignore — virtual module provided by the vitops() integration at build time
import head from 'virtual:getvitops/head';
// @ts-ignore — `Font` is provided by Astro's Fonts API (astro >= 7)
import { Font } from 'astro:assets';
import { CONSENT_STUB, THEME_SCRIPT } from '../inline-scripts.ts';

interface Props {
  favicons?: boolean;
  webComponents?: boolean;
  editor?: boolean;
  /** Emit `<Font />` for the declared families (default true when any were declared). */
  fonts?: boolean;
}
const {
  favicons = head.favicons,
  webComponents = head.webComponents,
  editor = head.editor,
  fonts = true,
} = Astro.props;
const wc = head.wcBase;

/*
 * The two inline scripts below (THEME_SCRIPT, CONSENT_STUB) are defined in
 * `../inline-scripts.ts`, with the reasoning for each. They are imported rather
 * than written here so `csp.ts` hashes the very same constants this emits — a
 * strict Content-Security-Policy names inline scripts by hash of their bytes.
 */

/*
 * No `<html>` class flips here on purpose. `animation.css` used to need `no-js`
 * and `.no-scroll-timeline` set before first paint; it now asks the platform
 * directly — `@media (scripting: enabled)` and `@supports not
 * (animation-timeline: view())` — so there is nothing to inject.
 *
 * That is not a simplification for its own sake: a class-based switch could only
 * ever reach pages that render this component, so a Bricks site or a consumer
 * with their own `<head>` stayed broken, and `no-js` in particular had to be
 * written into an `<html>` tag Astro does not own. The CSS version is correct for
 * every consumer of the stylesheet, including the ones that never load any JS.
 */
---

{favicons && head.faviconLinks.map((l: { rel: string; href: string; type?: string; sizes?: string }) => (
  <link rel={l.rel} href={l.href} type={l.type} sizes={l.sizes} />
))}
{favicons && head.themeColor && <meta name="theme-color" content={head.themeColor} />}

{/*
  Webfonts declared via vitops({ fonts }). Astro's `fonts:` config resolves and
  optimises the files; this component is what actually puts the @font-face on the page,
  so without it the config is inert and every --font-* token falls through to its
  fallback stack.

  Only families this integration registered — <Font /> throws on a cssVariable Astro
  cannot resolve, so a family from a user-level `fonts:` or another integration is
  deliberately not listed here; render <Font /> for those yourself.

  `preload` comes from the declaration, so which faces get a preload link is a property
  of the font, not something re-decided in every layout.
*/}
{fonts && head.fonts.map((f: { cssVariable: string; preload: boolean | object[] }) => (
  <Font cssVariable={f.cssVariable} preload={f.preload} />
))}

{/* Set by vitops({ sitemap }); null when no sitemap was registered. */}
{head.sitemap && <link rel="sitemap" type="application/xml" href={head.sitemap} />}

{/*
  The consent stub — synchronous, and ahead of every module script on purpose.
  See CONSENT_STUB above: it exists so that code which loads before the gate can
  tell "the gate isn't here yet" from "this site has no gate", and queue rather
  than assume it may store. Keyed on `head.consent` (is the gate on?) rather than
  `head.consentRuntime` (does anything need scheduling?) — a site whose only tag
  is cookieless loads the runtime to schedule it but gates nothing, so there is
  nothing for a caller to queue behind.
*/}
{head.consent && <script is:inline set:html={CONSENT_STUB} />}

{webComponents && (
  <>
    {/*
      Apply the remembered colour scheme before first paint.

      `<wc-color-scheme-toggle>` persists the choice to localStorage, but it loads
      as a deferred module — so without this every navigation would paint the
      light token set and flip to dark once the element upgraded. Synchronous and
      inline on purpose: it has to run before the body renders.

      The key MUST match `WCColorSchemeToggle.STORAGE_KEY` in @getvitops/core;
      `head.test.ts` asserts they stay in step. Wrapped in try/catch because
      localStorage throws in private/partitioned contexts.
    */}
    <script is:inline set:html={THEME_SCRIPT} />
    <link rel="modulepreload" href={`${wc}/polyfills.js`} />
    <script is:inline type="module" src={`${wc}/polyfills.js`}></script>
    <script is:inline defer src={`${wc}/deferred.js`}></script>
    <script is:inline type="module" src={`${wc}/elements.js`}></script>
  </>
)}

{/*
  The consent gate + <wc-consent> — its own Lit-free bundle, loaded whenever the
  gate is on or a tag needs scheduling. Deliberately NOT inside the
  `webComponents` block: this module decides whether third-party tags run at all,
  so it must not be switched off along with the element runtime, and it must be
  free to load ahead of the deferred Lit bundle rather than behind it.
*/}
{head.consentRuntime && <script is:inline type="module" src={`${wc}/consent.js`}></script>}

{/*
  The live theme editor — a separate, opt-in bundle (vitops({ editor: true })).
  It is tooling, not part of the runtime, so it stays out of elements.js and off
  every page that doesn't ask for it. Loads independently of `webComponents`:
  <wc-theme-editor> registers itself and pulls in no framework element.
*/}
{editor && <script is:inline type="module" src={`${wc}/editor.js`}></script>}
