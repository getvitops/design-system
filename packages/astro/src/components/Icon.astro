---
/**
 * One icon, resolved through the site's semantic map.
 *
 * `name` is a semantic name ('menu', 'chevron-down') that resolves per the
 * configured set, OR a fully-qualified `prefix:name` which passes straight
 * through — that is the escape hatch for a glyph the map doesn't cover.
 *
 * **Why this doesn't use astro-icon.** It can't. astro-icon's `./components`
 * entry is a TypeScript file that Vite has to transform, so it is only reachable
 * through a statically-analysable import — and a *static* import is precisely
 * what made the optional peer mandatory for anyone rendering Popover, Details or
 * Drawer, which is the bug this component exists to fix. A dynamic
 * `import(/* @vite-ignore *\/ …)` compiles nothing and hands Node raw TS, which
 * fails silently and renders an empty box. So the glyph is read straight out of
 * the `@iconify-json/*` collection instead — the same loader the sprite emitter
 * uses, so both delivery paths draw the identical icon and neither needs a peer.
 *
 * Two other things worth knowing:
 *
 * - **An unresolvable name warns, it doesn't throw.** A missing glyph must never
 *   500 an SSR page; the box renders empty and the build log says which name.
 *   `vitops icons` is the place that fails hard.
 * - **`.icon` already does the layout.** It's an inline-flex box sized in `em`
 *   (`--icon-size`) that stretches its `<svg>` child and sets `fill:
 *   currentColor`. So a start/end adornment on `.cta`/`.btn` — both already
 *   `inline-flex` with a `gap` — is a matter of child order, not a new class.
 *   Don't confuse this with `.icon-mask`, the CSS-only adornment path (see
 *   `.link--icon::before` in anchor-link.css).
 */
import { loadIconSvg, spriteId } from '@getvitops/generator';
import { resolveIcon } from '@getvitops/utils';
import icons from 'virtual:getvitops/icons';

interface Props {
  /** Semantic name ('menu') or fully-qualified ('ph:list'). */
  name: string;
  /** Resolve against the brand set rather than the UI set. */
  brand?: boolean;
  /** Any CSS length; sets `--icon-size`. Defaults to the framework's 1.25em. */
  size?: string;
  /**
   * Accessible name. Omit for decorative icons — the default — which are then
   * `aria-hidden`. An icon that carries meaning on its own needs this.
   */
  label?: string;
  class?: string;
}

const { name, brand = false, size, label, class: className } = Astro.props;

const set = brand ? icons.brand : icons.ui;
const aliased = icons.overrides[name] ?? name;

let qualified: string | null = null;
try {
  qualified = resolveIcon(aliased, set, { weight: icons.weight ?? undefined });
} catch {
  // A bare name that isn't in the map is legitimate — a sprite id, or a local
  // SVG — so fall through with what we were given rather than giving up.
  qualified = aliased.includes(':') ? aliased : null;
}

let svg: { viewBox: string; body: string } | null = null;
if (icons.engine === 'inline' && qualified) {
  // resolveFrom is the project root, not process.cwd() — see IconsData.root.
  svg = await loadIconSvg(qualified, { resolveFrom: icons.root });
  if (!svg)
    console.warn(
      `[vitops] <Icon name="${name}"> — "${qualified}" not found. Is ` +
        `@iconify-json/${qualified.slice(0, qualified.indexOf(':'))} installed?`,
    );
} else if (icons.engine === 'none') {
  console.warn(
    `[vitops] <Icon name="${name}"> rendered but icons are not configured. ` +
      'Add `icons: true` to vitops() in astro.config.',
  );
}

const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
const style = size ? `--icon-size:${size}` : undefined;
---

<span class:list={['icon', className]} style={style} {...a11y}>
  {
    svg ? (
      <svg viewBox={svg.viewBox} set:html={svg.body} />
    ) : icons.engine === 'sprite' && icons.sprite && qualified ? (
      <svg>
        <use href={`${icons.sprite}#${spriteId(qualified)}`} />
      </svg>
    ) : null
  }
</span>
