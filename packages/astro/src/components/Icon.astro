---
/**
 * One icon, resolved through the site's semantic map.
 *
 * `name` is a semantic name ('menu', 'expand-more') that resolves per the
 * configured set, OR a fully-qualified `prefix:name` which passes straight
 * through — that is the escape hatch for a glyph the map doesn't cover.
 *
 * Three things worth knowing:
 *
 * - **The engine is imported dynamically.** A static `import { Icon } from
 *   'astro-icon/components'` is what made Popover/Details/Drawer hard-fail for
 *   consumers who hadn't installed the optional peer — the module was resolved
 *   whether or not the icon was ever rendered.
 * - **An unresolvable name warns, it doesn't throw.** A missing glyph must never
 *   500 an SSR page; the box renders empty and the build log says which name and
 *   where. `vitops icons` is the place that fails hard.
 * - **`.icon` already does the layout.** It's an inline-flex box sized in `em`
 *   (`--icon-size`) that stretches its `<svg>` child and sets `fill:
 *   currentColor`. So a start/end adornment on `.cta`/`.btn` — both already
 *   `inline-flex` with a `gap` — is a matter of child order, not a new class.
 *   Don't confuse this with `.icon-mask`, which is the CSS-only adornment path
 *   (see `.link--icon::before` in anchor-link.css).
 */
import { resolveIcon } from '@getvitops/utils';
import icons from 'virtual:getvitops/icons';

interface Props {
  /** Semantic name ('menu') or fully-qualified ('ph:list'). */
  name: string;
  /** Resolve against the brand set rather than the UI set. */
  brand?: boolean;
  /** Any CSS length; sets `--icon-size`. Defaults to the framework's 1.25em. */
  size?: string;
  /**
   * Accessible name. Omit for decorative icons — the default — which are then
   * `aria-hidden`. An icon that carries meaning on its own needs this.
   */
  label?: string;
  class?: string;
}

const { name, brand = false, size, label, class: className } = Astro.props;

const set = brand ? icons.brand : icons.ui;
const aliased = icons.overrides[name] ?? name;

let resolved: string | null = null;
try {
  resolved = resolveIcon(aliased, set, { weight: icons.weight ?? undefined });
} catch {
  // Bare names that aren't in the map are legitimate for astro-icon (it reads
  // src/icons/*.svg by bare name), so only a *qualified*-looking miss is worth
  // shouting about. Either way we hand the raw name to the engine and let it try.
  resolved = aliased.includes(':') ? aliased : null;
}

/** `ph:caret-down` → `ph--caret-down`. Must match the generator's spriteId(). */
const spriteId = (q: string) => q.replace(':', '--');

const engine = icons.engine;
const forEngine = resolved ?? aliased;

// Dynamic so an uninstalled optional peer costs nothing.
let Rendered: unknown = null;
if (engine === 'astro-icon' || engine === 'astro-iconset') {
  try {
    const mod = await import(/* @vite-ignore */ `${engine}/components`);
    Rendered = mod.Icon;
  } catch {
    console.warn(
      `[getvitops] <Icon name="${name}">: ${engine} is configured but its components entry ` +
        `could not be loaded. Rendering an empty icon box.`,
    );
  }
} else if (engine === 'none') {
  console.warn(
    `[getvitops] <Icon name="${name}"> rendered but icons are not configured. ` +
      'Add `icons: true` to getvitops() in astro.config.',
  );
}

const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
const style = size ? `--icon-size:${size}` : undefined;
const Tag = Rendered as never;
---

<span class:list={['icon', className]} style={style} {...a11y}>
  {
    Rendered ? (
      <Tag name={forEngine} />
    ) : engine === 'sprite' && icons.sprite ? (
      <svg><use href={`${icons.sprite}#${spriteId(forEngine)}`} /></svg>
    ) : null
  }
</span>
