---
import { nodesToHtml } from '@getvitops/utils';
import { t } from '@getvitops/utils';
import type { ContentNode, Localizable, Attrs } from '@getvitops/utils';

interface Props {
  nodes: ContentNode[];
  attrs?: Attrs;
  locale?: string;
  defaultLocale?: string;
}

const {
  nodes,
  attrs,
  locale = 'en',
  defaultLocale = 'en',
} = Astro.props;

const resolveText = (value: Localizable) => t(value, locale, defaultLocale);
const htmlString = nodesToHtml(nodes, resolveText);
---

{attrs
  ? <div {...attrs} set:html={htmlString} />
  : <Fragment set:html={htmlString} />
}
