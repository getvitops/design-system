---
import { Icon } from 'astro-icon/components';

interface Item {
  label: string;
  href: string;
  icon?: string;
}

interface Props {
  label: string;
  icon?: string;
  items: Item[];
  class?: string;
  /** Resolve semantic icon names to fully-qualified astro-icon names.
   *  Defaults to pass-through (expects already-qualified names like 'fa7-solid:chevron-down'). */
  iconResolver?: (name: string) => string;
}

const {
  label,
  items,
  class: className,
  iconResolver = (name: string) => name,
} = Astro.props;
---

<details class={`details-collapse ${className || ''}`}>
  <summary class="details-trigger"><slot>
    {label}
    <Icon name={iconResolver('expand-more')} class="details-icon" /></slot>
  </summary>
  <slot name="content" />
</details>

<style>
  .details-collapse {
    --_details-icon-rotate: 180deg;
    border: none;
    padding: 0;
  }

  .details-trigger {
    gap: 0.75rem;
    background: none;
    border: none;
    padding: 0;
    width: 100%;
    text-align: left;
    font-size: inherit;
    font-family: inherit;
    color: inherit;
  }

  .details-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .details-content {
    list-style: none;
    padding-left: 2rem;
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .details-content a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }
</style>
