---
import { Icon } from 'astro-icon/components';

type Attrs = Record<string, string | number | boolean>;

interface Props {
  id: string;
  position?: 'left' | 'right' | 'top' | 'bottom';
  trigger?: {
    label: string;
    icon?: string;
    class?: string;
    attrs?: Attrs;
  };
  attrs?: Attrs;
  class?: string;
  maxWidth?: string;
  maxHeight?: string;
  /** Resolve semantic icon names to fully-qualified astro-icon names.
   *  Defaults to pass-through (expects already-qualified names like 'fa7-solid:bars'). */
  iconResolver?: (name: string) => string;
}

const {
  id,
  position = 'left',
  trigger,
  attrs,
  class: className,
  maxWidth,
  maxHeight,
  iconResolver = (name: string) => name,
} = Astro.props;

const styleVars = [
  maxWidth && `--drawer-max-inline-size: ${maxWidth}`,
  maxHeight && `--drawer-max-block-size: ${maxHeight}`,
].filter(Boolean).join('; ') || undefined;

const { class: triggerAttrClass, ...triggerRestAttrs } = trigger?.attrs ?? {};
const { class: dialogAttrClass, style: dialogAttrStyle, ...dialogRestAttrs } = attrs ?? {};
---

<slot name="trigger">
  <button
    commandfor={id}
    command="show-modal"
    class:list={[trigger?.class || 'btn', triggerAttrClass]}
    aria-label={trigger?.label || 'Open drawer'}
    {...triggerRestAttrs}
  >
    <span class:list={[trigger?.icon && 'visually-hidden']}>{trigger?.label || 'Open'}</span>
    {trigger?.icon && <Icon name={iconResolver(trigger.icon)} />}
  </button>
</slot>

<dialog
  id={id}
  closedby="any"
  class:list={['drawer', `drawer--${position}`, className, dialogAttrClass]}
  style={[styleVars, dialogAttrStyle].filter(Boolean).join('; ') || undefined}
  {...dialogRestAttrs}
>
  <slot />
</dialog>

<style>
  /* Icon-only triggers keep their label for screen readers. Component-scoped
     rather than the framework's `sr-only`: that one is in the generator's
     TW_CLASH list, so the tailwind format ships no rule for it. */
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
