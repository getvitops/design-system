---
import Icon from './Icon.astro';

type Attrs = Record<string, string | number | boolean>;

interface Props {
  id: string;
  /**
   * The drawer's accessible name, announced when it opens. Defaults to the trigger's label
   * ("Open menu" names the dialog "Open menu", which is why a distinct `label` is better), and
   * one of the two is required: an unnamed modal dialog is announced as just "dialog".
   */
  label?: string;
  /**
   * Accessible name of the built-in close button. Default "Close".
   */
  closeLabel?: string;
  /**
   * Render the built-in close button (default true). A modal needs a visible close control for
   * voice-control users, and for touch users on engines without `closedby`, where there is no Esc
   * key and no light dismiss. Turn it off only when the slotted content carries its own
   * `<button command="close" commandfor="…id…">`.
   */
  closeButton?: boolean;
  position?: 'left' | 'right' | 'top' | 'bottom';
  trigger?: {
    label: string;
    icon?: string;
    class?: string;
    attrs?: Attrs;
  };
  attrs?: Attrs;
  class?: string;
  maxWidth?: string;
  maxHeight?: string;
  /**
   * Map a semantic name onto a fully-qualified one before rendering.
   *
   * @deprecated The `icons` option on `vitops()` now does this centrally, so
   * the site's set is configured once instead of threaded through every call
   * site. Left in place because removing it would break consumers passing one;
   * when omitted, `<Icon />` resolves through the site config.
   */
  iconResolver?: (name: string) => string;
}

const {
  id,
  label,
  closeLabel = 'Close',
  closeButton = true,
  position = 'left',
  trigger,
  attrs,
  class: className,
  maxWidth,
  maxHeight,
  iconResolver = (name: string) => name,
} = Astro.props;

const styleVars =
  [
    maxWidth && `--drawer-max-inline-size: ${maxWidth}`,
    maxHeight && `--drawer-max-block-size: ${maxHeight}`,
  ]
    .filter(Boolean)
    .join('; ') || undefined;

const { class: triggerAttrClass, ...triggerRestAttrs } = trigger?.attrs ?? {};
const { class: dialogAttrClass, style: dialogAttrStyle, ...dialogRestAttrs } = attrs ?? {};
---

<slot name="trigger">
  <button
    commandfor={id}
    command="show-modal"
    class:list={[trigger?.class || 'btn', triggerAttrClass]}
    aria-label={trigger?.label || 'Open drawer'}
    {...triggerRestAttrs}
  >
    <span class:list={[trigger?.icon && 'visually-hidden']}>{trigger?.label || 'Open'}</span>
    {trigger?.icon && <Icon name={iconResolver(trigger.icon)} />}
  </button>
</slot>

<dialog
  id={id}
  closedby="any"
  aria-label={label ?? trigger?.label}
  class:list={['drawer', `drawer--${position}`, className, dialogAttrClass]}
  style={[styleVars, dialogAttrStyle].filter(Boolean).join('; ') || undefined}
  {...dialogRestAttrs}
>
  {closeButton && (
    <button
      type="button"
      class="drawer__close"
      command="close"
      commandfor={id}
      aria-label={closeLabel}
    >
      <Icon name={iconResolver('close')} />
    </button>
  )}
  <slot />
</dialog>

<style>
  /* Icon-only triggers keep their label for screen readers. Component-scoped
     rather than the framework's `sr-only`: that one is in the generator's
     TW_CLASH list, so the tailwind format ships no rule for it. */
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
