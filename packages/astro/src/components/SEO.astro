---
import siteConfig from '#site-config';
import { resolvePrimaryLocation, resolvePrimaryLocationKey, resolveContact } from '../utils/contact';
import { robotsDirective } from '../utils/env';
import { t } from '@getvitops/utils';

export interface Props {
  title?: string;
  siteName?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  locale?: string;
}

const {
  title,
  siteName,
  description = '',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  canonical,
  noindex = false,
  nofollow = false,
  ogType = siteConfig.seo.openGraph.type || 'website',
  article,
  locale = siteConfig.defaultLocale,
} = Astro.props;

// Resolve site name from locale config
const resolvedSiteName = siteName
  || siteConfig.locales[locale as keyof typeof siteConfig.locales]?.name
  || siteConfig.seo.openGraph.siteName;

// Resolve title: use provided or fall back to site name
const resolvedTitle = title || resolvedSiteName;

// Determine robots directive (per-page overrides > per-environment > global default)
const robotsContent = noindex || nofollow
  ? `${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`
  : robotsDirective;

// Get current URL for canonical
const siteBase = Astro.site || `https://${siteConfig.domains.canonical}`;
const currentUrl = canonical || Astro.url.href;
const canonicalUrl = new URL(currentUrl, siteBase).href;

// Open Graph image with fallbacks
const ogImage = image || siteConfig.seo.openGraph.image.url;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href;
const ogImageAlt = imageAlt || siteConfig.seo.openGraph.image.alt;
const ogImageWidth = imageWidth || siteConfig.seo.openGraph.image.width;
const ogImageHeight = imageHeight || siteConfig.seo.openGraph.image.height;

// Twitter card type
const twitterCard = image ? 'summary_large_image' : siteConfig.seo.twitter.card;

// JSON-LD structured data
const isHomePage = new URL(Astro.url.pathname, siteBase).pathname === '/';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: resolvedTitle,
  description,
  url: canonicalUrl,
  inLanguage: locale,
  ...(ogImageUrl && { image: ogImageUrl }),
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: resolvedSiteName,
  url: new URL('/', siteBase).href,
  inLanguage: locale,
};

// Organization + LocalBusiness schemas (homepage only, derived from site.config.yaml)
const locationsRecord = ((siteConfig as any).locations as Record<string, Location>) || {};
const locationEntries = Object.entries(locationsRecord);
const primaryKey = resolvePrimaryLocationKey();
const primaryLocation = resolvePrimaryLocation();
const contact = resolveContact();

const links = siteConfig.links as Record<string, string> | undefined;

const sameAs = links
  ? Object.values(links).filter((v): v is string => typeof v === 'string' && v.length > 0)
  : [];

const siteUrl = new URL('/', siteBase).href;

// Services resolution
const servicesRecord = ((siteConfig as any).services as Record<string, Service>) || {};
const serviceEntries = Object.entries(servicesRecord);
const allOffers = serviceEntries.flatMap(([_, svc]) => svc.offers || []);

// Organization schema (always on homepage)
const orgSchema = resolvedSiteName ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: resolvedSiteName,
  url: siteUrl,
  ...(ogImageUrl && { logo: ogImageUrl, image: ogImageUrl }),
  ...(contact.address?.street && contact.address?.city && contact.address?.country && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: contact.address.street,
      addressLocality: contact.address.city,
      ...(contact.address.province && { addressRegion: contact.address.province }),
      ...(contact.address.postalCode && { postalCode: contact.address.postalCode }),
      addressCountry: contact.address.country,
    },
  }),
  ...(contact.email && { email: `mailto:${contact.email}` }),
  ...(contact.phone && { telephone: contact.phone }),
  ...(contact.name && {
    contactPoint: {
      '@type': 'ContactPoint',
      name: contact.name,
      ...(contact.email && { email: `mailto:${contact.email}` }),
      ...(contact.phone && { telephone: contact.phone }),
    },
  }),
  ...(sameAs.length > 0 && { sameAs }),
  ...(locationEntries.length > 1 && {
    subOrganization: locationEntries.map(([id, loc]) => {
      const slug = t(loc.slug, locale, siteConfig.defaultLocale) || id;
      return {
        '@type': loc.type || 'LocalBusiness',
        '@id': `${siteUrl}${slug}#location`,
        name: t(loc.name, locale, siteConfig.defaultLocale) || resolvedSiteName,
      };
    }),
  }),
} : null;

// Primary LocalBusiness schema (homepage only, single location)
const primaryBusinessSchema = primaryLocation && primaryLocation.address?.street && primaryLocation.address?.city && primaryLocation.address?.country ? {
  '@context': 'https://schema.org',
  '@type': primaryLocation.type || 'LocalBusiness',
  '@id': `${siteUrl}${t(primaryLocation.slug, locale, siteConfig.defaultLocale) || primaryKey}#location`,
  name: t(primaryLocation.name, locale, siteConfig.defaultLocale) || resolvedSiteName,
  ...(primaryLocation.email && { email: `mailto:${primaryLocation.email}` }),
  ...(primaryLocation.phone && { telephone: primaryLocation.phone }),
  ...(ogImageUrl && { image: ogImageUrl }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: primaryLocation.address.street,
    addressLocality: primaryLocation.address.city,
    ...(primaryLocation.address.province && { addressRegion: primaryLocation.address.province }),
    ...(primaryLocation.address.postalCode && { postalCode: primaryLocation.address.postalCode }),
    addressCountry: primaryLocation.address.country,
  },
  ...(primaryLocation.geo?.latitude != null && primaryLocation.geo?.longitude != null && {
    geo: {
      '@type': 'GeoCoordinates',
      latitude: primaryLocation.geo.latitude,
      longitude: primaryLocation.geo.longitude,
    },
  }),
  ...(primaryLocation.priceRange && { priceRange: primaryLocation.priceRange }),
  ...(primaryLocation.description && { description: t(primaryLocation.description, locale, siteConfig.defaultLocale) }),
  ...(primaryLocation.areaServed && { areaServed: primaryLocation.areaServed }),
  ...(primaryLocation.paymentAccepted && { paymentAccepted: primaryLocation.paymentAccepted }),
  ...(primaryLocation.currenciesAccepted && { currenciesAccepted: primaryLocation.currenciesAccepted }),
  ...(primaryLocation.knowsLanguage && { knowsLanguage: primaryLocation.knowsLanguage }),
  ...(serviceEntries.length > 0 && {
    serviceType: serviceEntries.map(([_, svc]) => t(svc.name, locale, siteConfig.defaultLocale)),
  }),
  ...(allOffers.length > 0 && {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Services',
      itemListElement: allOffers.map((offer) => ({
        '@type': 'Offer',
        name: t(offer.name, locale, siteConfig.defaultLocale),
        ...(offer.price && { price: offer.price }),
        ...(offer.priceCurrency && { priceCurrency: offer.priceCurrency }),
        ...(offer.priceSpecification && {
          priceSpecification: {
            '@type': offer.priceSpecification.type || 'PriceSpecification',
            ...(offer.priceSpecification.billingDuration && { billingDuration: offer.priceSpecification.billingDuration }),
          },
        }),
      })),
    },
  }),
  parentOrganization: { '@id': `${siteUrl}#organization` },
} : null;
---

<!-- Primary Meta Tags -->
<meta name="title" content={resolvedTitle} />
<meta name="robots" content={robotsContent} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={resolvedSiteName} />
<meta property="og:locale" content={locale.replace('-', '_')} />

{ogImage && (
  <>
    <meta property="og:image:width" content={ogImageWidth.toString()} />
    <meta property="og:image:height" content={ogImageHeight.toString()} />
  </>
)}

{article && ogType === 'article' && (
  <>
    {article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article.author && <meta property="article:author" content={article.author} />}
    {article.section && <meta property="article:section" content={article.section} />}
    {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{siteConfig.seo.twitter.site && <meta name="twitter:site" content={siteConfig.seo.twitter.site} />}

<!-- Site Verification -->
{siteConfig.seo.googleSiteVerification && (
  <meta name="google-site-verification" content={siteConfig.seo.googleSiteVerification} />
)}
{siteConfig.seo.bingSiteVerification && (
  <meta name="msvalidate.01" content={siteConfig.seo.bingSiteVerification} />
)}

<!-- Alternate Languages -->
{Object.entries(siteConfig.locales).map(([localeCode, localeData]: [string, any]) => (
  <link
    rel="alternate"
    hreflang={localeCode}
    href={new URL(localeData.basePath || '/', Astro.site || `https://${siteConfig.domains.canonical}`).href}
  />
))}

<!-- Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{isHomePage && <script is:inline type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />}
{isHomePage && orgSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
{isHomePage && primaryBusinessSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(primaryBusinessSchema)} />
)}
