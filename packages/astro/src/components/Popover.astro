---
import Icon from './Icon.astro';

interface Props {
  id: string;
  trigger?: {
    label: string;
    icon?: string;
    class?: string;
    attrs?: Record<string, string | number | boolean>;
  };
  type?: 'auto' | 'manual';
  as?: 'div' | 'dialog';
  class?: string;
  anchorName?: string;
  positionArea?: string;
  /**
   * Map a semantic name onto a fully-qualified one before rendering.
   *
   * @deprecated The `icons` option on `getvitops()` now does this centrally, so
   * the site's set is configured once instead of threaded through every call
   * site. Left in place because removing it would break consumers passing one;
   * when omitted, `<Icon />` resolves through the site config.
   */
  iconResolver?: (name: string) => string;
}

const {
  id,
  trigger,
  type = 'auto',
  as: Element = 'div',
  class: className,
  anchorName,
  positionArea = 'block-end center',
  iconResolver = (name: string) => name,
} = Astro.props;

const styles = anchorName
  ? `position-anchor: --${anchorName}; position-area: ${positionArea}`
  : undefined;

const anchorStyles = anchorName ? `anchor-name: --${anchorName}` : undefined;

const { class: triggerAttrClass, ...triggerRestAttrs } = trigger?.attrs ?? {};
---

{/* Trigger button - slot with default fallback */}
<slot name="trigger">
  <button
    popovertarget={id}
    class:list={['popover-trigger', trigger?.class, triggerAttrClass]}
    style={anchorStyles}
    aria-label={trigger?.label || 'Open'}
    {...triggerRestAttrs}
  >
  <span class:list={[trigger?.icon && 'visually-hidden']}>{trigger?.label || 'Open'}</span>
    {trigger?.icon && <Icon name={iconResolver(trigger.icon)} />}
  </button>
</slot>


<Element
  id={id}
  popover={type}
  class:list={["popover", className]}
  style={styles}
>
  <slot />
</Element>

<style>
  .popover {
    margin: 0;
    inset: auto;
    border: none;
    padding: 0;
  }

  .popover[popover]::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .popover-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: inherit;
    font-family: inherit;
    color: inherit;
  }

  /* Icon-only triggers keep their label for screen readers. Component-scoped
     rather than the framework's `sr-only`: that one is in the generator's
     TW_CLASH list, so the tailwind format ships no rule for it. */
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
