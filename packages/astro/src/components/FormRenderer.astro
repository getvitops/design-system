---
import { t } from '@getvitops/utils';
import siteConfig from '#site-config';

interface Props {
  type: 'form';
  action: string;
  method?: 'GET' | 'POST';
  fields: FormField[];
  present?: PresentationType;
  attrs?: Attrs;
  submit?: { label: Localizable; attrs?: Attrs };
  honeypot?: boolean;
  locale?: string;
  defaultLocale?: string;
  [key: string]: any;
}

const {
  action,
  method = 'POST',
  fields,
  present,
  attrs,
  submit,
  honeypot = false,
  locale = siteConfig.defaultLocale,
  defaultLocale = siteConfig.defaultLocale,
} = Astro.props;

const resolve = (value: Localizable | undefined) => t(value, locale, defaultLocale);
const presentAs = present?.as ?? 'stacked';
const turnstileSiteKey = (siteConfig as any).security?.turnstile?.siteKey as string | undefined;

/** Parse validation rule strings into native HTML attributes */
function validationToAttrs(validation?: string): Record<string, string | number> {
  if (!validation) return {};
  const attrs: Record<string, string | number> = {};
  for (const rule of validation.split('|')) {
    const [key, val] = rule.split(':');
    if (key === 'min' && val) attrs.minlength = Number(val);
    if (key === 'max' && val) attrs.maxlength = Number(val);
    if (key === 'phone') attrs.pattern = '[\\d\\s\\-\\+\\(\\)]+';
  }
  return attrs;
}

/** Resolve field options: arrays pass through, strings look up a named config record */
function resolveOptions(options: FormField['options']): (string | { label: Localizable; value: string })[] | undefined {
  if (!options) return undefined;
  if (Array.isArray(options)) return options;
  const record = (siteConfig as any)[options] as Record<string, { name: Localizable }> | undefined;
  if (!record) return undefined;
  return Object.entries(record).map(([id, entry]) => ({
    label: entry.name,
    value: id,
  }));
}
---

<form
  action={action}
  method={method}
  class:list={[`form form--${presentAs}`, attrs?.class]}
  {...(attrs ? Object.fromEntries(Object.entries(attrs).filter(([k]) => k !== 'class')) : {})}
>
  {honeypot && (
    <div aria-hidden="true" style="position:absolute;left:-9999px">
      <label for="website">Do not fill this in</label>
      <input type="text" name="website" id="website" tabindex="-1" autocomplete="off" />
    </div>
  )}

  {fields.map((field) => (
    <div class:list={['form-field', { required: field.required }]}>
      <label for={field.name}>
        {resolve(field.label)}
        {field.required && <span class="required-mark" aria-hidden="true">*</span>}
      </label>

      {field.type === 'textarea' ? (
        <textarea
          id={field.name}
          name={field.name}
          required={field.required}
          data-validation={field.validation}
          {...validationToAttrs(field.validation)}
          {...(field.attrs ?? {})}
        />
      ) : field.type === 'select' ? (
        <select
          id={field.name}
          name={field.name}
          required={field.required}
          {...(field.attrs ?? {})}
        >
          <option value="">Select an option</option>
          {resolveOptions(field.options)?.map((opt) => (
            typeof opt === 'string'
              ? <option value={opt}>{opt}</option>
              : <option value={opt.value}>{resolve(opt.label)}</option>
          ))}
        </select>
      ) : (
        <input
          type={field.type}
          id={field.name}
          name={field.name}
          required={field.required}
          data-validation={field.validation}
          {...validationToAttrs(field.validation)}
          {...(field.attrs ?? {})}
        />
      )}
    </div>
  ))}

  {turnstileSiteKey && (
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
  )}

  <button
    type="submit"
    class:list={[submit?.attrs?.class ?? 'cta']}
    {...(submit?.attrs ? Object.fromEntries(Object.entries(submit.attrs).filter(([k]) => k !== 'class')) : {})}
  >
    {resolve(submit?.label) || 'Submit'}
  </button>
</form>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script src="../scripts/form-enhance.ts"></script>

<script is:inline>
  // Show feedback after no-JS form redirect (?form=success|error)
  (function () {
    var p = new URLSearchParams(location.search);
    var status = p.get('form');
    if (!status || (status !== 'success' && status !== 'error')) return;
    var form = document.querySelector('form[action*="/api/"]');
    if (!form) return;
    var msg = document.createElement('div');
    msg.className = status === 'success' ? 'form-success' : 'form-error';
    msg.setAttribute('role', status === 'error' ? 'alert' : 'status');
    msg.textContent = status === 'success'
      ? 'Thank you! We will be in touch soon.'
      : 'Something went wrong. Please try again.';
    form.parentNode.insertBefore(msg, form);
    if (status === 'success') form.style.display = 'none';
    p.delete('form');
    var qs = p.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
  })();
</script>
