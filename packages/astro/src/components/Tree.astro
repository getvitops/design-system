---
/**
 * An accessible disclosure tree, progressively enhanced.
 *
 * Tier-3 in the framework's terms — an authoring convenience that emits the right
 * `.tree` markup and requires **no runtime JS**. What it renders is the whole
 * content, and it stands on its own:
 *
 *   - structure is real `<ul>`/`<li>` nesting, so assistive tech announces list
 *     position and depth. A `<div>` soup looks identical and tells a screen-reader
 *     user nothing about where they are;
 *   - every branch is a native `<details>`/`<summary>`, so expanded state and
 *     keyboard operation come from the platform with no JS at all. This
 *     fallback carries no `role="tree"` and no `aria-expanded` bookkeeping —
 *     those aren't hand-rolled into markup that would be silently wrong the
 *     instant JS failed to load; `<wc-tree>` applies them on upgrade, over a
 *     DOM it unwraps for the purpose (branches lose their `<details>`/
 *     `<summary>` entirely — see that element's own docblock for why and how);
 *   - nodes carry ids, so any node is linkable without JS.
 *
 * **This component emits its own `<wc-tree>`** — do NOT wrap it in one. That is the
 * tier-3 rule ("the wrapper emits its `<wc-*>` tag with the accessible fallback
 * inside"), and `CookieConsent.astro` does the same with `<wc-consent>`.
 * `<wc-tree><Tree /></wc-tree>` nests two elements binding the same tree; the
 * element now defers to an enclosing one, so it degrades to a no-op rather than two
 * duelling toolbars, but the single call is the intended shape.
 *
 * `<wc-tree>` upgrades it with WAI-ARIA tree semantics, roving-tabindex keyboard
 * navigation, filter, expand/collapse-all and hash deep-linking. If that never
 * loads, the fallback above — native nested `<details>`, Tab-and-Enter — is all
 * that remains, which is why `enhance={false}` is a supported way to get the
 * bare fragment on its own.
 */
import type { TreeItem } from './tree.ts';
import TreeNode from './TreeNode.astro';

interface Props {
  items: TreeItem[];
  /** Placeholder + aria-label for the filter `<wc-tree>` generates. */
  label?: string;
  /** Accessible name for the list itself. */
  ariaLabel?: string;
  /** Branches shallower than this render open. 0 = everything closed. */
  openDepth?: number;
  /**
   * Emit the `<wc-tree>` wrapper (default `true`).
   *
   * Set false when the fragment is going somewhere the element cannot run or is
   * unwanted — an email, a PDF, a server-rendered block on a page that doesn't load
   * `elements.js`. The tree itself is unchanged; only the enhancement layer is
   * omitted, so nothing is lost but filter/expand-all/deep-link.
   */
  enhance?: boolean;
}
const {
  items,
  label = 'Filter',
  ariaLabel,
  openDepth = 0,
  enhance = true,
  // Anything else is passed through to `<wc-tree>`, so the element can grow
  // attributes without this component's prop surface tracking them.
  ...rest
} = Astro.props;
---

{/* One `<ul>`, rendered once, wrapped or not — duplicating the tree markup per
    branch is how the two paths would drift. */}
<Fragment>
  {
    enhance ? (
      <wc-tree label={label} {...rest}>
        <ul class="tree tree--lines" role="list" aria-label={ariaLabel}>
          {items.map((item) => (
            <TreeNode item={item} depth={0} openDepth={openDepth} />
          ))}
        </ul>
      </wc-tree>
    ) : (
      <ul class="tree tree--lines" role="list" aria-label={ariaLabel}>
        {items.map((item) => (
          <TreeNode item={item} depth={0} openDepth={openDepth} />
        ))}
      </ul>
    )
  }
</Fragment>
