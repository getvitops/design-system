---
import { Icon } from 'astro-icon/components';
import { icon } from '../utils/icon-resolver';
import siteConfig from '#site-config';
import { resolveContact } from '../utils/contact';

interface Props {
  locale?: string;
  class?: string;
}

const { locale = siteConfig.defaultLocale, class: className } = Astro.props;
const siteName = siteConfig.locales[locale as keyof typeof siteConfig.locales].name;
const { email, phone } = resolveContact();
const year = new Date().getFullYear();

const legal = (siteConfig as any).legal as Record<string, any> | undefined;
const legalLinks = legal
  ? Object.entries(legal)
      .filter(([_, val]) => val && typeof val === 'object' && val.enabled && val.url)
      .map(([key, val]) => ({
        label: key.replace(/([A-Z])/g, ' $1').trim().replace(/\b\w/g, (c: string) => c.toUpperCase()),
        href: val.url as string,
      }))
  : [];
---

<div class:list={['text-center text-sm', className]}>
  <hr />
  <div class="flex flex-col items-center gap-2 py-4 @md:flex-row @md:justify-center @md:gap-6 flex-wrap">
    {(email || phone) && (
      <address class="flex items-center gap-4 not-italic">
        {email && (
          <a href={`mailto:${email}`} class="flex items-center gap-1">
            <Icon name={icon('email')} class="inline-block" style="width: 1em; height: 1em;" />
            <span>{email}</span>
          </a>
        )}
        {phone && (
          <a href={`tel:${phone}`} class="flex items-center gap-1">
            <Icon name={icon('phone')} class="inline-block" style="width: 1em; height: 1em;" />
            <span>{phone}</span>
          </a>
        )}
      </address>
    )}

    {legalLinks.length > 0 && (
      <nav aria-label="Legal" class="flex items-center gap-2">
        {legalLinks.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true">&middot;</span>}
            <a href={link.href}>{link.label}</a>
          </>
        ))}
      </nav>
    )}

    <p>
      &copy;<span data-current-year>{year}</span> {siteName} | Made with &hearts; by <a href="https://monad.media">Monad</a>
    </p>
  </div>
</div>
