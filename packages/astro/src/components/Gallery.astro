---
/**
 * A `.gallery` thumbnail grid whose triggers open a single `.lightbox-dialog`
 * wrapping a `<Carousel />` of every image — a fully working modal lightbox with
 * zero JavaScript.
 *
 * Tier-3 in the framework's terms — an authoring convenience that emits the right
 * `.gallery` / `.lightbox-dialog` markup and needs no runtime JS to be usable:
 *
 *   - each thumbnail is a real `<a href="#slide-id">` into the carousel's own
 *     `<li id="slide-id">`, so following it is ordinary fragment navigation —
 *     no Invoker Commands, no polyfill, in every engine;
 *   - `:has(:target)` in `patterns/lightbox.css` is what reveals the dialog once
 *     that navigation lands, and the browser's own fragment scroll puts the
 *     carousel on the right slide;
 *   - prev/next, dots, arrow keys and swipe are the carousel's — reused, not
 *     re-implemented, and already dual-path (native `::scroll-button()` /
 *     `::scroll-marker` where the engine has them, real fallback buttons where
 *     it doesn't).
 *
 * **This component emits its own `<wc-gallery>`, wrapping its own `<Carousel />`
 * (which emits its own `<wc-carousel>`)** — do NOT wrap either in one yourself.
 * That is the tier-3 rule ("the wrapper emits its `<wc-*>` tag with the
 * accessible fallback inside"). `<wc-gallery>` only intercepts a trigger click to
 * `showModal()` the dialog and run the thumbnail → full-image view-transition
 * morph; it does not step between slides — the nested `<wc-carousel>` does that,
 * and if it never loads, the dialog is still a plain scroll-snap strip.
 *
 * `enhance={false}` on `<Gallery />` still emits a real, working carousel inside
 * the dialog (`enhance` is passed through) — the fallback here is not a stripped
 * lightbox, it is a genuine one, because a scroll-snap carousel needs no
 * `<wc-gallery>` at all to already have prev/next.
 *
 * Images take `string | ImageMetadata` via `<ResponsiveImage />`: a plain string
 * renders a raw `<img>` (unchanged from before `ImageMetadata` support existed);
 * an `astro:assets` import renders through `<Picture />` for AVIF/WebP
 * derivatives. `formats` is passed straight through, including a value
 * astro:assets doesn't recognise yet — see `ResponsiveImage.astro`'s docblock for
 * why (no hard-coded closed format union).
 */
import type { HTMLAttributes } from 'astro/types';
import Carousel from './Carousel.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import type { ImageFormat } from './ResponsiveImage.astro';

export interface GalleryImage {
  /** Full-size image, shown in the dialog. */
  src: string | ImageMetadata;
  /** Thumbnail. Defaults to `src` — for an `ImageMetadata` source, rendered at `thumbWidth`. */
  thumb?: string | ImageMetadata;
  /** Pixel width to request for the thumbnail derivative when `src`/`thumb` is `ImageMetadata`. */
  thumbWidth?: number;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  /** Only meaningful when `src` is a plain string — see `ResponsiveImage.astro`. */
  srcset?: string;
  sizes?: string;
}

export interface Props extends Omit<HTMLAttributes<'div'>, 'slot'> {
  /** Accessible name for the grid, and for the dialog it opens. Required. */
  label: string;
  images?: GalleryImage[];
  /** Passed to every `<Picture formats>`. Default `['avif', 'webp']`. */
  formats?: ImageFormat[];
  /** `--gallery-thumb-size` — minimum thumbnail track width. Default `150px`. */
  thumbSize?: string;
  /** `--gallery-gap`. Default `0.5rem`. */
  gap?: string;
  /** `--gallery-aspect` — every thumbnail's box ratio. Default `1`. */
  aspect?: string;
  /** Wrap prev/next past the ends instead of stopping there. Passed to `<Carousel loop>`. */
  loop?: boolean;
  /**
   * Emit the `<wc-gallery>` wrapper (default `true`). Also controls `<Carousel
   * enhance>` — set false where no runtime JS will ever load at all (an email, a
   * PDF); the dialog still opens via `:target` and the carousel is still a real,
   * scroll-snapping strip, just without the morph, autoplay-adjacent polish, or
   * (outside Chromium today) prev/next buttons.
   */
  enhance?: boolean;
  /**
   * Id prefix for the dialog and slide ids. Defaults to a slug of `label`. Astro
   * has no `useId`, and a random one would change on every build — so this is
   * derived, deterministic and overridable when two galleries on a page share a
   * label.
   */
  id?: string;
}

const {
  label,
  images = [],
  formats = ['avif', 'webp'],
  thumbSize,
  gap,
  aspect,
  loop = false,
  enhance = true,
  id,
  class: className,
  role,
  style,
  ...rest
} = Astro.props;

const uid =
  id ??
  `gallery-${
    label
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'x'
  }`;

const vars = [
  thumbSize ? `--gallery-thumb-size:${thumbSize}` : '',
  gap ? `--gallery-gap:${gap}` : '',
  aspect ? `--gallery-aspect:${aspect}` : '',
  style ?? '',
]
  .filter(Boolean)
  .join(';');

const Shell = enhance ? 'wc-gallery' : 'div';
---

<Shell
  class:list={['gallery-shell', className]}
  role={role ?? 'group'}
  aria-label={label}
  style={vars}
  {...rest}
>
  <ul class="gallery" role="list">
    {
      images.map((img, i) => {
        const thumb = img.thumb ?? img.src;
        return (
          <li class="gallery__item">
            <a class="gallery__trigger" href={`#${uid}-img-${i}`}>
              <ResponsiveImage
                src={thumb}
                alt={img.alt}
                formats={formats}
                class="gallery__thumb"
                width={typeof thumb === 'string' ? undefined : (img.thumbWidth ?? 400)}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                decoding={i === 0 ? undefined : 'async'}
              />
              <span class="visually-hidden">View full size</span>
            </a>
          </li>
        );
      })
    }
    <slot />
  </ul>
  <dialog id={uid} class="lightbox-dialog" closedby="any" aria-label={label}>
    <Carousel
      id={`${uid}-track`}
      label={label}
      class="lightbox-dialog__track"
      enhance={enhance}
      loop={loop}
      hint={false}
    >
      {
        images.map((img, i) => {
          const thumb = img.thumb ?? img.src;
          // A per-slide placeholder: whatever's already on screen (the
          // thumbnail) stays painted in `.carousel__media`'s background until
          // the full image finishes loading, so the view-transition morph
          // never has an empty box as its target — see lightbox.css.
          const placeholder = typeof thumb === 'string' ? `--lightbox-placeholder:url(${JSON.stringify(thumb)})` : '';
          return (
            <li class="carousel__slide" id={`${uid}-img-${i}`}>
              <figure class="carousel__media" style={placeholder}>
                <ResponsiveImage
                  src={img.src}
                  alt={img.alt}
                  formats={formats}
                  width={img.width}
                  height={img.height}
                  srcset={img.srcset}
                  sizes={img.sizes}
                  loading="lazy"
                />
                {img.caption && <figcaption class="carousel__caption font-caption">{img.caption}</figcaption>}
              </figure>
            </li>
          );
        })
      }
    </Carousel>
    <a class="lightbox-dialog__close" href="#" aria-label="Close">&times;</a>
  </dialog>
</Shell>

<style>
  /* Icon-only trigger keeps its label for screen readers. Component-scoped
     rather than the framework's `sr-only`: that one is in the generator's
     TW_CLASH list, so the tailwind format ships no rule for it. */
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
