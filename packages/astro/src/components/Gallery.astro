---
/**
 * A `.gallery` thumbnail grid whose triggers open per-image `.lightbox-dialog`s —
 * a fully working modal lightbox with zero JavaScript.
 *
 * Tier-3 in the framework's terms — an authoring convenience that emits the right
 * `.gallery` / `.lightbox-dialog` markup and needs no runtime JS to be usable:
 *
 *   - each thumbnail is a real `command="show-modal" commandfor="…"` invoker
 *     button for its own `<dialog>`, so open and close both work with the
 *     Invoker Commands API alone (universal via `@getvitops/core/polyfills`);
 *   - the dialogs are real `<dialog closedby="any">`, so Escape and a backdrop
 *     click close them with no script either;
 *   - what's missing without JS is prev/next — deliberately, because a
 *     `command="show-modal"` button inside an already-open dialog would stack a
 *     second modal on top rather than replace the first. That control is
 *     generated by `<wc-gallery>`, never authored, the same rule `<wc-tree>`'s
 *     search field follows: a control that does nothing is worse than none.
 *
 * **This component emits its own `<wc-gallery>`** — do NOT wrap it in one. That
 * is the tier-3 rule ("the wrapper emits its `<wc-*>` tag with the accessible
 * fallback inside"), and `Cards.astro`, `Carousel.astro` and `Tree.astro` all do
 * the same. The element defers to an enclosing one, so a nested pair degrades to
 * a no-op rather than double-enhancing, but the single call is the intended shape.
 *
 * `<wc-gallery>` adds prev/next, arrow keys, swipe, an image counter, neighbour
 * preload and a thumbnail → full-image view-transition morph. If it never loads,
 * that enhancement is all that's missing — set `enhance={false}` for the bare
 * fragment (an email, a PDF, a page that doesn't load `elements.js`).
 *
 * Images take `string | ImageMetadata` via `<ResponsiveImage />`: a plain string
 * renders a raw `<img>` (unchanged from before `ImageMetadata` support existed);
 * an `astro:assets` import renders through `<Picture />` for AVIF/WebP
 * derivatives. `formats` is passed straight through, including a value
 * astro:assets doesn't recognise yet — see `ResponsiveImage.astro`'s docblock for
 * why (no hard-coded closed format union).
 */
import type { HTMLAttributes } from 'astro/types';
import ResponsiveImage from './ResponsiveImage.astro';
import type { ImageFormat } from './ResponsiveImage.astro';

export interface GalleryImage {
  /** Full-size image, shown in the dialog. */
  src: string | ImageMetadata;
  /** Thumbnail. Defaults to `src` — for an `ImageMetadata` source, rendered at `thumbWidth`. */
  thumb?: string | ImageMetadata;
  /** Pixel width to request for the thumbnail derivative when `src`/`thumb` is `ImageMetadata`. */
  thumbWidth?: number;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  /** Only meaningful when `src` is a plain string — see `ResponsiveImage.astro`. */
  srcset?: string;
  sizes?: string;
}

export interface Props extends Omit<HTMLAttributes<'div'>, 'slot'> {
  /** Accessible name for the grid. Required — an unnamed group is unfindable. */
  label: string;
  images?: GalleryImage[];
  /** Passed to every `<Picture formats>`. Default `['avif', 'webp']`. */
  formats?: ImageFormat[];
  /** `--gallery-thumb-size` — minimum thumbnail track width. Default `150px`. */
  thumbSize?: string;
  /** `--gallery-gap`. Default `0.5rem`. */
  gap?: string;
  /** `--gallery-aspect` — every thumbnail's box ratio. Default `1`. */
  aspect?: string;
  /** Wrap prev/next past the ends instead of stopping there. */
  loop?: boolean;
  /**
   * Emit the `<wc-gallery>` wrapper (default `true`).
   *
   * Set false where the element cannot run — an email, a PDF, a page that does
   * not load `elements.js`. The gallery is unchanged; only the enhancement
   * layer goes, so nothing is lost but prev/next, swipe, the counter and the
   * view-transition morph.
   */
  enhance?: boolean;
  /**
   * Id prefix for the dialog ids. Defaults to a slug of `label`. Astro has no
   * `useId`, and a random one would change on every build — so this is derived,
   * deterministic and overridable when two galleries on a page share a label.
   */
  id?: string;
}

const {
  label,
  images = [],
  formats = ['avif', 'webp'],
  thumbSize,
  gap,
  aspect,
  loop = false,
  enhance = true,
  id,
  class: className,
  role,
  style,
  ...rest
} = Astro.props;

const uid =
  id ??
  `gallery-${
    label
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'x'
  }`;

const vars = [
  thumbSize ? `--gallery-thumb-size:${thumbSize}` : '',
  gap ? `--gallery-gap:${gap}` : '',
  aspect ? `--gallery-aspect:${aspect}` : '',
  style ?? '',
]
  .filter(Boolean)
  .join(';');

const Shell = enhance ? 'wc-gallery' : 'div';
---

<Shell
  class:list={['gallery-shell', className]}
  role={role ?? 'group'}
  aria-label={label}
  loop={enhance && loop ? '' : undefined}
  style={vars}
  {...rest}
>
  <ul class="gallery" role="list">
    {
      images.map((img, i) => {
        const thumb = img.thumb ?? img.src;
        return (
          <li class="gallery__item">
            <button
              class="gallery__trigger"
              type="button"
              command="show-modal"
              commandfor={`${uid}-img-${i}`}
            >
              <ResponsiveImage
                src={thumb}
                alt={img.alt}
                formats={formats}
                class="gallery__thumb"
                width={typeof thumb === 'string' ? undefined : (img.thumbWidth ?? 400)}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                decoding={i === 0 ? undefined : 'async'}
              />
              <span class="visually-hidden">View full size</span>
            </button>
          </li>
        );
      })
    }
    <slot />
  </ul>
  {
    images.map((img, i) => (
      <dialog id={`${uid}-img-${i}`} class="lightbox-dialog" closedby="any" aria-label={img.alt}>
        <div class="lightbox-dialog__content">
          <ResponsiveImage
            src={img.src}
            alt={img.alt}
            formats={formats}
            class="lightbox-dialog__image"
            width={img.width}
            height={img.height}
            srcset={img.srcset}
            sizes={img.sizes}
            loading="lazy"
          />
          {img.caption && <p class="lightbox-dialog__caption font-caption">{img.caption}</p>}
        </div>
        <button
          class="lightbox-dialog__close"
          type="button"
          command="close"
          commandfor={`${uid}-img-${i}`}
          aria-label="Close"
        >
          &times;
        </button>
      </dialog>
    ))
  }
</Shell>

<style>
  /* Icon-only trigger keeps its label for screen readers. Component-scoped
     rather than the framework's `sr-only`: that one is in the generator's
     TW_CLASH list, so the tailwind format ships no rule for it. */
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
