---
/**
 * One node of a `<Tree />`, recursing through `Astro.self`.
 *
 * Two shapes, and the choice is semantic rather than cosmetic:
 *
 *   - a **branch** wraps its label in `<details>`/`<summary>` — a native
 *     disclosure button, so expanded state is announced and keyboard operation
 *     is free with no JS. The child `<ul>` lives inside the `<details>`, which
 *     is what makes it collapse with no JS.
 *   - a **leaf** is a plain `.tree__content` row. A `<details>` with nothing to
 *     disclose would still render a control and announce as collapsible.
 *
 * That description is the NO-JS contract only. `<wc-tree>` unwraps every
 * branch's `<details>`/`<summary>` on upgrade — see its own docblock — so once
 * it loads, "keyboard operation is free" stops meaning native Tab-and-Enter and
 * starts meaning that element's roving-tabindex arrow-key navigation instead,
 * and `role="treeitem"`/`role="group"` replace the `<li>`'s and `<ul>`'s
 * implicit `listitem`/`list` roles. The markup below never changes to reflect
 * that — it's the fallback `<wc-tree>` reads and transforms, not two things to
 * keep in sync.
 *
 * The item class sits on the `<li>` in both cases, so `<wc-tree>`'s filter treats
 * leaves and branches as one kind of thing and hiding one hides its whole row —
 * true before and after upgrade, since the transform preserves the class.
 */
import type { TreeItem } from './tree.ts';

interface Props {
  item: TreeItem;
  depth: number;
  /** Branches at a depth below this render open. */
  openDepth: number;
}
const { item, depth, openDepth } = Astro.props;

const kids = item.children ?? [];
const isBranch = kids.length > 0;
---

<li class="tree__item" id={item.id}>
  {
    isBranch ? (
      <details open={depth < openDepth}>
        <summary>
          <span class="tree__toggle" aria-hidden="true" />
          <span class="tree__label">
            {item.unnamed ? <em>{item.label}</em> : <code>{item.label}</code>}
            {item.badge && <span class="badge">{item.badge}</span>}
            {item.flag && <span class="badge badge-danger">{item.flag}</span>}
          </span>
        </summary>
        {item.descriptionHtml && <p class="tree__desc" set:html={item.descriptionHtml} />}
        <ul class="tree" role="list">
          {kids.map((kid) => (
            <Astro.self item={kid} depth={depth + 1} openDepth={openDepth} />
          ))}
        </ul>
      </details>
    ) : (
      <Fragment>
        <span class="tree__content">
          <span class="tree__label">
            {item.unnamed ? <em>{item.label}</em> : <code>{item.label}</code>}
            {item.badge && <span class="badge">{item.badge}</span>}
            {item.flag && <span class="badge badge-danger">{item.flag}</span>}
          </span>
        </span>
        {item.descriptionHtml && <p class="tree__desc" set:html={item.descriptionHtml} />}
      </Fragment>
    )
  }
</li>
