---
/**
 * Cards — a `Subgrid` whose cards are clickable across their whole area, with their
 * text still selectable.
 *
 * **This component emits its own `<wc-cards>`** — do NOT wrap it in one. That is the
 * tier-3 rule ("the wrapper emits its `<wc-*>` tag with the accessible fallback
 * inside"), and `Tree.astro` and `CookieConsent.astro` do the same.
 * `<wc-cards><Cards /></wc-cards>` nests two elements governing the same cards; the
 * inner one defers to the enclosing one so it degrades to a no-op rather than two
 * forwarded clicks, but the single call is the intended shape.
 *
 *   <Cards>
 *     <li class="card subgrid-card">
 *       <p class="font-eyebrow">Service</p>
 *       <p class="font-heading"><a class="link" href="/a">Title</a></p>
 *       <p>Blurb…</p>
 *     </li>
 *   </Cards>
 *
 * The fallback is the card's own link, so with no JS every card is still reachable —
 * only the click-anywhere convenience is missing, and the pointer cursor comes from
 * the element too, so the affordance never appears without the behaviour.
 *
 * **`<Subgrid>` is the unenhanced form**, which is why there is no `enhance={false}`
 * prop: a flag would be a second way to say the same thing. Reach for
 * `.stretched-link` instead when you want whole-card clicking with no JS at all and
 * can accept that the card's text stops being selectable.
 *
 * It no longer parses the slot to add `class="card"`. That was its only job, and it is
 * what forced `Subgrid` to rebuild every child as an `<li>` — see that file. Write the
 * class on the item.
 */
import type { HTMLAttributes } from 'astro/types';
import Subgrid from './Subgrid.astro';

export interface Props extends HTMLAttributes<'ul'> {
  as?: 'ul' | 'ol' | 'div';
  /** Selector for the cards the element governs. Defaults to `.card`. */
  item?: string;
}

const { item, ...rest } = Astro.props;
---

<wc-cards item={item}>
  <Subgrid {...rest}><slot /></Subgrid>
</wc-cards>
