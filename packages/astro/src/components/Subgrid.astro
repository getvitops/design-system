---
/**
 * Subgrid — a grid whose items re-declare the parent's row tracks, so the tranches
 * inside every item (head, body, footer) land on the same row lines no matter how
 * much content each one holds. Every declaration lives in the framework's `subgrid`
 * pattern (patterns/subgrid.css); this file is markup only.
 *
 * **The slot is rendered verbatim — author the items yourself.** This used to parse
 * the slotted HTML and replace each child with an `<li>`, carrying over its class
 * and style. That existed only because a `<ul>` may contain nothing but `<li>`, and
 * it cost more than it bought: the child's tag was discarded, and every attribute
 * had to be copied by hand, so `id`, `data-*` and `aria-*` were silently dropped and
 * `href` could not survive at all. Passing the slot through means there is nothing to
 * copy and nothing to lose.
 *
 *   <Subgrid>
 *     <li class="card subgrid-card">…</li>
 *   </Subgrid>
 *
 * `as` picks the container. It defaults to `ul`, because a set of cards IS a list and
 * that is what tells assistive tech how many there are and where you are among them.
 * Use `as="div"` when the items are genuinely not a list.
 *
 * **`role="list"` is restored automatically for `ul`/`ol`.** `.subgrid` sets
 * `list-style: none`, and that stops Safari + VoiceOver announcing a list at all — so
 * the marker reset silently costs the semantics the `<ul>` was chosen for. Passing
 * your own `role` wins.
 *
 * Size it from the consumer's own CSS, which keeps media-query overrides working:
 * `--subgrid-cols`, `--subgrid-row-span`, `--subgrid-gap`, `--subgrid-row-gap`.
 *
 * For a card whose whole area should be clickable, see `<Cards />` (selectable text,
 * needs JS) or `.stretched-link` (no JS, text not selectable).
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'ul'> {
  /** Container element. `ul`/`ol` also get `role="list"`. */
  as?: 'ul' | 'ol' | 'div';
}

const { as: Tag = 'ul', class: className, role, ...rest } = Astro.props;

// Only lists lose semantics to `list-style: none`, so only lists get the role back.
const listRole = Tag === 'ul' || Tag === 'ol' ? 'list' : undefined;
---

<Tag class:list={['subgrid', className]} role={role ?? listRole} {...rest}>
  <slot />
</Tag>
