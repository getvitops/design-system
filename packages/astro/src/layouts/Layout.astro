---
import '/src/styles/global.css';
import { Font } from 'astro:assets';
import Template from '../components/Template.astro';
import siteConfig from '#site-config';
import { analyticsEnabled } from '../utils/env';
import SEO from '../components/SEO.astro';
import ContentInfo from '../components/ContentInfo.astro';

import type { Props as SEOProps } from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  locale?: string;
  seo?: SEOProps;
}

const { title, description, locale = siteConfig.defaultLocale, seo } = Astro.props;
const siteName = siteConfig.locales[locale as keyof typeof siteConfig.locales].name;

// Determine color-scheme based on theme configuration
const theme = siteConfig.theme as any;
const hasLightTheme = theme.lightTheme !== undefined || theme.defaultColorScheme === 'light';
const hasDarkTheme = theme.darkTheme !== undefined || theme.defaultColorScheme === 'dark';
const colorScheme = hasLightTheme && hasDarkTheme ? 'light dark' : hasLightTheme ? 'light' : hasDarkTheme ? 'dark' : undefined;
const fullTitle = title
  ? (siteConfig.seo as any).titleTemplate.replace('{pageTitle}', title).replace('{siteName}', siteName)
  : siteName;

// Get navigation templates based on activeTemplate configuration
const nav = siteConfig.navigation as any;
const compactTemplateName = nav?.activeTemplate?.breakpoints?.base;
const expandedTemplateName = nav?.activeTemplate?.breakpoints?.lg;

---
<!doctype html>
<html lang={locale} class='no-js'>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {(theme.typography?.fonts ?? []).map((font: any) => (
      <Font cssVariable={font.cssVariable} preload={font.preload} />
    ))}
    <slot name="critical" />
    {analyticsEnabled && <script src="../scripts/tracking.ts"></script>}
    <script src="../scripts/deferred.ts"></script>
    {colorScheme && <meta name="color-scheme" content={colorScheme} />}
    <slot name="non-critical" />
    <meta name="description" content={description} />
    <SEO title={fullTitle} siteName={siteName} description={description} locale={locale} {...seo} />
	</head>
	<body class="@container/body">
    <header id="header" role="banner">
      <div class="@lg/body:hidden">
        <Template id={compactTemplateName} locale={locale} />
      </div>
      <div class="@max-lg/body:hidden">
        <Template id={expandedTemplateName} locale={locale} />
      </div>
    </header>
    <main id="main" role="main">
      <slot />
    </main>
    <footer id="footer" role="contentinfo">
      <slot name="footer">
        <ContentInfo locale={locale} />
      </slot>
    </footer>
  </body>
</html>
