---
/**
 * FAQ Schema Component
 *
 * NOTE: Google recommends FAQ markup only for authoritative government
 * and health sites. For other sites, consider using QAPage schema instead.
 */
import { faqGraph } from '@getvitops/utils';
import type { FAQGraphOptions, FAQItem } from '@getvitops/utils';

export type { FAQItem };
export type Props = FAQGraphOptions;

const jsonLd = faqGraph(Astro.props);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<slot />
