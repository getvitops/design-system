{
  "name": "@getvitops/generator",
  "version": "2.1.0",
  "description": "Generate design-system outputs (Bricks, standalone CSS, Tailwind v4) from a design-system.json.",
  "license": "MIT",
  "files": [
    "dist",
    "assets",
    "schema.json",
    "site.schema.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema.json": "./schema.json",
    "./site.schema.json": "./site.schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@getvitops/utils": "workspace:*",
    "@iconify/utils": "catalog:",
    "lightningcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@getvitops/core": "workspace:*",
    "@iconify/types": "catalog:",
    "vitest": "^4.1.9"
  }
}
