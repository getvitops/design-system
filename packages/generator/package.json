{
  "name": "@getvitops/generator",
  "version": "8.1.0",
  "description": "Generate design-system outputs (Bricks, standalone CSS, Tailwind v4) from a design-system.json.",
  "homepage": "https://docs.vitops.ca",
  "bugs": "https://github.com/getvitops/design-system/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getvitops/design-system.git",
    "directory": "packages/generator"
  },
  "files": [
    "dist",
    "assets",
    "schema.json",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./schema.json": "./schema.json",
    "./config.schema.json": "./config.schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@getvitops/utils": "workspace:*",
    "@iconify/utils": "catalog:",
    "@zod/mini": "catalog:",
    "lightningcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@getvitops/core": "workspace:*",
    "@iconify/types": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
