    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@getvitops/generator": "workspace:*",
    "@getvitops/utils": "workspace:*"
