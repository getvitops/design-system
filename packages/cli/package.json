{
  "name": "@getvitops/cli",
  "version": "8.1.0",
  "description": "CLI for the Vitops design-system generator: generate, init, and validate a design-system.json.",
  "homepage": "https://docs.vitops.ca",
  "bugs": "https://github.com/getvitops/design-system/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getvitops/design-system.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vitops": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skill",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@getvitops/generator": "workspace:*",
    "@getvitops/utils": "workspace:*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=24"
  }
}
