---
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import { VitopsContent } from '@getvitops/emdash/astro';
import type { ComponentProps } from 'astro/types';
import Layout from '../layouts/Layout.astro';

// Prerendered, like every page in this template: written to static HTML at build
// time from the `home` entry (seed/seed.json → pages/home). Edit it in the admin;
// a publish triggers a rebuild that bakes the change in (.agents/skills/emdash-content-and-deploys,
// "Rendering and freshness"). The Vitops blocks from @getvitops/emdash render automatically —
// EmDash merges the plugin's block components into <PortableText>; <VitopsContent> is
// <PortableText> that also turns a `vitops_band` block into a section around what follows it.
//
// Anything on a page that must be fresh per request (a stock count, a signed-in
// greeting) goes in a server island — `<Thing server:defer />` — which stays out
// of this static HTML and loads after it.
export const prerender = true;

const { entry: page } = await getEmDashEntry('pages', 'home');

// `page.data` is typed `unknown` until `.emdash/types.ts` is generated from a
// running site (`pnpm dev`, then `emdash types`), so a fresh scaffold would fail
// `astro check`; the cast keeps it passing both before and after, where the
// generated type is already `string`.
const title = page?.data.title as string | undefined;
// Same reason for the body: truthiness narrows `unknown` to `{}`, which `<PortableText>`
// rejects. The cast names the prop's own type, so it stays correct once types exist.
const content = page?.data.content as ComponentProps<typeof PortableText>['value'];
---

<Layout description={title}>
  <h1 class="centered">{title ?? 'Welcome'}</h1>
  {content ? (
    <VitopsContent value={content} />
  ) : (
    <p class="centered">
      No home page yet. Complete the setup wizard at <a href="/_emdash/admin">/_emdash/admin</a> and
      choose to include the sample content, or create a page with the slug <code>home</code> in the
      admin.
    </p>
  )}
</Layout>
