---
import Layout from '../layouts/Layout.astro';

// No per-request data — safe to prerender per AGENTS.md's "Prerender by
// default" rule. [...slug].astro reaches this via Astro.rewrite('/404'),
// which resolves a prerendered destination the same as a server-rendered one.
export const prerender = true;
---

<Layout title="Page not found">
  <section class="rhythm">
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist (or isn't published yet).</p>
    <p><a href="/">Back to the home page</a></p>
  </section>
</Layout>
