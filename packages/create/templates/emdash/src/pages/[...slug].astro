---
import { getEmDashCollection } from 'emdash';
import { PortableText } from 'emdash/ui';
import Layout from '../layouts/Layout.astro';

// Prerendered: every published entry in `pages` becomes a static HTML file at
// its slug, written at build time and served as a static asset. The build reads
// the content database — `scripts/pull-content.mjs` loads production's into the
// local build database first (it is part of `deploy`/`deploy:dev`) — so an edit
// in the admin goes live on the next rebuild, which a publish webhook triggers
// (see .agents/skills/emdash-content-and-deploys).
//
// There is no `Astro.rewrite('/404')` here and no on-demand fallback: a URL that
// isn't in the list below simply has no route, so Astro serves the prerendered
// `404.astro` with a real 404 status. (The previous version rewrote an
// on-demand route to the prerendered `/404`, which Astro refuses — every
// unknown URL was a 500.)
export const prerender = true;

export async function getStaticPaths() {
  const { entries, error } = await getEmDashCollection('pages');
  // Fail the build rather than ship a site with no pages.
  if (error) throw error;
  return entries
    // `home` is served by index.astro at `/`.
    .filter((entry) => entry.id !== 'home')
    .map((entry) => ({ params: { slug: entry.id }, props: { page: entry } }));
}

const { page } = Astro.props;
// `page.data` is typed `unknown` until `.emdash/types.ts` is generated from a
// running site (`pnpm dev`, then `emdash types`), so a fresh scaffold would fail
// `astro check`; the cast keeps it passing both before and after, where the
// generated type is already `string`.
const title = page.data.title as string | undefined;
---

<Layout title={title}>
  <article class="rhythm">
    <h1>{title}</h1>
    {page.data.content && <PortableText value={page.data.content} />}
  </article>
</Layout>
