---
import VitopsHead from '@getvitops/astro/Head.astro';
import { getMenu, getSiteSettings } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import SiteFooter from '@getvitops/astro/components/SiteFooter.astro';
import SiteNav from '@getvitops/astro/components/SiteNav.astro';
import { loadNavMenus } from '@getvitops/astro/components/sitenav.ts';
import { EmDashHead } from 'emdash/ui';
// Design-system CSS, layout-scoped (vitops css.inject: false): only pages
// rendered through this layout get it — keeps it out of /_emdash/admin, while
// EmDash previews (rendered through this layout) keep it.
import '../styles/tailwind.css';
// Single source of truth for the brand mark — the same file the favicon set
// is generated from. `?raw` inlines it at build time (no extra request).
import logo from '../assets/logo.svg?raw';
import site from '../../site.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || 'My EmDash Site';
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || 'An EmDash website with the Vitops design system';

const pageCtx = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: 'website',
  title: fullTitle,
  pageTitle: title ?? siteTitle,
  description: description || siteDescription,
  canonical: new URL(Astro.url.pathname, Astro.url).href,
  image,
  seo: { ogImage: image },
  siteName: siteTitle,
});

// Editor-managed navigation, read from EmDash menus (edit under Menus in the admin):
//   `primary`         header nav (the logo is the home link, so it holds no Home item).
//                     Nested items become dropdowns; an item's `titleAttr` is its description.
//   `primary-mobile`  OPTIONAL — a simpler depth-1 nav that replaces `primary` below `md`.
//   `primary-mega`    OPTIONAL — a mega menu that replaces `primary` from `xl`.
//   `footer-sitemap`, `footer-legal`  footer columns.
// Variants need no code change: create the menu and <SiteNav> picks it up. A missing menu
// renders nothing rather than failing (a fresh DB before the seed has applied).
const nav = await loadNavMenus(getMenu);
const footerSitemap = await getMenu('footer-sitemap');
const footerLegal = await getMenu('footer-legal');
const orgName = site.organization?.name || siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <EmDashHead page={pageCtx} />
    <!-- Favicon/PWA links + the vitops web-component runtime. The runtime
         progressively enhances the @getvitops/emdash editor blocks
         (wc-carousel, wc-image-compare, ...) wherever Portable Text renders. -->
    <VitopsHead />
  </head>
  <body>
    <header class="navbar-sticky centered">
      <div class="navbar">
        <a class="brand flex items-center" href="/" aria-label={`${siteTitle} home`}>
          <span class="brand-mark" set:html={logo} aria-hidden="true" />
          <span class="font-heading">{siteTitle}</span>
        </a>
        <div class="header-end flex items-center">
          <SiteNav {...nav} />
          <wc-color-scheme-toggle></wc-color-scheme-toggle>
        </div>
      </div>
    </header>

    <main class="centered rhythm">
      <slot />
    </main>

    <SiteFooter class="centered" sitemap={footerSitemap} legal={footerLegal} name={orgName} />

    <style>
      .brand {
        gap: 0.55rem;
        text-decoration: none;
        color: inherit;
      }

      .brand-mark :global(svg) {
        display: block;
        inline-size: 1.75rem;
        block-size: 1.75rem;
      }

      .navbar {
        block-size: 64px;
      }

      .header-end {
        gap: var(--space-s, 0.75rem);
      }
    </style>
  </body>
</html>
