{
  "name": "my-emdash-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "vitops email check && astro build && emdash migrate --wrangler-config wrangler.jsonc && wrangler deploy",
    "deploy:dev": "vitops email check && astro build && node scripts/build-dev-wrangler.mjs && emdash migrate --wrangler-config dist/server/wrangler.dev.json && wrangler deploy --config dist/server/wrangler.dev.json",
    "init:github": "vitops setup repo",
    "init:hosting": "vitops setup hosting",
    "setup": "vitops setup all",
    "typecheck": "astro check",
    "build:css": "vitops generate -i site.json -f tailwind -o src/styles",
    "lint:design": "vitops lint -i site.json -f tailwind --strict",
    "sop": "vitops generate -i site.json -f css -o .vitops/sop",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/react": "^6.0.0",
    "@emdash-cms/cloudflare": "^1.0.1",
    "@getvitops/astro": "latest",
    "@getvitops/core": "latest",
    "@getvitops/emdash": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.2",
    "emdash": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^4.20260305.1",
    "@getvitops/cli": "latest",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vite-plus": "latest",
    "wrangler": "^4.111.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.17.0",
  "emdash": {
    "seed": "seed/seed.json"
  }
}
