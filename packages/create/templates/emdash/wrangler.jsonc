{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-emdash-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Custom domain: uncomment and set your apex. Cloudflare provisions the DNS
  // record + TLS cert on deploy (the zone must already exist in the account).
  // The dev deploy (scripts/build-dev-wrangler.mjs) automatically serves the
  // dev worker from dev.<domain> when this is set.
  // "routes": [{ "pattern": "example.com", "custom_domain": true }],
  // No database_id / bucket ids needed up front: wrangler provisions the D1
  // database and R2 bucket on the first `pnpm deploy` if they don't exist.
  // EmDash runs its migrations + applies seed/seed.json on first boot.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-emdash-site",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "my-emdash-site-media",
    },
  ],
  // Drives scheduled publishing, plugin cron, and maintenance (see
  // src/worker.ts). Without it, content scheduled in the admin never
  // publishes on Cloudflare Workers. Local `astro dev` doesn't need it.
  "triggers": {
    "crons": ["* * * * *"],
  },
}
