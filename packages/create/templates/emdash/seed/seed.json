              ]
            },
            {
              "_type": "block",
              "_key": "privacy-rights-h",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-rights-h-1",
                  "text": "Your rights",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-rights",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-rights-1",
                  "text": "You may request access to, correction of, or deletion of your personal information by contacting the site owner. Edit this page in the EmDash admin.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
        "id": "contact",
        "slug": "contact",
        "status": "published",
        "data": {
          "title": "Contact",
          "content": [
            {
              "_type": "vitops.banner",
              "_key": "contact-placeholder",
              "message": "Placeholder text — replace with your contact details before launch.",
              "tone": "warning",
              "dismissible": false
            },
            {
              "_type": "block",
              "_key": "contact-body",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "contact-body-1",
                  "text": "Tell visitors how to reach you: an email address, a phone number, a street address or a form. This page exists so the Contact link in the header and footer resolves; edit it in the EmDash admin.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
        "id": "cookies",
        "slug": "cookies",
        "status": "published",
        "data": {
          "title": "Cookie Notice",
          "content": [
            {
              "_type": "vitops.banner",
              "_key": "cookies-placeholder",
              "message": "Placeholder text — replace with your own cookie notice before launch. This is not legal advice. `vitops legal` can generate a draft from site.json.",
              "tone": "warning",
