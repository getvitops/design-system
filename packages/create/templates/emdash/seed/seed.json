        }
      },
      {
        "id": "privacy",
        "slug": "privacy",
        "status": "published",
        "data": {
          "title": "Privacy Policy",
          "content": [
            {
              "_type": "vitops_banner",
              "_key": "privacy-placeholder",
              "message": "Placeholder text — replace with your own privacy policy before launch. This is not legal advice.",
              "tone": "warning",
              "dismissible": false
            },
            {
              "_type": "block",
              "_key": "privacy-intro",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-intro-1",
                  "text": "This policy describes what information this website collects, how it is used, and the choices you have. We collect only what we need to operate the site.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-collect-h",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-collect-h-1",
                  "text": "What we collect",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-collect",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-collect-1",
                  "text": "Standard server logs (IP address, browser type, pages visited) used for security and troubleshooting, and any information you submit through forms on the site.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-use-h",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-use-h-1",
                  "text": "How we use it",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-use",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-use-1",
                  "text": "To operate and secure the site and to respond to your enquiries. We do not sell personal information. Third-party services used to host this site (e.g. Cloudflare) process data under their own policies.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-rights-h",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-rights-h-1",
                  "text": "Your rights",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "privacy-rights",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "privacy-rights-1",
                  "text": "You may request access to, correction of, or deletion of your personal information by contacting the site owner. Edit this page in the EmDash admin.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
        "id": "contact",
        "slug": "contact",
        "status": "published",
        "data": {
          "title": "Contact",
          "content": [
            {
              "_type": "vitops_banner",
              "_key": "contact-placeholder",
              "message": "Placeholder text — replace with your contact details before launch.",
              "tone": "warning",
              "dismissible": false
            },
            {
              "_type": "block",
              "_key": "contact-body",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "contact-body-1",
                  "text": "Tell visitors how to reach you: an email address, a phone number, a street address or a form. This page exists so the Contact link in the header and footer resolves; edit it in the EmDash admin.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "vitops_form",
              "_key": "contact-form",
              "heading": "Send us a message",
              "level": "2",
              "fields": [
                {
                  "label": "Your name",
                  "name": "name",
                  "type": "text",
                  "required": true
                },
                {
                  "label": "Email",
                  "name": "email",
                  "type": "email",
                  "required": true
                },
                {
                  "label": "Phone",
                  "name": "phone",
                  "type": "tel",
                  "required": false
                },
                {
                  "label": "Message",
                  "name": "message",
                  "type": "textarea",
                  "required": true
                }
              ],
              "submitLabel": "Send message",
              "successMessage": "Thanks. Your message has been sent and we will reply soon."
            }
          ]
        }
      },
      {
        "id": "cookies",
        "slug": "cookies",
        "status": "published",
        "data": {
          "title": "Cookie Notice",
          "content": [
