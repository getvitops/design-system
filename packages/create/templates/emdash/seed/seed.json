{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Vitops Starter",
    "description": "An EmDash website wired to the Vitops design system",
    "author": "Vitops"
  },
  "blockTypes": [
    {
      "slug": "vitops_section",
      "label": "Section",
      "description": "A titled page section whose body can hold any other blocks.",
      "category": "Sections",
      "icon": "layout",
      "currentVersion": 1,
      "versions": [
        {
          "version": 1,
          "fields": [
            {
              "slug": "kicker",
              "label": "Kicker (small line above the heading)",
              "type": "string"
            },
            {
              "slug": "heading",
              "label": "Heading",
              "type": "string"
            },
            {
              "slug": "level",
              "label": "Heading level (p: styled like a heading, not in the outline)",
              "type": "select",
              "defaultValue": "2",
              "validation": {
                "options": ["1", "2", "3", "4", "5", "6", "p"]
              }
            },
            {
              "slug": "sub",
              "label": "Lead-in text under the heading",
              "type": "text"
            },
            {
              "slug": "cta_label",
              "label": "Button text (filled)",
              "type": "string"
            },
            {
              "slug": "cta_href",
              "label": "Button URL",
              "type": "string"
            },
            {
              "slug": "secondary_label",
              "label": "Second link text",
              "type": "string"
            },
            {
              "slug": "secondary_href",
              "label": "Second link URL",
              "type": "string"
            },
            {
              "slug": "body",
              "label": "Content (any blocks)",
              "type": "portableText"
            },
            {
              "slug": "layout",
              "label": "Layout",
              "type": "select",
              "defaultValue": "stack",
              "validation": {
                "options": ["stack", "center", "split"]
              }
            },
            {
              "slug": "stack",
              "label": "Spacing (rhythm: head and body use the vertical-rhythm scale, as a page opener or prose stack)",
              "type": "select",
              "defaultValue": "grid",
              "validation": {
                "options": ["grid", "rhythm"]
              }
            },
            {
              "slug": "width",
              "label": "Width",
              "type": "select",
              "defaultValue": "measure",
              "validation": {
                "options": ["measure", "breakout", "spotlight", "fullbleed"]
              }
            },
            {
              "slug": "tone",
              "label": "Backdrop tone (a colour role from the site, e.g. surface or brand-primary)",
              "type": "string"
            },
            {
              "slug": "color",
              "label": "Palette colour instead of a tone (e.g. amber or amber-300)",
              "type": "string"
            },
            {
              "slug": "solid",
              "label": "Fill with the solid colour",
              "type": "boolean",
              "defaultValue": false
            },
            {
              "slug": "theme",
              "label": "Theme (backdrop and readable text in one pick; overrides the tone fields)",
              "type": "select",
              "defaultValue": "none",
              "validation": {
                "options": [
                  "none",
                  "neutral",
                  "surface",
                  "brand-primary",
                  "brand-secondary",
                  "info",
                  "success",
                  "warning",
                  "danger",
                  "neutral:solid",
                  "surface:solid",
                  "brand-primary:solid",
                  "brand-secondary:solid",
                  "info:solid",
                  "success:solid",
                  "warning:solid",
                  "danger:solid"
                ]
              }
            },
            {
              "slug": "anchor",
              "label": "Anchor id (so a link can point here with #id)",
              "type": "string"
            },
            {
              "slug": "class_name",
              "label": "Extra CSS classes",
              "type": "string"
            },
            {
              "slug": "style",
              "label": "CSS custom properties, e.g. --p-card: 2rem",
              "type": "string"
            }
          ]
        }
      ]
    }
  ],
  "settings": {
    "title": "My EmDash Site",
    "tagline": "An EmDash website with the Vitops design system"
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/{slug}",
      "supports": ["drafts", "revisions", "seo"],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText"
        }
      ]
    },
    {
      "slug": "landings",
      "label": "Landings",
      "labelSingular": "Landing",
      "urlPattern": "/landings/{slug}",
      "supports": ["drafts", "revisions", "seo"],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "layout",
          "label": "Layout",
          "type": "blocks",
          "validation": {
            "allowedTypes": ["vitops_section"],
            "maxItems": 20
          }
        }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "Contact",
          "url": "/contact"
        }
      ]
    },
    {
      "name": "footer-sitemap",
      "label": "Footer: Site Map",
      "items": [
        {
          "type": "custom",
          "label": "Home",
          "url": "/"
        },
        {
          "type": "custom",
          "label": "Contact",
          "url": "/contact"
        }
      ]
    },
    {
      "name": "footer-legal",
      "label": "Footer: Legal",
      "items": [
        {
          "type": "custom",
          "label": "Privacy Policy",
          "url": "/privacy"
        },
        {
          "type": "custom",
          "label": "Terms & Conditions",
          "url": "/terms"
        },
        {
          "type": "custom",
          "label": "Cookie Notice",
          "url": "/cookies"
        }
      ]
    }
  ],
  "widgetAreas": [
    {
      "name": "announcement",
      "label": "Announcement bar",
      "description": "Shown above the header on every page. Empty until you add a widget.",
      "widgets": []
    },
    {
      "name": "pre-footer",
      "label": "Above the footer",
      "description": "A call to action shown above the footer on every page (Widgets in the admin).",
      "widgets": [
        {
          "type": "content",
          "title": "Ready to talk?",
          "content": [
            {
              "_type": "block",
              "_key": "pf-text",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "pf-text-s",
                  "text": "Tell us what you need and we will reply within one business day.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "vitops_actionLink",
              "_key": "pf-cta",
              "label": "Contact us",
              "href": "/contact",
              "variant": "cta"
            }
          ]
        }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "Home",
          "content": [
            {
              "_type": "block",
              "_key": "intro-heading",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "intro-heading-1",
                  "text": "Your site is running",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "intro-body",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "intro-body-1",
                  "text": "This page is served from the EmDash database. Edit it in the admin at /_emdash/admin — the Vitops design-system blocks are available from the editor's slash menu.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "vitops_hero",
              "_key": "demo-hero",
              "eyebrow": "Vitops blocks",
              "heading": "Build pages from design-system patterns",
              "level": "2",
              "body": "Every block below renders a framework pattern, so it follows your tokens and works without JavaScript.",
              "primaryLabel": "Open the admin",
              "primaryHref": "/_emdash/admin",
              "secondaryLabel": "Docs",
              "secondaryHref": "https://docs.vitops.ca",
              "layout": "centered"
            },
            {
              "_type": "vitops_cards",
              "_key": "demo-cards",
              "columns": "3",
              "cards": [
                {
                  "_key": "c1",
                  "title": "Tokens",
                  "body": "Colour, type and spacing come from site.json.",
                  "href": "https://docs.vitops.ca",
                  "linkLabel": "Read more"
                },
                {
                  "_key": "c2",
                  "title": "Patterns",
                  "body": "Cards, carousels and dialogs share one vocabulary."
                },
                {
                  "_key": "c3",
                  "title": "Accessible",
                  "body": "Semantic HTML first, enhanced when JavaScript loads."
                }
              ]
            },
            {
              "_type": "vitops_accordion",
              "_key": "demo-accordion",
              "exclusive": true,
              "items": [
                {
                  "_key": "a1",
                  "summary": "What is a block?",
                  "body": "A reusable section an editor inserts from the slash menu.",
                  "open": true
                },
                {
                  "_key": "a2",
                  "summary": "Can I add my own?",
                  "body": "Yes. Pass blocks.extra to the plugin and map a component for it."
                }
              ]
            },
            {
              "_type": "vitops_marquee",
              "_key": "demo-marquee",
              "pauseOnHover": true,
              "reverse": false,
              "items": [
                {
                  "_key": "m1",
                  "text": "Fast"
                },
                {
                  "_key": "m2",
                  "text": "Accessible"
                },
                {
                  "_key": "m3",
                  "text": "Editable"
                },
                {
                  "_key": "m4",
                  "text": "Yours"
                }
              ]
            },
            {
              "_type": "vitops_banner",
              "_key": "welcome-banner",
              "message": "This banner is a Vitops block — dismiss it, then edit this page in the EmDash admin.",
              "tone": "info",
              "dismissible": true
            },
            {
              "_type": "vitops_details",
              "_key": "next-steps",
              "summary": "Next steps",
              "body": "Adjust site.json (under designSystem.themes.default) to your brand (colors, type, patterns), replace src/assets/logo.svg, then deploy with `pnpm deploy`.",
              "open": false
            }
          ]
        }
      },
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About",
          "content": [
            {
              "_type": "block",
              "_key": "about-body",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "about-body-1",
                  "text": "This page is rendered by the catch-all route (src/pages/[...slug].astro). Any page you create in the pages collection appears at its slug automatically.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
        "id": "terms",
        "slug": "terms",
        "status": "published",
        "data": {
          "title": "Terms & Conditions",
