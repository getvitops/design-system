{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Vitops Starter",
    "description": "An EmDash website wired to the Vitops design system",
    "author": "Vitops"
  },
  "settings": {
    "title": "My EmDash Site",
    "tagline": "An EmDash website with the Vitops design system"
  },
  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "supports": ["drafts", "revisions", "seo"],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText"
        }
      ]
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        {
          "type": "custom",
          "label": "Contact",
          "url": "/contact"
        }
      ]
    },
    {
      "name": "footer-sitemap",
      "label": "Footer: Site Map",
      "items": [
        {
          "type": "custom",
          "label": "Home",
          "url": "/"
        },
        {
          "type": "custom",
          "label": "Contact",
          "url": "/contact"
        }
      ]
    },
    {
      "name": "footer-legal",
      "label": "Footer: Legal",
      "items": [
        {
          "type": "custom",
          "label": "Privacy Policy",
          "url": "/privacy"
        },
        {
          "type": "custom",
          "label": "Terms & Conditions",
          "url": "/terms"
        },
        {
          "type": "custom",
          "label": "Cookie Notice",
          "url": "/cookies"
        }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "Home",
          "content": [
            {
              "_type": "block",
              "_key": "intro-heading",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "intro-heading-1",
                  "text": "Your site is running",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "intro-body",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "intro-body-1",
                  "text": "This page is served from the EmDash database. Edit it in the admin at /_emdash/admin — the Vitops design-system blocks are available from the editor's slash menu.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "vitops.hero",
              "_key": "demo-hero",
              "eyebrow": "Vitops blocks",
              "heading": "Build pages from design-system patterns",
              "body": "Every block below renders a framework pattern, so it follows your tokens and works without JavaScript.",
              "primaryLabel": "Open the admin",
              "primaryHref": "/_emdash/admin",
              "secondaryLabel": "Docs",
              "secondaryHref": "https://docs.vitops.ca",
              "layout": "centered"
            },
            {
              "_type": "vitops.cards",
              "_key": "demo-cards",
              "columns": "3",
              "cards": [
                {
                  "_key": "c1",
                  "title": "Tokens",
                  "body": "Colour, type and spacing come from site.json.",
                  "href": "https://docs.vitops.ca",
                  "linkLabel": "Read more"
                },
                {
                  "_key": "c2",
                  "title": "Patterns",
                  "body": "Cards, carousels and dialogs share one vocabulary."
                },
                {
                  "_key": "c3",
                  "title": "Accessible",
                  "body": "Semantic HTML first, enhanced when JavaScript loads."
                }
              ]
            },
            {
              "_type": "vitops.accordion",
              "_key": "demo-accordion",
              "exclusive": true,
              "items": [
                {
                  "_key": "a1",
                  "summary": "What is a block?",
                  "body": "A reusable section an editor inserts from the slash menu.",
                  "open": true
                },
                {
                  "_key": "a2",
                  "summary": "Can I add my own?",
                  "body": "Yes. Pass blocks.extra to the plugin and map a component for it."
                }
              ]
            },
            {
              "_type": "vitops.marquee",
              "_key": "demo-marquee",
              "pauseOnHover": true,
              "reverse": false,
              "items": [
                {
                  "_key": "m1",
                  "text": "Fast"
                },
                {
                  "_key": "m2",
                  "text": "Accessible"
                },
                {
                  "_key": "m3",
                  "text": "Editable"
                },
                {
                  "_key": "m4",
                  "text": "Yours"
                }
              ]
            },
            {
              "_type": "vitops.banner",
              "_key": "welcome-banner",
              "message": "This banner is a Vitops block — dismiss it, then edit this page in the EmDash admin.",
              "tone": "info",
              "dismissible": true
            },
            {
              "_type": "vitops.details",
              "_key": "next-steps",
              "summary": "Next steps",
              "body": "Adjust site.json (under designSystem.themes.default) to your brand (colors, type, patterns), replace src/assets/logo.svg, then deploy with `pnpm deploy`.",
              "open": false
            }
          ]
        }
      },
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About",
          "content": [
            {
              "_type": "block",
              "_key": "about-body",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "about-body-1",
                  "text": "This page is rendered by the catch-all route (src/pages/[...slug].astro). Any page you create in the pages collection appears at its slug automatically.",
                  "marks": []
                }
              ]
            }
          ]
        }
      },
      {
