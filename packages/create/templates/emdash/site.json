{
  "$schema": "./node_modules/@getvitops/generator/config.schema.json",
  "designSystem": {
    "themes": {
      "default": {
        "$schema": "./node_modules/@getvitops/generator/schema.json",
        "colors": {
          "palette": {
            "brand": {
              "seed": "#2e9b73"
            },
            "ink": {
              "seed": "#3f4a5c"
            },
            "sky": {
              "seed": "#2f7bc0"
            },
            "sun": {
              "seed": "#d08a1f"
            },
            "rose": {
              "seed": "#c74a42"
            }
          },
          "roles": {
            "neutral": {
              "hue": "ink",
              "kind": "surface"
            },
            "surface": {
              "hue": "ink",
              "kind": "surface"
            },
            "ui-primary": "brand",
            "brand-primary": "brand",
            "info": "sky",
            "success": "brand",
            "warning": "sun",
            "danger": "rose"
          },
          "utilities": ["bg", "text", "icon", "border"]
        },
        "shadows": {
          "sm": "0 1px 2px rgb(0 0 0 / 0.08)",
          "md": "0 4px 6px rgb(0 0 0 / 0.12)",
          "lg": "0 10px 15px rgb(0 0 0 / 0.18)"
        },
        "fonts": {
          "display": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "sans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "mono": "ui-monospace, \"SF Mono\", Menlo, monospace"
        },
        "typeScale": {
          "base": "1rem",
          "names": ["2xs", "xs", "s", "m", "l", "xl", "2xl", "3xl"],
          "baseStep": 4,
          "baseline": "m",
          "ratio": 1.2,
          "fluid": {
            "minVw": "22.5rem",
            "maxVw": "80rem",
            "minRatio": 1.12
          }
        },
        "spaceScale": {
          "base": "1rem",
          "names": ["2xs", "xs", "s", "m", "l", "xl", "2xl", "3xl"],
          "baseStep": 4,
          "baseline": "m",
          "ratio": 1.25,
          "fluid": {
            "minVw": "22.5rem",
            "maxVw": "80rem",
            "minRatio": 1.2
          }
        },
        "patterns": {
          "defaults": {
            "ds": "none",
            "b": "1px solid var(--color-bg-surface-x-muted)",
            "br": "0.375rem",
            "p": "1rem",
            "fs": "1rem"
          },
          "radii": {
            "circle": "50%"
          },
          "groups": {
            "control": {
              "ds": "var(--ds-default)",
              "b": "var(--b-default)",
              "br": "var(--br-default)",
              "p": "0.5em 1em",
              "fs": "var(--fs-default)"
            },
            "panel": {
              "ds": "var(--shadow-md)",
              "b": "var(--b-default)",
              "br": "0.5rem",
              "p": "1rem",
              "fs": "var(--fs-default)"
            },
            "label": {
              "ds": "var(--ds-default)",
              "b": "none",
              "br": "0.25rem",
              "p": "0.25em 0.5em",
              "fs": "0.75rem"
            }
          },
          "z": {
            "raised": 1,
            "sticky": 100,
            "overlay": 200,
            "top": 1000
          },
          "items": {
            "button": {
              "group": "control",
              "element": "button",
              "default_role": "brand-primary",
              "base": {
                "padding": "0.6em 1.2em",
                "border-radius": "var(--br-control, 0.25rem)",
                "border": "none",
                "font-weight": "600",
                "color": "#fff",
                "cursor": "pointer",
                "box-shadow": "var(--shadow-sm)"
              },
              "states": {
                "hover": {
                  "step": 1
                },
                "active": {
                  "scale": 0.97
                },
                "focus-visible": {
                  "ring": true
                }
              },
              "roles": ["success", "danger", "warning", "info"],
              "class": "btn"
            },
            "card": {
              "group": "panel",
              "class": "card",
              "base": {
                "border-radius": "var(--br-card-group)",
                "padding": "1.5rem",
                "background": "var(--color-bg-surface-muted)",
                "border": "var(--b-card-group)",
                "box-shadow": "var(--ds-card-group)"
              },
              "states": {},
              "roles": []
            },
            "badge": {
              "group": "label",
              "class": "badge",
              "default_role": "brand-primary",
              "overrides": {
                "p": "0.2em 0.6em",
                "br": "999px",
                "fs": "0.85em"
              },
              "base": {
                "display": "inline-block",
                "padding": "var(--p-badge-group)",
                "border-radius": "var(--br-badge-group)",
                "font-size": "var(--fs-badge-group)",
                "font-weight": "600",
                "color": "var(--color-text-on-brand-primary)"
              },
              "states": {},
              "roles": ["success", "danger", "warning", "info"]
            },
            "tag": {
              "group": "label",
              "class": "tag",
              "default_role": "neutral",
              "overrides": {
                "p": "0.25em 0.6em",
                "b": "1px solid currentColor",
                "fs": "0.85em"
              },
              "base": {
                "display": "inline-flex",
                "align-items": "center",
                "gap": "0.25em",
                "padding": "var(--p-tag-group)",
                "border": "var(--b-tag-group)",
                "border-radius": "var(--br-tag-group)",
                "font-size": "var(--fs-tag-group)",
                "font-weight": "500",
                "line-height": "1.2",
                "white-space": "nowrap",
                "color": "var(--color-text-neutral-bold)"
              },
              "states": {},
              "roles": ["success", "danger", "warning", "info"]
            }
          }
        },
        "typography": {
          "families": {
            "display": "var(--font-display)",
            "sans": "var(--font-sans)",
            "code": "var(--font-mono, ui-monospace, monospace)"
          },
          "roles": {
            "display": {
              "family": "display",
              "size": "var(--text-3xl)",
              "weight": 700,
              "line-height": "1.05",
              "tracking": "-0.03em"
            },
            "heading": {
              "family": "display",
              "size": "var(--text-xl)",
              "weight": 600,
              "line-height": "1.3"
            },
            "body": {
              "family": "sans",
              "size": "var(--text-m)",
              "weight": 400,
              "line-height": "1.55"
            },
            "title": {
              "family": "display",
              "size": "var(--text-2xl)",
              "weight": 600,
              "line-height": "1.15",
              "tracking": "-0.025em",
              "text-wrap": "balance"
            },
            "lead": {
              "family": "sans",
              "size": "var(--text-l)",
              "weight": 400,
              "line-height": "1.5",
              "text-wrap": "pretty"
            },
            "caption": {
              "family": "sans",
              "size": "var(--text-s)",
              "weight": 400,
              "line-height": "1.3",
              "text-wrap": "pretty",
              "color": "var(--color-text-neutral-muted)"
            },
            "eyebrow": {
              "family": "sans",
              "size": "var(--text-s)",
              "weight": 600,
              "line-height": "1.3",
              "tracking": "0.08em",
              "text-transform": "uppercase",
              "text-wrap": "balance"
            },
            "footnote": {
              "family": "sans",
              "size": "var(--text-xs)",
              "weight": 400,
              "line-height": "1.4",
              "text-wrap": "pretty",
              "color": "var(--color-text-neutral-muted)"
            }
          },
          "headings": {
            "h1": "display",
            "h2": "heading",
            "h3": "heading"
          }
        },
        "animations": {
          "effects": {
            "fade-in": {
              "kf": "composite",
              "vars": {
                "opacity-from": 0
              }
            },
            "slide-up": {
              "kf": "composite",
              "vars": {
                "translate-y-from": "var(--slide-distance, 2rem)"
              }
            }
          },
          "journeys": {
            "base": {
              "fade": {
                "opacity-from": 0
              },
              "slide": {}
            },
            "compose": [["fade"], ["slide"], ["fade", "slide"]]
          }
        }
      }
    },
    "defaultColorScheme": "light"
  },
  "organization": {
    "name": "My EmDash Site"
  },
  "site": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "name": "English"
      }
    },
    "environments": {
      "production": {
        "url": "https://my-emdash-site.example.com"
      },
      "dev": {
        "url": "https://dev.my-emdash-site.example.com",
        "robots": "noindex,nofollow"
      }
    },
    "icons": {
      "sprite": true,
      "semantic": [
        "menu",
        "close",
        "home",
        "settings",
        "search",
        "add",
        "remove",
        "delete",
        "edit",
        "save",
        "copy",
        "paste",
        "attach",
        "upload",
        "download",
        "share",
        "bookmark",
        "favorite",
        "star",
        "login",
        "logout",
        "email",
        "phone",
        "location",
        "globe",
        "link",
        "clock",
        "calendar",
        "schedule",
        "person",
        "group",
        "file",
        "folder",
        "image",
        "export",
        "import",
        "backup",
        "compress",
        "check",
        "error",
        "warning",
        "info",
        "help",
        "cart",
        "tag",
        "receipt",
        "leaf",
        "tree",
        "seedling",
        "trowel",
        "droplet",
        "snowflake",
        "sun",
        "cloud",
        "grid",
        "list",
        "filter",
        "sort",
        "fullscreen",
        "collapse",
        "building",
        "video",
        "lock",
        "unlock",
        "eye",
        "print",
        "code",
        "palette",
        "lightbulb",
        "lightning"
      ]
    }
  }
}
