{
  "name": "@getvitops/core",
  "version": "8.2.0-alpha.0",
  "description": "The Vitops design-system framework — CSS partials, Lit web components, and browser polyfills.",
  "homepage": "https://docs.vitops.ca",
  "bugs": "https://github.com/getvitops/design-system/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getvitops/design-system.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "css",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./elements": "./dist/elements.js",
    "./consent": "./dist/consent.js",
    "./editor": "./dist/editor.js",
    "./polyfills": "./dist/polyfills.js",
    "./deferred": "./dist/deferred.js",
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@getvitops/utils": "workspace:*",
    "@lit-labs/signals": "catalog:",
    "@oddbird/css-anchor-positioning": "catalog:",
    "@oddbird/popover-polyfill": "catalog:",
    "@webcomponents/template-shadowroot": "catalog:",
    "@webcomponents/webcomponentsjs": "catalog:",
    "colorjs.io": "catalog:",
    "construct-style-sheets-polyfill": "catalog:",
    "cssnano": "catalog:",
    "happy-dom": "catalog:",
    "invokers-polyfill": "catalog:",
    "lit": "catalog:",
    "minify-html-literals": "catalog:",
    "postcss": "catalog:",
    "postcss-lit": "catalog:",
    "scroll-timeline-polyfill": "catalog:",
    "temporal-polyfill": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
