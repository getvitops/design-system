---
/**
 * Renders a `portableText` field, turning each `vitops_band` marker into a full section that
 * holds the blocks after it. Use it where a page would use `<PortableText value={…} />`:
 *
 *     <VitopsContent value={page.data.content} />
 *
 * Content with no band renders exactly as `<PortableText>` would, in a `.centered` reading column.
 * A run of blocks between (or before) bands gets that column here because `<main>` is a plain
 * landmark, not a layout: a band owns its width, so nothing above it may constrain it. Imported
 * lazily for the same cycle `Section.astro` explains.
 */
const { PortableText } = await import('emdash/ui');
import Section from './blocks/Section.astro';
import { bandToSection, groupBands } from './blocks/band.ts';

// `components` is `<PortableText>`'s prop, forwarded to the plain runs AND to the blocks inside each band:
//     <VitopsContent value={page.data.content} components={{ type: { vitops_hero: MyHero } }} />
const { value, components } = Astro.props as {
  value: unknown;
  components?: Record<string, unknown>;
};
const groups = groupBands(value);
---

{groups.map((group) =>
  group.kind === 'band' ? (
    <Section node={bandToSection(group.band, group.body)} components={components} />
  ) : (
    <div class="centered rhythm">
      <PortableText value={group.blocks as never} components={components as never} />
    </div>
  ),
)}
