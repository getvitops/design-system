---
/**
 * A page opener built from the layout primitives: `.centered` for a single column, `.split`
 * for text beside an image. The heading defaults to `<h2>` — a page has one `<h1>`, and
 * EmDash renders the page title elsewhere — and an editor can change the level. Words wrapped
 * in `*stars*` render as `<em class="accent">` (accent marks, no raw HTML in the field).
 * An optional row of option cards sits under the buttons, as the framework's `.card` list.
 * Flat fields, because a block cannot contain other blocks.
 */
import ScrollCue from '@getvitops/astro/components/ScrollCue.astro';
import BlockImage from './BlockImage.astro';
import RichText from './RichText.astro';
import { joinStyle, resolveTheme, resolveTone, rowTone } from './tone.ts';
import { accentRuns, outlineTag, resolveBlockValue, rows, safeHref, text } from './value.ts';

interface Value {
  eyebrow?: string;
  heading?: string;
  level?: string | number;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  imageAlt?: string;
  imageRatio?: string;
  layout?: string;
  align?: string;
  width?: string;
  secondaryVariant?: string;
  tone?: string;
  color?: string;
  scrollCue?: boolean;
  scrollCueLabel?: string;
  cards?: unknown;
}

const value = resolveBlockValue<Value>(Astro.props);
const eyebrow = text(value.eyebrow);
const heading = text(value.heading);
const headingRuns = accentRuns(heading);
const Heading = outlineTag(value.level, 1);
// A hero titled `h1` puts its option cards one level down, at `h2`.
const CardHeading = Heading === 'h1' ? 'h2' : 'h3';
const body = text(value.body);
const primaryLabel = text(value.primaryLabel);
const primaryHref = safeHref(value.primaryHref);
const secondaryLabel = text(value.secondaryLabel);
const secondaryHref = safeHref(value.secondaryHref);
const image = safeHref(value.image);
const imageAlt = text(value.imageAlt);
const split = value.layout === 'split' && Boolean(image);
// Split only. `start` left-aligns the text column; `spotlight` keeps the hero on the page column
// (the image gets the card radius) instead of running it to the viewport edges.
const alignStart = split && value.align === 'start';
const spotlight = split && value.width === 'spotlight';
const secondaryClass = value.secondaryVariant === 'btn' ? 'btn' : 'link';
const tone = resolveTone(value.tone, value.color);
const scrollCue = value.scrollCue === true;
const scrollCueLabel = text(value.scrollCueLabel) || undefined;
const cards = rows<Record<string, unknown>>(value.cards)
  .map((row) => ({
    title: text(row.title),
    body: text(row.body),
    href: safeHref(row.href),
    linkLabel: text(row.linkLabel) || 'Learn more',
    eyebrow: text(row.eyebrow),
    ctaLabel: text(row.ctaLabel),
    ctaHref: safeHref(row.ctaHref),
    style: rowTone(row),
    theme: resolveTheme(row.theme),
  }))
  .filter((card) => card.title || card.body);
import { rootAttrs } from './attrs.ts';
---

{(heading || body) && (
  <section
    {...rootAttrs(
      value,
      [
        tone.style && tone.surface,
        split && (spotlight ? 'spotlight hero--spotlight' : 'fullbleed'),
        alignStart && 'hero--start',
      ],
      joinStyle(tone.style, scrollCue && 'position: relative'),
    )}
  >
    <div class={split ? 'split split-responsive' : 'centered'}>
      <div class:list={['rhythm', split && 'hero__text']}>
        {eyebrow && <p class="font-eyebrow">{eyebrow}</p>}
        {heading && (
          <Heading class="font-display">
            {headingRuns.map((run) => (run.accent ? <em class="accent">{run.text}</em> : run.text))}
          </Heading>
        )}
        {body && <p class="font-lead">{body}</p>}
        {(primaryLabel && primaryHref) || (secondaryLabel && secondaryHref) ? (
          <p class="cluster">
            {primaryLabel && primaryHref && (
              <a class="cta" href={primaryHref}>
                {primaryLabel}
              </a>
            )}
            {secondaryLabel && secondaryHref && (
              <a class={secondaryClass} href={secondaryHref}>
                {secondaryLabel}
              </a>
            )}
          </p>
        ) : null}
      </div>
      {/* The hero image is the page's likely LCP element: eager AND high priority. */}
      {split && (
        <BlockImage
          src={image}
          alt={imageAlt}
          ratio={value.imageRatio}
          displayWidth={960}
          loading="eager"
          fetchpriority="high"
          class="hero__media"
        />
      )}
    </div>
    {cards.length > 0 && (
      <ul
        class="subgrid subgrid-responsive centered"
        role="list"
        style={`--subgrid-cols: ${Math.min(4, cards.length)}`}
      >
        {cards.map((card) => (
          <li
            class:list={[
              'card',
              'subgrid-card',
              card.style && 'tone tone--tint',
              card.theme?.className,
            ]}
            style={joinStyle(card.style, card.theme?.style)}
          >
            {card.eyebrow && <p class="font-eyebrow">{card.eyebrow}</p>}
            {card.title && <CardHeading class="font-heading">{card.title}</CardHeading>}
            {card.body && (
              <p>
                <RichText text={card.body} />
              </p>
            )}
            {card.ctaLabel && card.ctaHref ? (
              <p class="subgrid-card__footer">
                <a class="cta" href={card.ctaHref}>
                  {card.ctaLabel}
                </a>
              </p>
            ) : (
              card.href && (
                <a class="link stretched-link" href={card.href}>
                  {card.linkLabel}
                  {card.title && <span class="sr-only">: {card.title}</span>}
                </a>
              )
            )}
          </li>
        ))}
      </ul>
    )}
    {/* Last child: the cue's sentinel marks the end of this section. */}
    {scrollCue && <ScrollCue label={scrollCueLabel} />}
  </section>
)}
