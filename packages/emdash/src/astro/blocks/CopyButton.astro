---
import { resolveBlockValue } from './value.ts';

interface Value {
  text?: string;
  label?: string;
  display?: 'inline' | 'code-block';
}

const value = resolveBlockValue<Value>(Astro.props);
const { text, label = 'Copy', display = 'code-block' } = value;
import { rootAttrs } from './attrs.ts';
---

{text && display === 'code-block' && (
  <div {...rootAttrs(value, ['copy'])}>
    <pre><code>{text}</code></pre>
    <wc-copy value={text} label={label}>{label}</wc-copy>
  </div>
)}
{text && display === 'inline' && (
  <wc-copy {...rootAttrs(value)} value={text} label={label}><code>{text}</code></wc-copy>
)}
