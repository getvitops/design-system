---
/**
 * Thin adapter over `@getvitops/astro`'s `<Carousel />`.
 *
 * The markup, the image priority matrix and the accessibility wiring all live
 * there — this only maps the block's fields onto its `slides` prop. Emitting the
 * markup here too would be a second copy to keep in step, and the one that drifts
 * is always the one nobody is looking at.
 *
 * `slides` (a repeater) is the editing surface. `images`/`alts` are the newline-
 * separated fields every block saved before the repeater existed carries; they are
 * still read when there are no `slides`, so existing content keeps rendering.
 */
import Carousel from '@getvitops/astro/components/Carousel.astro';
import { resolveBlockValue, rows, safeHref, splitLines, text } from './value.ts';

interface Value {
  _key?: string;
  slides?: unknown;
  images?: string;
  alts?: string;
  label?: string;
  autoplay?: number;
  loop?: boolean;
  aspect?: string;
}

const value = resolveBlockValue<Value>(Astro.props);
const fromRepeater = rows<{ src?: unknown; alt?: unknown }>(value.slides).flatMap((row) => {
  const src = safeHref(row.src);
  return src ? [{ src, alt: text(row.alt) }] : [];
});
const legacyAlts = splitLines(value.alts);
const fromLegacy = splitLines(value.images).flatMap((raw, i) => {
  const src = safeHref(raw);
  return src ? [{ src, alt: legacyAlts[i] ?? '' }] : [];
});
const slides = fromRepeater.length > 0 ? fromRepeater : fromLegacy;
// Two blocks with the same label would derive the same id; `_key` is unique per block.
const id = value._key ? `carousel-${value._key.replace(/[^a-z0-9_-]/gi, '')}` : undefined;
const autoplay = Number(value.autoplay) || 0;
import { rootAttrs } from './attrs.ts';
---

{
  slides.length > 0 && (
    <Carousel
      label={value.label || 'Carousel'}
      autoplay={autoplay > 0 ? autoplay : undefined}
      loop={Boolean(value.loop)}
      aspect={value.aspect || '16 / 9'}
      slides={slides}
      id={id}
      {...rootAttrs(value)}
    />
  )
}
