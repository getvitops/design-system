---
/**
 * A group of native `<details>` — no JS at any tier. `exclusive` gives every item the
 * same `name`, which the platform turns into "opening one closes the others". The name
 * comes from the block's `_key`, so two accordions on a page never close each other.
 */
import FAQ from '@getvitops/astro/schemas/FAQ.astro';
import { linkRuns, paragraphs, resolveBlockValue, rows, text } from './value.ts';

interface Value {
  _key?: string;
  items?: unknown;
  exclusive?: boolean;
  schema?: boolean;
}

const value = resolveBlockValue<Value>(Astro.props);
const items = rows<Record<string, unknown>>(value.items)
  .map((row) => ({
    summary: text(row.summary),
    body: paragraphs(row.body),
    open: Boolean(row.open),
  }))
  .filter((item) => item.summary);
// Opt-in: Google limits FAQ rich results to government and health sites, so marking up every
// accordion would be a promise most sites cannot use. The answer is the body as plain text.
const faqItems = value.schema
  ? items.map((item) => ({
      question: item.summary,
      answer: item.body
        .map((p) =>
          linkRuns(p)
            .map((r) => r.text)
            .join(''),
        )
        .join(' '),
    }))
  : [];
const { spriteBase = '/vitops' } = Astro.props as { spriteBase?: string };
const sprite = `${spriteBase}/icons.svg`;
const group = value.exclusive ? `accordion-${value._key ?? 'group'}` : undefined;
import { rootAttrs } from './attrs.ts';
---

{faqItems.length > 0 && <FAQ items={faqItems} />}
{items.length > 0 && (
  <div {...rootAttrs(value, ['accordion'])}>
    {items.map((item) => (
      <details name={group} open={item.open}>
        <summary>
          <span>{item.summary}</span>
          <span class="icon details-icon" aria-hidden="true">
            <svg>
              <use href={`${sprite}#icon-chevron-down`} />
            </svg>
          </span>
        </summary>
        {item.body.map((p) => (
          <p>
            {linkRuns(p).map((run) =>
              run.href ? (
                <a class="link" href={run.href}>
                  {run.text}
                </a>
              ) : (
                run.text
              ),
            )}
          </p>
        ))}
      </details>
    ))}
  </div>
)}
