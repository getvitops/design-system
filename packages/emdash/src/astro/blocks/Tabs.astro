---
/**
 * Thin adapter over `@getvitops/astro`'s `<Tabs />`, which emits `<wc-tabs>` itself — so this must
 * not add its own wrapper. Every panel is a headed section with no JS, a tablist with it. The
 * editor writes each tab's label and text; richer panels belong in a layout block.
 */
import Tabs from '@getvitops/astro/components/Tabs.astro';
import { headingTag, paragraphs, resolveBlockValue, rows, text } from './value.ts';

interface Value {
  tabs?: unknown;
  level?: string | number;
  orientation?: string;
  hash?: boolean;
}

const value = resolveBlockValue<Value>(Astro.props);
const items = rows<Record<string, unknown>>(value.tabs)
  .map((row) => ({ label: text(row.label), body: paragraphs(row.body) }))
  .filter((item) => item.label);
const level = Number(headingTag(value.level, 3).slice(1)) as 2 | 3 | 4 | 5 | 6;
const orientation = value.orientation === 'vertical' ? 'vertical' : 'horizontal';
import { rootAttrs } from './attrs.ts';
---

{items.length > 0 && (
  <Tabs
    items={items}
    level={level}
    orientation={orientation}
    hash={Boolean(value.hash)}
    {...rootAttrs(value)}
  />
)}
