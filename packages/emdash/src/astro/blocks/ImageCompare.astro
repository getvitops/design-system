---
import { resolveBlockValue, safeHref } from './value.ts';

interface Value {
  before?: string;
  beforeAlt?: string;
  beforeLabel?: string;
  after?: string;
  afterAlt?: string;
  afterLabel?: string;
}

const value = resolveBlockValue<Value>(Astro.props);
const { beforeAlt = '', beforeLabel = 'Before', afterAlt = '', afterLabel = 'After' } = value;
// A `javascript:`/`data:` src is dropped, so the block renders nothing rather than that image.
const before = safeHref(value.before);
const after = safeHref(value.after);
import { rootAttrs } from './attrs.ts';
---

{before && after && (
  <wc-image-compare {...rootAttrs(value)} before-label={beforeLabel} after-label={afterLabel}>
    <img slot="before" src={before} alt={beforeAlt} loading="lazy" />
    <img slot="after" src={after} alt={afterAlt} loading="lazy" />
  </wc-image-compare>
)}
