---
/**
 * A contact / enquiry form that posts to the site's conversion endpoint, with the editor's field
 * list.
 *
 * This block is an adapter: it maps a saved `vitops_form` value (heading, intro, field rows,
 * messages, tone) onto `<ContactForm>` from `@getvitops/astro`, which owns the markup, the no-JS
 * round trip, the honeypot and Turnstile. A form authored in code and one edited in the CMS are
 * therefore the same form. Read that component's docblock for how it works; what the block adds is
 * the heading and intro, the editor's `tone` on the wrapper and on the two notices, and the
 * universal `anchor` / `className` / `style` escape hatches on its outermost element.
 *
 * Field names go through `@getvitops/utils/contact-form`, which keeps them clear of the names the
 * route reserves (`phone`, `event`, the honeypots), and a phone field submits as `tel`.
 */
import ContactForm from '@getvitops/astro/components/ContactForm.astro';
import { resolveFields } from '@getvitops/utils/contact-form';
import { resolveTone, joinStyle } from './tone.ts';
import { headingTag, resolveBlockValue, rows, text } from './value.ts';
import { rootAttrs } from './attrs.ts';

interface Value {
  heading?: string;
  level?: string | number;
  intro?: string;
  fields?: unknown;
  submitLabel?: string;
  successMessage?: string;
  errorMessage?: string;
  noJsMessage?: string;
  action?: string;
  tone?: string;
  color?: string;
}

const value = resolveBlockValue<Value>(Astro.props);
const fieldRows = rows(value.fields);
const heading = text(value.heading);
const intro = text(value.intro);
const Heading = headingTag(value.level, 2);
const tone = resolveTone(value.tone, value.color);
const successTone = resolveTone('success', '');
const errorTone = resolveTone('danger', '');
// A form with no usable field renders nothing at all, heading and intro included.
const hasForm = resolveFields(fieldRows).length > 0;
---

{hasForm && (
  <ContactForm
    {...rootAttrs(value, [tone.className], joinStyle(tone.style))}
    fields={fieldRows}
    action={value.action}
    submitLabel={text(value.submitLabel) || undefined}
    successMessage={text(value.successMessage) || undefined}
    errorMessage={text(value.errorMessage) || undefined}
    noJsMessage={text(value.noJsMessage) || undefined}
    successClass={successTone.className}
    successStyle={joinStyle(successTone.style)}
    errorClass={errorTone.className}
    errorStyle={joinStyle(errorTone.style)}
  >
    {heading && <Heading class="font-heading">{heading}</Heading>}
    {intro && <p>{intro}</p>}
  </ContactForm>
)}
