---
/**
 * One block image: a plain `<img>`, or a responsive AVIF `srcset` when the editor stated the
 * image's aspect ratio. Every block image goes through here so they cannot drift apart.
 *
 * **Why a ratio.** A block field stores a URL (EmDash's `media_picker` yields a string), so the
 * file's size is unknown, and without width and height there is no honest `srcset` or reserved
 * box. Probing the file on every render (Astro's `inferSize`) would be an HTTP fetch per image.
 * So the size is the editor's to state, and with none stated this renders exactly the `<img>` it
 * always did: existing content is unchanged until someone opts in.
 *
 * **Why AVIF only.** One format is one billed Cloudflare transformation per image and width
 * (AVIF + WebP would double the monthly count) and AVIF is at ~97% support, close to WebP's, and
 * compresses smaller. The cost is that an engine without AVIF shows a broken image rather than a
 * degraded one.
 * TODO(support): AVIF-only is a deliberate trade; to restore the fallback pass
 * `formats: ['avif', 'jpeg']` through `<Picture>` here. Revisit if a client's audience skews old.
 *
 * **Where the transform happens.** Not in the build. Astro's image endpoint is wrapped by EmDash
 * and resizes R2 bytes through the Cloudflare `IMAGES` binding at request time, so this adds no
 * CI work. It only transforms a URL on an authorized host: EmDash registers the site origin in
 * `image.remotePatterns` when `siteUrl` / `EMDASH_SITE_URL` is known at build, and without it
 * the service hands the URL back unchanged. That case is detected, warned about once per build,
 * and falls back to the plain `<img>`. `@getvitops/astro` sets Astro's `site` from the config's
 * environment url (or `EMDASH_SITE_URL`), which is what turns the srcset on; do not pass
 * `emdash({ siteUrl })` for this, it also becomes the passkey origin.
 */
import { getImage } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import {
  parseRatio,
  resolveImageOrigin,
  transformBlockImage,
  warnImageFallback,
  type ResponsiveImage,
} from './image.ts';

export interface Props extends Omit<
  HTMLAttributes<'img'>,
  'src' | 'alt' | 'width' | 'height' | 'srcset'
> {
  src: string;
  alt: string;
  /** What the editor typed: `16:9`, `1200x800`, `1.5`. Absent or invalid renders a plain `<img>`. */
  ratio?: unknown;
  /** The widest this image is shown, in CSS pixels. Drives `sizes` and the widths requested. */
  displayWidth?: number;
}

const { src, alt, ratio: rawRatio, displayWidth = 1200, loading = 'lazy', ...rest } = Astro.props;

const ratio = parseRatio(rawRatio);
let responsive: ResponsiveImage | undefined;

if (ratio) {
  const emdash = (Astro.locals as { emdash?: { config?: { siteUrl?: string } } }).emdash;
  const origin = resolveImageOrigin({
    siteUrl: emdash?.config?.siteUrl,
    env: typeof process === 'undefined' ? undefined : process.env.EMDASH_SITE_URL,
    site: Astro.site?.origin,
    requestOrigin: Astro.url.origin,
  });
  const result = await transformBlockImage({ src, ratio, displayWidth, origin, getImage });
  if ('image' in result) responsive = result.image;
  else warnImageFallback(result.reason, src, origin);
}
---

{responsive ? (
  <img
    {...rest}
    src={responsive.src}
    srcset={responsive.srcset}
    sizes={responsive.sizes}
    width={responsive.width}
    height={responsive.height}
    alt={alt}
    loading={loading}
    decoding="async"
  />
) : (
  <img {...rest} src={src} alt={alt} loading={loading} />
)}
