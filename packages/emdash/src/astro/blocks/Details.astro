---
import { resolveBlockValue } from './value.ts';

interface Value {
  summary?: string;
  body?: string;
  open?: boolean;
}

const value = resolveBlockValue<Value>(Astro.props);
const { summary, body, open = false } = value;
import { rootAttrs } from './attrs.ts';
---

{summary && (
  <details open={open} {...rootAttrs(value)}>
    <summary>{summary}</summary>
    <p>{body}</p>
  </details>
)}
