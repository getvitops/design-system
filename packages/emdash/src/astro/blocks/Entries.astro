---
/**
 * Thin adapter over `@getvitops/astro`'s `<Entries />`, which emits `<wc-entries>` itself —
 * so this must not add its own wrapper. Stacked heading + `<dl>` pairs with no JS, a table
 * with it. The editor writes each row's details as `Term | Value` lines.
 */
import Entries from '@getvitops/astro/components/Entries.astro';
import { headingTag, linkRuns, pairs, resolveBlockValue, rows, text } from './value.ts';

interface Value {
  entries?: unknown;
  level?: string | number;
  breakpoint?: string;
}

const value = resolveBlockValue<Value>(Astro.props);

/**
 * A value of exactly `[label](url)` becomes a link; any other value shows its text with the
 * markup flattened, so `[a](b)` never reaches the page as raw Markdown. (A cell is one string for
 * `<wc-entries>`, which rebuilds it as a table cell; one link per value is what that supports.)
 */
function entryValue(pair: { term: string; value: string }): {
  term: string;
  value: string;
  href?: string;
} {
  const runs = linkRuns(pair.value);
  const only = runs.length === 1 ? runs[0] : undefined;
  if (only?.href) return { term: pair.term, value: only.text, href: only.href };
  return { term: pair.term, value: runs.map((r) => r.text).join('') };
}
const entries = rows<Record<string, unknown>>(value.entries)
  .map((row) => ({
    heading: text(row.heading),
    pairs: pairs(row.pairs)
      .filter((pair) => pair.term)
      .map((pair) => entryValue(pair)),
  }))
  .filter((entry) => entry.heading && entry.pairs.length > 0);
const level = Number(headingTag(value.level, 3).slice(1)) as 2 | 3 | 4 | 5 | 6;
// A breakpoint lands in an attribute the element parses as a CSS length; keep it to one.
const breakpoint = /^\d+(\.\d+)?(rem|em|px|ch)$/.test(text(value.breakpoint))
  ? text(value.breakpoint)
  : undefined;
import { rootAttrs } from './attrs.ts';
---

{entries.length > 0 && (
  <Entries entries={entries} level={level} breakpoint={breakpoint} {...rootAttrs(value)} />
)}
