    "@astrojs/react": "catalog:",
    "@emdash-cms/cloudflare": "catalog:",
    "@getvitops/astro": "workspace:*",
    "@getvitops/core": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "catalog:",
    "emdash": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": ">=14",
    "@astrojs/react": ">=7",
    "@emdash-cms/cloudflare": ">=1.0.0 <2",
    "@getvitops/astro": ">=6.0.0",
    "@getvitops/core": ">=8.0.0",
    "astro": ">=7",
    "emdash": ">=1.0.0 <2",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@astrojs/cloudflare": {
